--- /dev/null
+++ b/src/adapters/standin/tags.test.ts
@@ -0,0 +1,97 @@
+// @vitest-environment node
+/* Fields (stage 10) on the stand-in platform: its two tables' limits held by SQLite (migration 0003_tags.sql, as 0052
+   and 0054 hold them in Postgres), and the server's guard asking the module's rules of every field and value a save
+   writes (src/modules/tags/guard.ts through guard.ts): who may, as whom, and what. */
+import path from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { buildPlatformOrg } from '../../data/platformOrg';
+import { applyCommit } from '../../data/store';
+import type { ActionContext } from '../../domain/actions';
+import type { Commit } from '../../domain/commit';
+import type { Snapshot, Workspace } from '../../domain/types';
+import { addField, retireField, setGoalFields, fieldsOf, valueId } from '../../modules/tags/fields';
+import { openDatabase } from './migrate';
+import { refusal } from './guard';
+
+const MIGRATIONS = path.resolve(__dirname, '../../../platform/migrations');
+const today = new Date('2026-11-02T12:00:00Z');
+const base = buildPlatformOrg(today);
+const WS: Workspace = { id: 'ws_t', name: 'Platform Engineering', kind: 'own', createdAt: today.toISOString() };
+let n = 0;
+const ctx = (s: Snapshot, who: string): ActionContext => ({ snapshot: s, cycle: s.cycles[0]!, week: 45, actor: s.people.find((p) => p.id === who)!, now: today.toISOString(), newId: (p) => `${p}_${++n}` });
+const who = (s: Snapshot, id: string) => s.people.find((p) => p.id === id)!;
+const member = base.people.find((p) => !p.admin && base.goals.some((g) => g.ownerId === p.id))!;
+const mine = base.goals.find((g) => g.ownerId === member.id)!;
+const theirs = base.goals.find((g) => g.ownerId !== member.id && g.ownerId)!;
+const stage = addField(ctx(base, 'amara'), { name: 'Stage', kind: 'list', options: ['Discover', 'Build', 'Run'] });
+const withStage = applyCommit(structuredClone(base), stage);
+const fieldId = fieldsOf(withStage)[0]!.id;
+const strip = (c: Commit) => c as Parameters<typeof refusal>[1];
+
+describe('the database holds Fields’ limits (0003_tags.sql)', () => {
+  const db = openDatabase(':memory:', MIGRATIONS);
+  const field = db.prepare('insert into goal_fields (id, workspace_id, name, kind, options, created_by) values (?, ?, ?, ?, ?, ?)');
+  const value = db.prepare('insert into goal_field_values (id, workspace_id, goal_id, field_id, value, set_by) values (?, ?, ?, ?, ?, ?)');
+  it('takes a list and a free-text field, and a value of 80 characters', () => {
+    field.run('f1', 'w', 'Stage', 'list', '["Discover","Build"]', 'amara');
+    field.run('f2', 'w', 'Note', 'text', '[]', 'amara');
+    value.run('g1:f2', 'w', 'g1', 'f2', 'x'.repeat(80), 'amara');
+  });
+  it.each([
+    ['a name over 40 characters', ['f3', 'w', 'x'.repeat(41), 'list', '["A"]', 'amara']],
+    ['an empty name', ['f3', 'w', '  ', 'list', '["A"]', 'amara']],
+    ['a kind other than list or text', ['f3', 'w', 'Kind', 'number', '[]', 'amara']],
+    ['a list of no values', ['f3', 'w', 'Empty', 'list', '[]', 'amara']],
+    ['a list of 21 values', ['f3', 'w', 'Many', 'list', JSON.stringify(Array.from({ length: 21 }, (_, i) => `v${i}`)), 'amara']],
+    ['free text with values (0054)', ['f3', 'w', 'Text', 'text', '["A"]', 'amara']],
+  ])('refuses %s', (_, row) => expect(() => field.run(...(row as string[]))).toThrow(/CHECK constraint/));
+  it('refuses a goal’s value over 80 characters, and a value whose id isn’t its goal and field', () => {
+    expect(() => value.run('g2:f2', 'w', 'g2', 'f2', 'x'.repeat(81), 'amara')).toThrow(/CHECK constraint/);
+    expect(() => value.run('nope', 'w', 'g2', 'f2', 'x', 'amara')).toThrow(/CHECK constraint/);
+  });
+  it('refuses a second live field of the same name, whatever the case', () => {
+    expect(() => field.run('f4', 'w', ' stage', 'list', '["A"]', 'amara')).toThrow(/UNIQUE/);
+  });
+});
+
+describe('the server’s guard on Fields’ rows', () => {
+  it('lets an admin add a field, and refuses anyone else', () => {
+    expect(refusal(base, stage, who(base, 'amara'), WS)).toBeNull();
+    const forged = { ...stage, changes: stage.changes.map((c) => ({ ...c, actorId: member.id })) };
+    expect(refusal(base, strip(forged), member, WS)).toBe('Only an admin can change the workspace’s fields.');
+  });
+  it('refuses a field the rule refuses (a seventh, a name the Goals sheet reads, a list value twice)', () => {
+    let s = structuredClone(base);
+    for (const name of ['A', 'B', 'C', 'D', 'E', 'F']) s = applyCommit(s, addField(ctx(s, 'amara'), { name, kind: 'text', options: [] }));
+    expect(fieldsOf(s).length).toBe(6);
+    const seventh = { ...stage, modules: { tags: { fields: [{ ...fieldsOf(stage)[0]!, id: 'fld_seventh', name: 'G' }] } } };
+    expect(refusal(s, strip(seventh), who(s, 'amara'), WS)).toBe('A workspace has at most 6 fields. Retire one first.');
+    const owner = { ...stage, modules: { tags: { fields: [{ ...fieldsOf(stage)[0]!, name: 'owner' }] } } };
+    expect(refusal(base, strip(owner), who(base, 'amara'), WS)).toMatch(/The Goals sheet already has a column called “Owner”/);
+    const twice = { ...stage, modules: { tags: { fields: [{ ...fieldsOf(stage)[0]!, options: ['Build', 'build'] }] } } };
+    expect(refusal(base, strip(twice), who(base, 'amara'), WS)).toBe('“build” is in the list twice.');
+  });
+  it('lets a goal’s owner set its value; refuses another member, a value the list doesn’t hold, and a save as someone else', () => {
+    const set = setGoalFields(ctx(withStage, member.id), mine, { [fieldId]: 'Build' })!;
+    expect(refusal(withStage, set, member, WS)).toBeNull();
+    const other = { ...set, modules: { tags: { fieldValues: [{ ...(set.modules!.tags!.fieldValues![0] as object), id: valueId(theirs.id, fieldId), goalId: theirs.id }] } } };
+    expect(refusal(withStage, strip(other), member, WS)).toBe('Only the goal’s owner or an admin can change its fields.');
+    const bad = { ...set, modules: { tags: { fieldValues: [{ ...(set.modules!.tags!.fieldValues![0] as object), value: 'Operate' }] } } };
+    expect(refusal(withStage, strip(bad), member, WS)).toBe('“Operate” isn’t one of Stage’s values: Discover, Build or Run.');
+    const asAdmin = { ...set, modules: { tags: { fieldValues: [{ ...(set.modules!.tags!.fieldValues![0] as object), setBy: 'amara' }] } } };
+    expect(refusal(withStage, strip(asAdmin), member, WS)).toBe('A save can only be made as the person signed in.');
+    expect(refusal(withStage, setGoalFields(ctx(withStage, 'amara'), theirs, { [fieldId]: 'Run' })!, who(withStage, 'amara'), WS)).toBeNull();
+  });
+  it('refuses a value on a retired field, and every Fields write while Fields is switched off', () => {
+    const retired = applyCommit(structuredClone(withStage), retireField(ctx(withStage, 'amara'), fieldId));
+    const set = setGoalFields(ctx(withStage, member.id), mine, { [fieldId]: 'Build' })!;
+    expect(refusal(retired, set, member, WS)).toBe('Stage is retired. An admin can bring it back in Workspace, Fields.');
+    const off = { ...WS, modulesOff: ['tags'] };
+    expect(refusal(withStage, set, member, off)).toBe('Fields is switched off in Platform Engineering. An admin can switch it on in Workspace, under Features.');
+    expect(refusal(base, stage, who(base, 'amara'), off)).toBe('Fields is switched off in Platform Engineering. An admin can switch it on in Workspace, under Features.');
+  });
+  it('passes a save that sends Fields’ rows back unchanged', () => {
+    const again = { changes: [], modules: { tags: { fields: fieldsOf(withStage) } } } as Commit;
+    expect(refusal(withStage, again, member, { ...WS, modulesOff: ['tags'] })).toBeNull();
+  });
+});
