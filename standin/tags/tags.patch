diff --git a/src/modules/tags/guard.ts b/src/modules/tags/guard.ts
new file mode 100644
index 0000000..cbf157e
--- /dev/null
+++ b/src/modules/tags/guard.ts
@@ -0,0 +1,81 @@
+/* Fields' rows, checked by a server that holds the workspace (drill item 11: the stand-in platform's guard, R1 rule 4).
+   The browser runs the module's actions (fields.ts) and sends their commit; a server that can't trust it asks the same
+   rules of every field and value row the commit changes, against the rows it holds:
+
+     a field          only an admin adds, renames, moves, retires or brings one back (fields.ts canDefineFields), as
+                      the person signed in, and the field passes rule 1 (rules.ts fieldProblem) among the others
+     a goal's value   only the goal's owner or an admin (canSetFields), as the person signed in, on a field of the
+                      workspace; the value is what rule 2 (valueProblem) keeps, or one goals already hold (a list's
+                      values changed: "goals keep the values they hold"); a goal new in this save (a goal added, a
+                      copy at the start of the next year) takes values from whoever adds it
+
+   While Fields is switched off, nothing writes a field, and a value only follows a goal the core's own paths add or
+   remove (a copy at the start of the next year, a copy that leaves, a start undone). Pure: rows in, the app's words out. */
+import { switchedOffWords } from '../../app/reads';
+import { isModuleOn } from '../../core/registry';
+import type { ModuleRows } from '../../domain/records';
+import type { Goal, Person, Snapshot, Workspace } from '../../domain/types';
+import { canDefineFields, canSetFields, fieldsOf, valuesOf, MODULE } from './fields';
+import { fieldToRow, valueToRow } from './records';
+import { fieldProblem, valueProblem } from './rules';
+import type { GoalFieldValue, SavedField } from './types';
+
+type Commit = { modules?: ModuleRows; goals?: Goal[] };
+const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
+
+/** Why the server refuses this save's Fields rows by `actor`, in the app's words; null when it may. */
+export default function fieldsRefusal(stored: Snapshot, c: Commit, actor: Person, workspace: Pick<Workspace, 'id' | 'name' | 'modulesOff'>): string | null {
+  const fields = fieldsOf(c);
+  const values = valuesOf(c);
+  if (!fields.length && !values.length) return null;
+  const ws = workspace.id;
+  const me = { ...actor, admin: !!actor.admin };
+  const on = isModuleOn(workspace, MODULE);
+  const off = switchedOffWords('Fields', workspace.name);
+
+  // Fields: the commit's version of each, merged over the stored ones, so a save that changes two at once is judged whole.
+  const held = new Map(fieldsOf(stored).map((f) => [f.id, f]));
+  const changed = fields.filter((f) => !same(held.get(f.id) && fieldToRow(ws, held.get(f.id)!), fieldToRow(ws, f)));
+  const after = new Map(held);
+  for (const f of fields) after.set(f.id, f);
+  if (changed.length) {
+    if (!on) return off;
+    if (!canDefineFields(me)) return 'Only an admin can change the workspace’s fields.';
+    for (const f of changed) {
+      const was = held.get(f.id);
+      if (!was && f.createdBy !== actor.id) return 'A save can only be made as the person signed in.';
+      if (was && (f.createdBy !== was.createdBy || f.createdAt !== was.createdAt)) return 'Who added a field, and when, doesn’t change.';
+      if (was && f.kind !== was.kind) return 'A field’s kind can’t be changed once it is added.';
+      if (f.retiredAt && !was?.retiredAt && f.retiredBy !== actor.id) return 'A save can only be made as the person signed in.';
+      // The rule wants the others as they will be, and this one as it was (or not at all, while new).
+      const problem = fieldProblem(f, [...[...after.values()].filter((x) => x.id !== f.id), ...(was ? [was] : [])]);
+      if (problem) return problem;
+    }
+  }
+
+  // Values: on a goal the server holds (or one this save adds), by its owner or an admin, as the rule keeps them.
+  const goals = new Map(stored.goals.map((g) => [g.id, g]));
+  const added = new Map((c.goals ?? []).filter((g) => !goals.has(g.id)).map((g) => [g.id, g]));
+  const heldValues = new Map(valuesOf(stored).map((v) => [v.id, v]));
+  const holds = (fieldId: string, value: string) => valuesOf(stored).some((v) => v.fieldId === fieldId && v.value === value);
+  for (const v of values as GoalFieldValue[]) {
+    const was = heldValues.get(v.id);
+    if (same(was && valueToRow(ws, was), valueToRow(ws, v))) continue;
+    if (v.id !== `${v.goalId}:${v.fieldId}`) return 'A goal has one value per field.';
+    const cleared = !!v.removedAt || !v.value;
+    const isNew = added.has(v.goalId);
+    if (!on && !isNew && !(cleared && v.removedAt)) return off;
+    const g = goals.get(v.goalId) ?? added.get(v.goalId);
+    if (!g) return 'That goal no longer exists. Reload to see the latest.';
+    if (!isNew && !canSetFields(me, g)) return 'Only the goal’s owner or an admin can change its fields.';
+    if ((v.removedAt ? (v.removedBy ?? v.setBy) : v.setBy) !== actor.id) return 'A save can only be made as the person signed in.';
+    const f: SavedField | undefined = after.get(v.fieldId);
+    if (!f) return 'That field no longer exists. Reload to see the latest.';
+    if (cleared) continue;
+    if (f.retiredAt && !isNew) return `${f.name} is retired. An admin can bring it back in Workspace, Fields.`;
+    const r = valueProblem(f, v.value);
+    if ('problem' in r && !holds(f.id, v.value)) return r.problem;
+    if ('value' in r && r.value !== v.value && !holds(f.id, v.value)) return `“${v.value}” isn’t written as ${f.name} writes it: “${r.value}”.`;
+  }
+  return null;
+}
