+    check('API: a member renames it: refused', r.status === 403 && /Only an admin/.test(err(r)), `${r.status} ${err(r)}`);
+    r = await rhea('POST', `/api/workspaces/${WS}/commit`, { modules: { tags: { fields: [{ ...stage, retiredAt: now(), retiredBy: 'rhea' }] } }, changes: [change('rhea', stage.id)] });
+    check('API: a member retires it: refused', r.status === 403 && /Only an admin/.test(err(r)), `${r.status} ${err(r)}`);
