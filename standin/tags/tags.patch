+const PARTS = { '': 'module.json', '/help': 'help.ts', '/tools': 'tools.ts', '/app': 'app.tsx', '/records': 'records.ts', '/actions': 'actions.ts', '/spec': 'spec.ts', '/conformance': 'conformance.ts', '/demo': 'demo.ts', '/guard': 'guard.ts' } as const;
