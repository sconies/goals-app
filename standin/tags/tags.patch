+/* Fields (stage 10) on the stand-in platform (drill item 11). Starts the built server on a fresh data folder, seeds it,
+   and checks the stage's exit criteria on the running stand-in: through /mcp (save_field, set_goal_fields, list_fields,
+   find_goals' fields), through the API as a member who isn't an admin or the goal's owner (every Fields write the server
+   must refuse, R1 rule 4), in SQLite, and through the screens (Playwright, signed in by password): Workspace → Fields,
+   a goal's Fields block and History, Goals' filter by address; switched off by an admin (no block, no menu row, Page not
+   found with the sentence, a link's f.<id> narrows nothing, tools refuse) and back on with every value.
+   With `out` it checks the build that leaves the module out. Usage: npm run build:standin && node platform/prove-tags.mjs [port] [in|out]. */
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { chromium } from 'playwright';
+
+const PORT = Number(process.argv[2] || 47110);
+const MODE = process.argv[3] || 'in';
+const B = `http://localhost:${PORT}`;
+const DATA = fs.mkdtempSync(path.join(os.tmpdir(), 'faro-tags-'));
+const ENV = { ...process.env, STANDIN_PORT: String(PORT), STANDIN_DATA: DATA, NODE_NO_WARNINGS: '1' };
+const PASSWORD = 'faro-standin';
+const WS = 'ws_platform';
+const OFF = 'Fields is switched off in Platform Engineering';
+const results = [];
+const check = (name, ok, detail = '') => { results.push({ name, ok: !!ok, detail }); console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ' — ' + String(detail).slice(0, 160) : ''}`); };
+
+function run(args) { return new Promise((res, rej) => { const p = spawn(process.execPath, ['platform/dist/server.mjs', ...args], { env: ENV, stdio: 'inherit' }); p.on('exit', (c) => (c ? rej(new Error('exit ' + c)) : res())); }); }
+async function start() {
+  const p = spawn(process.execPath, ['platform/dist/server.mjs'], { env: ENV, stdio: ['ignore', 'pipe', 'inherit'] });
+  await new Promise((res) => p.stdout.on('data', (d) => { if (/stand-in platform/.test(String(d))) res(); }));
+  return p;
+}
+function client() {
+  let cookie = '';
+  const c = async (method, url, body) => {
+    const r = await fetch(B + url, { method, redirect: 'manual', headers: { ...(cookie ? { cookie } : {}), ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}) }, body: body === undefined ? undefined : JSON.stringify(body) });
+    const set = r.headers.get('set-cookie'); if (set) cookie = set.split(';')[0];
+    const text = await r.text(); let json = null; try { json = JSON.parse(text); } catch { /* html */ }
+    return { status: r.status, json, text };
+  };
+  c.signIn = (email) => c('POST', '/api/signin', { email, password: PASSWORD });
+  return c;
+}
+let n = 0;
+const now = () => new Date().toISOString();
+const change = (actor, entityId, goalId = null) => ({ id: `chg_tg${++n}`, at: now(), actorId: actor, goalId, entity: 'field', entityId, action: 'edited', summary: 'proof', diffs: [] });
+const mcp = (secret, name, args) => fetch(B + '/mcp', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json, text/event-stream', Authorization: `Bearer ${secret}` }, body: JSON.stringify({ jsonrpc: '2.0', id: ++n, method: name === 'tools/list' ? name : 'tools/call', params: name === 'tools/list' ? {} : { name, arguments: args } }) }).then((x) => x.json());
+const said = (r) => String(r?.result?.content?.[0]?.text ?? r?.error?.message ?? JSON.stringify(r));
+const err = (r) => r.json?.error ?? '';
+
+await run(['seed', PASSWORD]);
+const server = await start();
+const browser = await chromium.launch();
+try {
+  const rhea = client(); await rhea.signIn('rhea.kapoor@example.com');
+  const amara = client(); await amara.signIn('amara.nwosu@example.com');
+  const token = async (person) => (await amara('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: `tok_tg${person}`, personId: person, name: 'proof', createdBy: 'amara', createdAt: now(), lastUsedAt: null, revokedAt: null }], changes: [] })).json?.secret;
+  const aTok = await token('amara');
