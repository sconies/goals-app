diff --git a/platform/migrations/0003_tags.sql b/platform/migrations/0003_tags.sql
new file mode 100644
index 0000000..08a6ce4
--- /dev/null
+++ b/platform/migrations/0003_tags.sql
@@ -0,0 +1,40 @@
+-- Fields (the tags module, stage 10): its two tables' limits held by the database, as Faro's migrations 0052 and 0054
+-- hold them in Postgres (goal_fields_name_check, _kind_check, _options_check, _text_no_options;
+-- goal_field_values_one, _value_check). 0001_core.sql made the tables without CHECKs; SQLite adds a CHECK only by
+-- making the table again, so each is made anew with them and its rows copied across (a row breaking a limit stops the
+-- migration, which is the point). A list's own values are held to 40 characters by the rule (rules.ts), not here.
+
+create table goal_fields_new (
+  id text not null,
+  workspace_id text not null,
+  name text not null check (length(trim(name)) between 1 and 40),
+  kind text not null check (kind in ('list', 'text')),
+  options jsontext not null default '[]' check (json_valid(options) and json_type(options) = 'array' and json_array_length(options) <= 20 and (kind = 'text' or json_array_length(options) >= 1) and (kind = 'list' or json_array_length(options) = 0)),
+  position integer not null default 0,
+  created_by text not null,
+  created_at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  retired_at timestamptext,
+  retired_by text,
+  primary key (id)
+);
+insert into goal_fields_new select id, workspace_id, name, kind, options, position, created_by, created_at, retired_at, retired_by from goal_fields;
+drop table goal_fields;
+alter table goal_fields_new rename to goal_fields;
+create index if not exists goal_fields_ws on goal_fields (workspace_id);
+create unique index if not exists goal_fields_ws_name on goal_fields (workspace_id, lower(trim(name))) where retired_at is null;
+
+create table goal_field_values_new (
+  id text not null check (id = goal_id || ':' || field_id),
+  workspace_id text not null,
+  goal_id text not null,
+  field_id text not null,
+  value text not null default '' check (length(value) <= 80),
+  set_by text not null,
+  set_at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  primary key (id)
+);
+insert into goal_field_values_new select id, workspace_id, goal_id, field_id, value, set_by, set_at from goal_field_values;
+drop table goal_field_values;
+alter table goal_field_values_new rename to goal_field_values;
+create index if not exists goal_field_values_field on goal_field_values (field_id);
+create index if not exists goal_field_values_ws on goal_field_values (workspace_id);
