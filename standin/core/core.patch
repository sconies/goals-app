+    }
+    this.upsert('okr_check_ins', p.check_ins as unknown as Row[], ['id']);
+    for (const r of (p.reviews ?? []) as unknown as Row[]) {
+      const old = this.db.prepare('select version from okr_reviews where id = ?').get(r.id as string) as { version: number } | undefined;
+      if (old) this.db.prepare('update okr_reviews set version = ? where id = ?').run((old.version ?? 0) + 1, r.id as string);
+    }
+    this.upsert('okr_reviews', p.reviews as unknown as Row[], ['id']);
+    // okr_feedback_add: feedback is only ever added, and never with its triage.
+    this.upsert('okr_feedback', ((p.feedback ?? []) as unknown as Row[]).map(({ status: _s, fixed_in: _f, wont_fix_reason: _w, status_by: _b, status_at: _a, ...r }) => r), ['id'], 'nothing');
