+  /** Runs `fn` in one transaction: all of it is kept, or none. */
+  private tx<T>(fn: () => T): T {
+    this.db.exec('begin immediate');
+    try { const r = fn(); this.db.exec('commit'); return r; } catch (e) { this.db.exec('rollback'); throw e; }
+  }
+
+  /** okr_upsert: rows into a table, by its conflict key; only the columns some row names, never `version`. */
+  private upsert(table: string, rows: Row[] | undefined | null, conflict: string[], mode: 'update' | 'nothing' = 'update') {
+    if (!rows?.length) return;
+    const c = this.columns(table);
+    const names = [...c.keys()].filter((n) => n !== 'version' && rows.some((r) => n in r));
+    const sql = `insert into ${table} (${names.join(', ')}) values (${names.map(() => '?').join(', ')}) on conflict (${conflict.join(', ')}) do `
+      + (mode === 'nothing' ? 'nothing' : `update set ${names.map((n) => `${n} = excluded.${n}`).join(', ')}`);
+    const st = this.db.prepare(sql);
+    for (const r of rows) st.run(...names.map((n) => this.encode(c.get(n)!, r[n])));
+  }
+
+  /** The goals' upsert, with what the triggers did: a key given to a goal without one (okr_goal_key) and never changed,
+      and a version one on for each update (okr_bump_version). */
+  private upsertGoals(ws: string, rows: Row[] | undefined) {
+    if (!rows?.length) return;
+    const keyed: Row[] = [];
+    for (const r of rows) {
+      const old = this.db.prepare('select key, version, cycle_id from okr_goals where id = ?').get(r.id as string) as { key: string | null; version: number } | undefined;
+      keyed.push({ ...r, key: old?.key ?? this.nextKey(ws, r) });
+      if (old) this.db.prepare('update okr_goals set version = ? where id = ?').run((old.version ?? 0) + 1, r.id as string);
+    }
+    this.upsert('okr_goals', keyed, ['id']);
+  }
+
+  /** okr_goal_key: the key a goal asked for ("g12" or "G-12") when it's free in its cycle, else the next free number. */
+  private nextKey(ws: string, r: Row): string {
+    this.db.prepare('insert or ignore into okr_goal_keys (workspace_id, last) values (?, 0)').run(ws);
+    let last = (this.db.prepare('select last from okr_goal_keys where workspace_id = ?').get(ws) as { last: number }).last;
+    if (last === 0) {
+      const keys = this.db.prepare(`select key from okr_goals where workspace_id = ? and key glob 'G-[0-9]*'`).all(ws) as { key: string }[];
+      last = Math.max(0, ...keys.map((k) => Number(k.key.slice(2))).filter((n) => Number.isInteger(n)));
+    }
+    const asked = typeof r.key === 'string' && /^\s*g-?[0-9]{1,9}\s*$/i.test(r.key) ? 'G-' + Number(r.key.replace(/[^0-9]/g, '')) : null;
+    let key: string;
+    if (!asked || asked === 'G-0' || this.db.prepare('select 1 from okr_goals where workspace_id = ? and cycle_id = ? and key = ? and id <> ?').get(ws, r.cycle_id as string, asked, r.id as string)) {
+      last += 1; key = 'G-' + last;
+    } else { key = asked; last = Math.max(last, Number(asked.slice(2))); }
+    this.db.prepare('update okr_goal_keys set last = ? where workspace_id = ?').run(last, ws);
+    return key;
+  }
+
+  /** The modules' rows by table, the old metric keys read as their tables (okr_same_workspace, okr_write). */
+  private mods(p: Payload & { metrics?: Row[]; goal_metrics?: Row[] }): Record<string, Row[]> {
+    if (p.modules !== undefined && p.modules !== null && (typeof p.modules !== 'object' || Array.isArray(p.modules))) throw new Refused('a save\'s modules must be an object of tables');
+    const mods: Record<string, Row[]> = { ...(p.modules ?? {}) };
+    for (const [k, t] of [['metrics', 'okr_metrics'], ['goal_metrics', 'okr_goal_metrics']] as const) {
+      if (Array.isArray(p[k])) {
+        if (t in mods) throw new Refused(`a save names ${t} twice (as modules.${t} and as ${k})`);
+        mods[t] = p[k]!;
+      }
+    }
+    return mods;
+  }
