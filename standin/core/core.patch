+      if (t.revoked_at) return false;
+      if (t.person_id !== by && !this.db.prepare('select 1 from okr_people where id = ? and workspace_id = ? and is_admin = 1').get(by, ws)) throw new Refused('Only an admin or the token’s person can revoke it.');
