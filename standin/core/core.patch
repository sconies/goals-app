+++ b/src/adapters/standin/deps.ts
@@ -0,0 +1,30 @@
+/* The AI tools' endpoint's outside world (its Deps, server/mcp.ts) on the stand-in platform: the SQLite goals store
+   for loads and saves, a token found by its hash in one lookup, and refused once its person has left or been removed
+   in Faro (R1 rule 5) or has left the company (`leftCompany`, the directory's word: R2 rule 3). Server-only. */
+import type { Deps } from '../../../server/mcp';
+import type { SqliteStore } from './sqliteStore';
+
+export function standinDeps(store: SqliteStore, now: () => Date = () => new Date(), leftCompany: (email: string) => boolean = () => false): Deps {
+  const one = <T>(sql: string, ...p: string[]) => store.db.prepare(sql).get(...p) as T | undefined;
+  return {
+    async findToken(hash) {
+      const found = store.findToken(hash);
+      if (!found) return null;
+      // A token stops working the moment its person leaves (R1 rule 5): checked on every request, not cached.
+      const p = one<{ left_at: string | null; removed_at: string | null; email: string | null }>('select left_at, removed_at, email from okr_people where id = ? and workspace_id = ?', found.token.personId, found.workspaceId);
+      return p && !p.left_at && !p.removed_at && !(p.email && leftCompany(p.email.trim().toLowerCase())) ? found : null;
+    },
+    workspaceName: async (id) => one<{ name: string }>('select name from okr_workspaces where id = ?', id)?.name ?? 'Workspace',
+    load: (ws) => store.load(ws),
+    history: (ws, ask) => store.history(ws, ask),
+    commit: (ws, c) => store.commit(ws, c),
+    goalKeys: async (ws, ids) => store.goalKeys(ws, ids),
+    async touch(id) { store.touchToken(id); },
+    issueToken: (ws, c) => store.issueToken(ws, c),
+    deleteWorkspace: (ws) => store.deleteWorkspace(ws),
+    recording: async (id) => one<{ recording: number | null }>('select recording from okr_workspaces where id = ?', id)?.recording !== 0,
+    modulesOff: async (id) => JSON.parse(one<{ modules_off: string | null }>('select modules_off from okr_workspaces where id = ?', id)?.modules_off ?? '[]') as string[],
+    async check() { return { ok: true, database: !!one('select 1 as x'), pictures: true, problems: [] }; },
+    now,
+  };
+}
diff --git a/src/adapters/standin/files.ts b/src/adapters/standin/files.ts
new file mode 100644
index 0000000..83af52e
--- /dev/null
+++ b/src/adapters/standin/files.ts
@@ -0,0 +1,29 @@
+/* Files on the stand-in platform: a local folder (data/files) behind put, get and delete, served by the server at
+   /api/files/<path>. A file is added once and never replaced (the Files port, src/ports/index.ts). Server-only. */
+import fs from 'node:fs';
+import path from 'node:path';
+import type { Files } from '../../ports';
+
+/** A path inside the folder, or an error: no "..", no absolute paths. */
+export function inside(dir: string, p: string): string {
+  const full = path.resolve(dir, p);
+  if (!full.startsWith(path.resolve(dir) + path.sep) || !/^[A-Za-z0-9_\-./]+$/.test(p)) throw new Error('That isn’t a file path the store keeps.');
+  return full;
+}
+
+export function folderFiles(dir: string, urlBase = '/api/files/'): Files & { remove(p: string): Promise<boolean> } {
+  return {
+    async put(p, data) {
+      const full = inside(dir, p);
+      fs.mkdirSync(path.dirname(full), { recursive: true });
+      // 'wx': refuses a path that already has a file.
+      try { fs.writeFileSync(full, new Uint8Array(await data.arrayBuffer()), { flag: 'wx' }); } catch (e) {
+        if ((e as NodeJS.ErrnoException).code === 'EEXIST') throw new Error(`There’s already a file at ${p}.`);
+        throw e;
+      }
+    },
+    async url(p) { return fs.existsSync(inside(dir, p)) ? urlBase + p : null; },
+    async bytes(p) { const full = inside(dir, p); return fs.existsSync(full) ? new Uint8Array(fs.readFileSync(full)) : null; },
+    async remove(p) { const full = inside(dir, p); if (!fs.existsSync(full)) return false; fs.unlinkSync(full); return true; },
+  };
+}
diff --git a/src/adapters/standin/guard.ts b/src/adapters/standin/guard.ts
new file mode 100644
index 0000000..61387a2
--- /dev/null
+++ b/src/adapters/standin/guard.ts
@@ -0,0 +1,80 @@
+/* Who may change what, enforced by the stand-in platform's server on every save (R1 rule 4, drill item 11). The browser
+   still runs Faro's shared actions and sends their result (a Commit); the server compares it with what it holds and
+   refuses a save the access table refuses, with the app's own words. The rules are the domain's (goalRights,
+   ADMIN_CHECK_IN_DOORS, the actions' sentences), asked here, not restated.
+
+   What it can't see: a Commit says what changed, not which action changed it, so the door a check-in came through is
+   the one its change-log entry names (Via), and the rows only some actions may write (a comment's text, an ask's
+   answer, a review's calls) are checked by their author fields where the row has one. The internal app moves the actions
+   to the server (spec/rebuild/ports-at-scale.md) and asks each action's own rule instead. Pure. */
+import { mayChangeGoal, mayPostCheckIn } from '../../domain/goalRights';
+import { VIA_LABEL, type Via } from '../../domain/via';
+import type { Commit } from '../../data/store';
+import type { Goal, Person, Snapshot } from '../../domain/types';
+
+const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
+const byId = <T extends { id: string }>(xs: readonly T[] | undefined) => new Map((xs ?? []).map((x) => [x.id, x]));
+const nameOf = (s: Snapshot, id: string) => s.people.find((p) => p.id === id)?.name;
+
+/** The door a save came through, as its change-log entries say (changeset's Via mark); the check-in form's has none. */
+export function viaOf(c: Commit): Via {
+  const label = c.changes.flatMap((ch) => ch.diffs).find((d) => d.field === 'Via')?.to;
+  return (Object.entries(VIA_LABEL).find(([, l]) => l === label)?.[0] as Via | undefined) ?? 'form';
+}
+
+/** Why the server refuses this save by `actor` on the workspace as stored, in the app's words; null when it may. */
+export function refusal(stored: Snapshot, c: Commit, actor: Person): string | null {
+  const me = { id: actor.id, admin: !!actor.admin };
+  if (actor.leftAt || actor.removedAt) return 'You’re no longer in this workspace.';
+  // Every change is logged as the person signed in (R1 rule 6): nobody acts as someone else.
+  if (c.changes.some((ch) => ch.actorId !== actor.id)) return 'A save can only be made as the person signed in.';
+  const admin = me.admin;
+  if (!admin) {
+    if (c.workspace) return 'Only admins can rename the workspace.';
+    if (c.recording !== undefined) return 'Only admins can turn recording on or off.';
+    if (c.modulesOff !== undefined) return 'Only admins can switch features on or off.';
+    if (c.removeTeams?.length) return 'Only admins can remove a team.';
+    const teams = byId(stored.teams);
+    if ((c.teams ?? []).some((t) => !same(teams.get(t.id), t))) return 'Only an admin can change a team’s objective.';
+    const cycles = byId(stored.cycles);
+    if ((c.cycles ?? []).some((x) => !same(cycles.get(x.id), x))) return 'Only admins can start the next cycle.';
+  }
+  // People: an admin adds and changes them; anyone may mark themselves as left (leaving the workspace), never the only admin.
+  const people = byId(stored.people);
+  for (const p of c.people ?? []) {
+    const was = people.get(p.id);
+    if (!was) { if (!admin) return 'Only an admin can add people.'; continue; }
+    if (same(was, p)) continue;
+    const { leftAt: _a, leftBy: _b, ...rest } = p;
+    const { leftAt: _c, leftBy: _d, ...restWas } = was;
+    const leavingSelf = p.id === actor.id && same(rest, restWas);
+    if (!admin && !leavingSelf) return 'Only an admin can change people.';
+    if (was.admin && (!p.admin || p.leftAt || p.removedAt) && stored.people.filter((x) => x.admin && !x.leftAt && !x.removedAt && x.id !== p.id).length === 0) return 'A workspace always keeps one admin.';
+  }
+  // Goals: a new one, anyone; a change, its owner or an admin (or, while proposed, whoever proposed it).
+  const goals = byId(stored.goals);
+  for (const g of c.goals ?? []) {
+    const was = goals.get(g.id);
+    if (!was || same(was, g)) continue;
+    if (!mayChangeGoal(me, was)) return `Only ${nameOf(stored, was.ownerId) ?? 'its owner'} (its owner) or an admin can change “${was.title}”.`;
+  }
+  // Check-ins: the goal's owner; an admin only through a workbook, set-up or Data's tables (goalRights).
+  const via = viaOf(c);
+  const checkIns = byId(stored.checkIns);
+  const newGoals = byId(c.goals);
+  for (const ci of c.checkIns ?? []) {
+    if (same(checkIns.get(ci.id), ci)) continue;
+    const g: Goal | undefined = goals.get(ci.goalId) ?? newGoals.get(ci.goalId);
+    if (!g) return 'That check-in’s goal isn’t in this workspace.';
+    if (!mayPostCheckIn(me, g, via)) return `Only ${nameOf(stored, g.ownerId) ?? 'its owner'} (its owner) can check in on “${g.title}”.`;
+  }
+  // Views: its owner or an admin changes one; only an admin pins one for everyone.
+  const views = byId(stored.views);
+  for (const v of c.views ?? []) {
+    const was = views.get(v.id);
+    if (same(was, v)) continue;
+    if (!admin && (was ?? v).personId !== actor.id) return 'Only its owner or an admin can change this view.';
+    if (!admin && v.pinned !== !!was?.pinned) return 'Only admins can pin a view for everyone.';
+  }
+  return null;
+}
