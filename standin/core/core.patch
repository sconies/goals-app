diff --git a/platform/auth.ts b/platform/auth.ts
new file mode 100644
index 0000000..5a622c4
--- /dev/null
+++ b/platform/auth.ts
@@ -0,0 +1,120 @@
+/* The stand-in platform's sign-in (drill item 11): email and password (scrypt), a session cookie (HttpOnly,
+   SameSite=Lax), sign-out, and a stub single sign-on: /sso/stub stands for the company's identity provider and issues an
+   HMAC-signed assertion (email, name, groups) that /sso/callback turns into a session. A person the directory marks as
+   left is refused on their next request and every session of theirs ends (R2). Not Faro's code: the platform's. */
+import { createHash, createHmac, randomBytes, scryptSync, timingSafeEqual } from 'node:crypto';
+import type { DatabaseSync } from 'node:sqlite';
+
+export const COOKIE = 'faro_session';
+const SESSION_HOURS = 12;
+/** How long an assertion from the identity provider may take to arrive. */
+const ASSERTION_SECONDS = 120;
+const sha = (s: string) => createHash('sha256').update(s).digest('hex');
+const b64 = (s: string) => Buffer.from(s).toString('base64url');
+
+export interface Session { email: string; via: 'password' | 'sso' }
+export interface Assertion { email: string; name: string; groups: string[]; iat: number }
+
+export function hashPassword(password: string): string {
+  const salt = randomBytes(16).toString('hex');
+  return `scrypt$${salt}$${scryptSync(password, salt, 64).toString('hex')}`;
+}
+export function checkPassword(password: string, stored: string | null | undefined): boolean {
+  const [kind, salt, hash] = (stored ?? '').split('$');
+  if (kind !== 'scrypt' || !salt || !hash) return false;
+  const a = scryptSync(password, salt, 64);
+  const b = Buffer.from(hash, 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+export class Auth {
+  private readonly key: string;
+  constructor(private readonly db: DatabaseSync, private readonly now: () => Date = () => new Date()) {
+    const k = db.prepare(`select value from platform_settings where key = 'sso_key'`).get() as { value: string } | undefined;
+    this.key = process.env.STANDIN_SSO_KEY || k?.value || randomBytes(32).toString('hex');
+    if (!k) db.prepare(`insert or ignore into platform_settings (key, value) values ('sso_key', ?)`).run(this.key);
+  }
+
+  addUser(email: string, name: string, password: string | null) {
+    this.db.prepare('insert into platform_users (email, name, password_hash, created_at) values (?, ?, ?, ?) on conflict (email) do update set name = excluded.name, password_hash = coalesce(excluded.password_hash, platform_users.password_hash)')
+      .run(email.trim().toLowerCase(), name, password ? hashPassword(password) : null, this.now().toISOString());
+  }
+
+  /** A new session for this email; returns the cookie's token (kept only as its hash). */
+  private start(email: string, via: Session['via']): string {
+    const token = randomBytes(32).toString('base64url');
+    const at = this.now();
+    this.db.prepare('insert into platform_sessions (id, email, via, created_at, expires_at) values (?, ?, ?, ?, ?)')
+      .run(sha(token), email, via, at.toISOString(), new Date(at.getTime() + SESSION_HOURS * 3600_000).toISOString());
+    return token;
+  }
+
+  /** Signs in by password: a token, or why not. A leaver can't sign in. */
+  signIn(email: string, password: string): { token: string } | { error: string } {
+    const e = email.trim().toLowerCase();
+    const u = this.db.prepare('select password_hash from platform_users where email = ?').get(e) as { password_hash: string | null } | undefined;
+    if (!u || !checkPassword(password, u.password_hash)) return { error: 'That email and password don’t match.' };
+    if (this.hasLeft(e)) return { error: 'You’ve left the company, so you can’t sign in.' };
+    return { token: this.start(e, 'password') };
+  }
+
+  signOut(token: string | undefined) { if (token) this.db.prepare('delete from platform_sessions where id = ?').run(sha(token)); }
+
+  /** The session a cookie names, or null. A leaver's request ends every session of theirs. */
+  session(token: string | undefined): Session | null {
+    if (!token) return null;
+    const s = this.db.prepare('select email, via, expires_at from platform_sessions where id = ?').get(sha(token)) as (Session & { expires_at: string }) | undefined;
+    if (!s || s.expires_at <= this.now().toISOString()) return null;
+    if (this.hasLeft(s.email)) { this.endAll(s.email); return null; }
+    return { email: s.email, via: s.via };
+  }
+
+  hasLeft(email: string): boolean { return !!this.db.prepare('select 1 from sso_people where email = ? and left = 1').get(email); }
+  endAll(email: string) { this.db.prepare('delete from platform_sessions where email = ?').run(email); }
+
+  // ---------- The stub identity provider ----------
+
+  directory(): { email: string; name: string; groups: string[]; left: boolean }[] {
+    return (this.db.prepare('select * from sso_people order by name').all() as { email: string; name: string; groups: string; left: number }[])
+      .map((p) => ({ email: p.email, name: p.name, groups: JSON.parse(p.groups) as string[], left: !!p.left }));
+  }
+  addToDirectory(email: string, name: string, groups: string[] = []) {
+    this.db.prepare('insert into sso_people (email, name, groups, left) values (?, ?, ?, 0) on conflict (email) do update set name = excluded.name, groups = excluded.groups').run(email.trim().toLowerCase(), name, JSON.stringify(groups));
+  }
+  /** The directory marks someone as left (or back): their sessions end at once. */
+  markLeft(email: string, left = true) {
+    const e = email.trim().toLowerCase();
+    this.db.prepare('update sso_people set left = ? where email = ?').run(left ? 1 : 0, e);
+    if (left) this.endAll(e);
+  }
+
+  /** The identity provider's signed assertion for someone in its directory (what /sso/stub hands to /sso/callback). */
+  assert(email: string): string | null {
+    const p = this.directory().find((x) => x.email === email.trim().toLowerCase());
+    if (!p || p.left) return null;
+    const body = b64(JSON.stringify({ email: p.email, name: p.name, groups: p.groups, iat: Math.floor(this.now().getTime() / 1000) } satisfies Assertion));
+    return `${body}.${createHmac('sha256', this.key).update(body).digest('base64url')}`;
+  }
+
+  /** /sso/callback: checks the signature and age, refuses a leaver, and starts a session. */
+  ssoCallback(assertion: string): { token: string; who: Assertion } | { error: string } {
+    const [body, sig] = assertion.split('.');
+    const bad = { error: 'That sign-in didn’t come from the company’s sign-in.' };
+    if (!body || !sig) return bad;
+    const want = createHmac('sha256', this.key).update(body).digest();
+    const got = Buffer.from(sig, 'base64url');
+    if (want.length !== got.length || !timingSafeEqual(want, got)) return bad;
+    const who = JSON.parse(Buffer.from(body, 'base64url').toString()) as Assertion;
+    if (Math.abs(this.now().getTime() / 1000 - who.iat) > ASSERTION_SECONDS) return { error: 'That sign-in has expired. Sign in again.' };
+    if (this.hasLeft(who.email)) return { error: 'You’ve left the company, so you can’t sign in.' };
+    this.db.prepare('insert into platform_users (email, name, created_at) values (?, ?, ?) on conflict (email) do update set name = excluded.name').run(who.email, who.name, this.now().toISOString());
+    return { token: this.start(who.email, 'sso'), who };
+  }
+
+  /** The scheduler's sweep: expired sessions end, and any leaver's. */
+  sweep(): number {
+    const a = this.db.prepare('delete from platform_sessions where expires_at <= ?').run(this.now().toISOString()).changes;
+    const b = this.db.prepare('delete from platform_sessions where email in (select email from sso_people where left = 1)').run().changes;
+    return Number(a) + Number(b);
+  }
+}
