+
+create index if not exists goal_field_values_field on goal_field_values (field_id);
+create index if not exists goal_field_values_ws on goal_field_values (workspace_id);
+create index if not exists goal_fields_ws on goal_fields (workspace_id);
+create index if not exists okr_api_tokens_workspace on okr_api_tokens (workspace_id);
+create index if not exists okr_changes_goal on okr_changes (goal_id);
+create index if not exists okr_changes_goal_history on okr_changes (goal_id, at DESC, id DESC) where goal_id IS NOT NULL;
+create index if not exists okr_changes_import on okr_changes (workspace_id, import_id) where import_id IS NOT NULL;
+create index if not exists okr_changes_ws_at on okr_changes (workspace_id, at);
+create index if not exists okr_changes_ws_history on okr_changes (workspace_id, at DESC, id DESC);
+create index if not exists okr_check_ins_goal_week on okr_check_ins (goal_id, week);
+create index if not exists okr_check_ins_ws on okr_check_ins (workspace_id);
+create index if not exists okr_cycles_ws on okr_cycles (workspace_id);
+create index if not exists okr_decisions_goal on okr_decisions (goal_id);
+create index if not exists okr_decisions_ws on okr_decisions (workspace_id);
+create index if not exists okr_feedback_newest on okr_feedback (at DESC, id DESC);
+create index if not exists okr_feedback_ws on okr_feedback (workspace_id);
+create index if not exists okr_goal_metrics_metric on okr_goal_metrics (metric_id);
+create index if not exists okr_goal_metrics_ws on okr_goal_metrics (workspace_id);
+create index if not exists okr_goals_ws on okr_goals (workspace_id);
+create index if not exists okr_metrics_ws on okr_metrics (workspace_id);
+create index if not exists okr_people_ws on okr_people (workspace_id);
+create index if not exists okr_requests_recipient on okr_requests (workspace_id, recipient_id) where status = 'open';
+create index if not exists okr_requests_workspace on okr_requests (workspace_id);
+create index if not exists okr_retros_ws on okr_retros (workspace_id);
+create index if not exists okr_reviews_ws on okr_reviews (workspace_id);
+create index if not exists okr_stages_ws on okr_stages (workspace_id);
+create index if not exists okr_teams_ws on okr_teams (workspace_id);
+create index if not exists okr_views_workspace on okr_views (workspace_id);
+create index if not exists okr_watches_ws on okr_watches (workspace_id);
+create unique index if not exists goal_fields_ws_name on goal_fields (workspace_id, lower(trim(name))) where retired_at IS NULL;
+create unique index if not exists okr_cycles_ws_start_live on okr_cycles (workspace_id, start_date) where removed_at IS NULL;
+create unique index if not exists okr_goals_cycle_key on okr_goals (workspace_id, cycle_id, key);
+create unique index if not exists okr_metrics_ws_name on okr_metrics (workspace_id, lower(trim(name))) where removed_at IS NULL;
+create unique index if not exists okr_people_ws_email on okr_people (workspace_id, email) where (email IS NOT NULL) AND (removed_at IS NULL);
+
+-- The feature modules' tables on the allowed list a save may write (migrations 0033, 0052): okr_write's module_tables.
+insert or ignore into module_tables (table_name, module, position) values
+  ('okr_metrics', 'metrics', 10), ('okr_goal_metrics', 'metrics', 20), ('goal_fields', 'tags', 30), ('goal_field_values', 'tags', 40);
diff --git a/platform/migrations/0002_platform.sql b/platform/migrations/0002_platform.sql
new file mode 100644
index 0000000..540e5db
--- /dev/null
+++ b/platform/migrations/0002_platform.sql
@@ -0,0 +1,34 @@
+-- The stand-in platform's own tables: sign-in, sessions and the stub identity provider's directory. Not Faro's: the
+-- internal platform has its own (R1, R2). Workspace membership and roles stay in Faro's okr_people (email, is_admin).
+
+-- People who sign in with a password (email lower case; password hashed with scrypt: "scrypt$<salt>$<hash>").
+create table if not exists platform_users (
+  email text primary key,
+  name text not null,
+  password_hash text,
+  created_at text not null
+);
+
+-- Sessions: the cookie holds a random token; only its SHA-256 is kept. `via`: password or sso.
+create table if not exists platform_sessions (
+  id text primary key,
+  email text not null,
+  via text not null,
+  created_at text not null,
+  expires_at text not null
+);
+create index if not exists platform_sessions_email on platform_sessions (email);
+
+-- The stub identity provider's directory (/sso/stub): who the company says exists. `left` = 1 is a leaver.
+create table if not exists sso_people (
+  email text primary key,
+  name text not null,
+  groups textarray not null default '[]',
+  left boolean not null default 0
+);
+
+-- Settings the platform keeps (the SSO signing key, made at first start).
+create table if not exists platform_settings (
+  key text primary key,
+  value text not null
+);
diff --git a/platform/pages.ts b/platform/pages.ts
new file mode 100644
index 0000000..d3e6e5f
--- /dev/null
+++ b/platform/pages.ts
@@ -0,0 +1,29 @@
+/* The platform's own two pages: its sign-in, and the stub identity provider's list of people. Plain HTML, outside the
+   app (the internal platform brings its own); calm and low density, one primary action each. */
+const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
+const page = (title: string, body: string) => `<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+<title>${esc(title)}</title><style>
+:root{color-scheme:light dark;--bg:#f7f6f3;--fg:#1d1d1b;--muted:#6b6a66;--line:#d9d7d1;--accent:#2f5d50}
+@media (prefers-color-scheme:dark){:root{--bg:#171716;--fg:#ecebe7;--muted:#a3a19b;--line:#3a3936;--accent:#8cc2b0}}
+body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,sans-serif}
+main{max-width:26rem;margin:12vh auto;padding:0 16px}h1{font-size:1.4rem;font-weight:600;margin:0 0 1.5rem}
+label{display:block;margin:0 0 1rem;color:var(--muted);font-size:.9rem}input{display:block;width:100%;box-sizing:border-box;margin-top:.3rem;padding:.6rem;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--fg);font:inherit}
+button{font:inherit;padding:.6rem 1rem;border-radius:6px;border:1px solid var(--accent);cursor:pointer}.primary{background:var(--accent);color:var(--bg)}
+.quiet{background:transparent;color:var(--fg);border-color:var(--line);width:100%;text-align:left;margin:0 0 .5rem}
+p{color:var(--muted)}.problem{color:var(--fg);border:1px solid var(--line);padding:.6rem;border-radius:6px}a{color:var(--accent)}
+</style></head><body><main>${body}</main></body></html>`;
+
+export function signInPage(problem?: string, next = '/'): string {
+  return page('Sign in to Faro', `<h1>Sign in to Faro</h1>${problem ? `<p class="problem" role="alert">${esc(problem)}</p>` : ''}
+<form method="post" action="/api/signin"><input type="hidden" name="next" value="${esc(next)}">
+<label>Email<input name="email" type="email" autocomplete="username" required></label>
+<label>Password<input name="password" type="password" autocomplete="current-password" required></label>
+<button class="primary" type="submit">Sign in</button></form>
+<p>Or <a href="/sso/stub?next=${encodeURIComponent(next)}">sign in with the company’s sign-in</a>.</p>`);
+}
+
+export function ssoStubPage(people: { email: string; name: string; groups: string[]; left: boolean }[], next: string, problem?: string): string {
+  const rows = people.map((p) => `<form method="post" action="/sso/stub/assert"><input type="hidden" name="email" value="${esc(p.email)}"><input type="hidden" name="next" value="${esc(next)}">
+<button class="quiet" type="submit"${p.left ? ' disabled' : ''}>${esc(p.name)} <span style="color:var(--muted)">${esc(p.email)}${p.left ? ' (left)' : ''}</span></button></form>`).join('\n');
+  return page('Company sign-in (stand-in)', `<h1>Company sign-in</h1><p>A stand-in for the company’s identity provider. Choose who signs in.</p>${problem ? `<p class="problem" role="alert">${esc(problem)}</p>` : ''}${rows || '<p>Nobody is in the directory yet.</p>'}`);
+}
diff --git a/platform/prove.mjs b/platform/prove.mjs
new file mode 100644
index 0000000..3e9039e
--- /dev/null
+++ b/platform/prove.mjs
@@ -0,0 +1,176 @@
+/* The stand-in platform's behaviour proof (drill item 11). Starts the built server on a fresh data folder, seeds it,
+   and checks, against the running server: the sign-in (password and stub SSO), a leaver refused (the directory's and
+   Faro's own "marked as left"), who may change what enforced by the server (R1, called directly, not through the app),
+   files, the MCP endpoint, and a goal made and checked in through the app's screens still in SQLite after a restart.
+   Usage: npm run build:standin && node platform/prove.mjs [port]. Prints one line per check and a tally. */
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+
+const PORT = Number(process.argv[2] || 47320);
+const B = `http://localhost:${PORT}`;
+const DATA = fs.mkdtempSync(path.join(os.tmpdir(), 'faro-standin-'));
+const ENV = { ...process.env, STANDIN_PORT: String(PORT), STANDIN_DATA: DATA, NODE_NO_WARNINGS: '1' };
+const PASSWORD = 'faro-standin';
+const WS = 'ws_platform';
+const results = [];
+const check = (name, ok, detail = '') => { results.push({ name, ok: !!ok, detail }); console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ' — ' + detail : ''}`); };
+
+function run(args) { return new Promise((res, rej) => { const p = spawn(process.execPath, ['platform/dist/server.mjs', ...args], { env: ENV, stdio: 'inherit' }); p.on('exit', (c) => (c ? rej(new Error('exit ' + c)) : res())); }); }
+async function start() {
+  const p = spawn(process.execPath, ['platform/dist/server.mjs'], { env: ENV, stdio: ['ignore', 'pipe', 'inherit'] });
+  await new Promise((res) => p.stdout.on('data', (d) => { if (/stand-in platform/.test(String(d))) res(); }));
+  return p;
+}
+const stop = (p) => new Promise((res) => { p.on('exit', res); p.kill(); });
+
+/** A tiny client: keeps its own cookie. */
+function client() {
+  let cookie = '';
+  const c = async (method, url, body, headers = {}) => {
+    const r = await fetch(B + url, { method, redirect: 'manual', headers: { ...(cookie ? { cookie } : {}), ...(body !== undefined ? { 'Content-Type': typeof body === 'string' ? 'application/x-www-form-urlencoded' : 'application/json' } : {}), ...headers }, body: body === undefined ? undefined : typeof body === 'string' ? body : JSON.stringify(body) });
+    const set = r.headers.get('set-cookie'); if (set) { c.setCookie = set; cookie = set.split(';')[0]; }
+    const text = await r.text(); let json = null; try { json = JSON.parse(text); } catch { /* html */ }
+    return { status: r.status, json, text, location: r.headers.get('location') };
+  };
+  c.signIn = (email, password = PASSWORD) => c('POST', '/api/signin', { email, password });
+  return c;
+}
+let n = 0;
+const id = (p) => `${p}_proof${String(++n).padStart(3, '0')}`;
+const change = (actor, entity, entityId, goalId, summary, diffs = []) => ({ id: id('chg'), at: new Date().toISOString(), actorId: actor, goalId, entity, entityId, action: 'edited', summary, diffs });
+
+await run(['seed', PASSWORD]);
+let server = await start();
+try {
+  // ---------- Sign-in ----------
+  const anon = client();
+  let r = await anon('GET', '/');
+  check('opening the app signed out shows the sign-in (R1 rule 9)', r.status === 303 && /^\/signin/.test(r.location ?? ''), `${r.status} → ${r.location}`);
+  r = await anon('GET', '/api/workspaces');
+  check('the API refuses someone signed out', r.status === 401);
+  r = await anon.signIn('rhea.kapoor@example.com', 'wrong');
+  check('a wrong password is refused', r.status === 401, r.json?.error);
+
+  const rhea = client();
+  r = await rhea.signIn('Rhea.Kapoor@Example.com');
+  check('signs in by password (email in any case), with an HttpOnly SameSite=Lax cookie', r.status === 200 && /HttpOnly/.test(rhea.setCookie) && /SameSite=Lax/.test(rhea.setCookie));
+  r = await rhea('GET', '/api/workspaces');
+  check('a member sees their workspace', r.json?.length === 1 && r.json[0].id === WS);
+  r = await rhea('GET', `/api/workspaces/${WS}/whoami`);
+  check('the signed-in email opens their person (R1 rule 2)', r.json?.id === 'rhea', JSON.stringify(r.json));
+  const snap = (await rhea('GET', `/api/workspaces/${WS}`)).json;
+  check('loads the workspace whole', snap?.goals?.length === 126 && snap?.people?.length === 97, `${snap?.goals?.length} goals, ${snap?.people?.length} people`);
+
+  // ---------- Stub SSO ----------
+  const pavel = client();
+  r = await pavel('GET', '/sso/stub');
+  check('/sso/stub lists the directory', r.status === 200 && /pavel\.novak@example\.com/.test(r.text));
+  r = await pavel('POST', '/sso/stub/assert', 'email=pavel.novak%40example.com&next=%2F');
+  const assertion = new URL(B + r.location).searchParams.get('assertion');
+  check('the identity provider issues a signed assertion to /sso/callback', r.status === 303 && /^\/sso\/callback/.test(r.location) && !!assertion);
+  const forged = client();
+  const [body] = assertion.split('.');
+  const other = Buffer.from(JSON.stringify({ ...JSON.parse(Buffer.from(body, 'base64url')), email: 'amara.nwosu@example.com' })).toString('base64url');
+  r = await forged('GET', `/sso/callback?assertion=${other}.${assertion.split('.')[1]}`);
+  check('a forged assertion is refused', r.status === 401);
+  r = await pavel('GET', `/sso/callback?assertion=${encodeURIComponent(assertion)}`);
+  r = await pavel('GET', '/api/me');
+  check('signs in by stub SSO', r.json?.email === 'pavel.novak@example.com' && r.json?.via === 'sso', JSON.stringify(r.json));
+  const pavel2 = client(); await pavel2.signIn('pavel.novak@example.com');
+
+  // ---------- The directory's leaver ----------
+  await anon('POST', '/sso/stub/left', { email: 'pavel.novak@example.com' });
+  r = await pavel('GET', '/api/workspaces');
+  const r2 = await pavel2('GET', '/api/workspaces');
+  check('a leaver’s next request is refused, and every session of theirs ends (SSO and password)', r.status === 401 && r2.status === 401);
+  r = await anon('POST', '/sso/stub/assert', 'email=pavel.novak%40example.com&next=%2F');
+  const r3 = await client().signIn('pavel.novak@example.com');
+  check('a leaver can’t sign in again, by SSO or password', r.status === 403 && r3.status === 401, r3.json?.error);
+
+  // ---------- Who may change what, on the server (R1 rule 4), called directly ----------
+  const amara = client(); await amara.signIn('amara.nwosu@example.com');
+  const theirs = snap.goals.find((g) => g.ownerId !== 'rhea' && g.kind === 'metric' && !g.removedAt && !g.stoppedAt);
+  const mine = snap.goals.find((g) => g.ownerId === 'rhea' && !g.removedAt && !g.stoppedAt);
+  const owner = snap.people.find((p) => p.id === theirs.ownerId);
+  const refusals = [
+    ['renames the workspace', { workspace: { name: 'Mine now' }, changes: [change('rhea', 'workspace', WS, null, 'Renamed')] }, /Only admins can rename the workspace/],
+    ['changes someone else’s goal', { goals: [{ ...theirs, title: theirs.title + ' (edited)' }], changes: [change('rhea', 'goal', theirs.id, theirs.id, 'Renamed')] }, /\(its owner\) or an admin can change/],
+    ['checks in on someone else’s goal', { checkIns: [{ id: id('ci'), goalId: theirs.id, authorId: 'rhea', week: 46, postedAt: new Date().toISOString(), value: 1, status: 'on', calculated: 'on', why: '', greenerWhy: '', next: '' }], changes: [{ ...change('rhea', 'check-in', 'x', theirs.id, 'Posted'), action: 'posted' }] }, /\(its owner\) can check in/],
+    ['saves as someone else', { goals: [{ ...mine, title: mine.title + '!' }], changes: [change('amara', 'goal', mine.id, mine.id, 'Renamed')] }, /only be made as the person signed in/],
+    ['changes someone’s job title', { people: [{ ...owner, role: 'Chief' }], changes: [change('rhea', 'person', owner.id, null, 'Changed')] }, /Only an admin can change people/],
+    ['adds a person', { people: [{ id: 'mallory', name: 'Mallory', role: '', initials: 'M', teamId: null, admin: true, email: 'mallory@example.com' }], changes: [change('rhea', 'person', 'mallory', null, 'Added')] }, /Only an admin can add people/],
+    ['switches a feature off', { modulesOff: ['reviews'], changes: [change('rhea', 'workspace', WS, null, 'Off')] }, /Only admins can switch features/],
+  ];
+  for (const [what, commit, words] of refusals) {
+    r = await rhea('POST', `/api/workspaces/${WS}/commit`, commit);
+    check(`R1: a member who isn’t allowed ${what}: refused by the server with the app’s words`, r.status === 403 && words.test(r.json?.error ?? ''), `${r.status} ${r.json?.error}`);
+  }
+  r = await rhea('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: 'tok_rhea1', personId: 'rhea', name: 'Claude on my laptop', createdBy: 'rhea', createdAt: new Date().toISOString(), lastUsedAt: null, revokedAt: null }], changes: [] });
+  check('R1: a member who isn’t an admin makes a token: refused', r.status === 403 && /Only admins can make tokens/.test(r.json?.error ?? ''), r.json?.error);
+  r = await rhea('POST', `/api/workspaces/${WS}/commit`, { goals: [{ ...mine, title: mine.title + ' (by its owner)' }], changes: [change('rhea', 'goal', mine.id, mine.id, 'Renamed', [{ field: 'Name', from: mine.title, to: mine.title + ' (by its owner)' }])] });
+  check('R1: the goal’s owner changes it: allowed', r.status === 200, r.json?.error);
+  r = await amara('POST', `/api/workspaces/${WS}/commit`, { goals: [{ ...theirs, title: theirs.title + ' (by an admin)' }], changes: [change('amara', 'goal', theirs.id, theirs.id, 'Renamed')] });
+  check('R1: an admin changes someone else’s goal: allowed', r.status === 200, r.json?.error);
+  r = await anon('GET', `/api/workspaces/${WS}`);
+  check('someone signed out reads nothing of a workspace', r.status === 401);
+
+  // ---------- MCP ----------
+  r = await amara('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: 'tok_rheaproof', personId: 'rhea', name: 'Claude in the proof', createdBy: 'amara', createdAt: new Date().toISOString(), lastUsedAt: null, revokedAt: null }], changes: [] });
+  const secret = r.json?.secret;
+  check('an admin makes a token; the secret comes back once', r.status === 200 && /^gk_[A-Za-z0-9]{40}$/.test(secret ?? ''));
+  const mcp = async (method, params, token = secret) => (await anon('POST', '/mcp', { jsonrpc: '2.0', id: ++n, method, params }, { Authorization: `Bearer ${token}`, Accept: 'application/json, text/event-stream' }));
+  r = await mcp('tools/list', {});
+  const tools = r.json?.result?.tools?.map((t) => t.name) ?? [];
+  check('/mcp lists the core’s tools, with every module left out', tools.includes('find_goals') && tools.includes('post_check_in') && !tools.includes('create_token'), `${tools.length} tools`);
+  r = await mcp('tools/call', { name: 'update_goal', arguments: { goal_id: theirs.id, title: 'Taken over' } });
+  check('MCP: a token acts with its person’s rights (rhea can’t change another’s goal)', r.json?.result?.isError && /its owner/.test(JSON.stringify(r.json)), JSON.stringify(r.json?.result?.content?.[0]?.text ?? r.json).slice(0, 160));
+  r = await mcp('tools/call', { name: 'find_goals', arguments: { text: mine.key } });
+  check('MCP: a core tool answers from SQLite', !r.json?.result?.isError && JSON.stringify(r.json).includes(mine.id), JSON.stringify(r.json?.result?.content?.[0]?.text ?? r.json).slice(0, 120));
+  r = await mcp('tools/list', {}, 'gk_' + 'x'.repeat(40));
+  check('MCP: an unknown token is refused', r.status === 401);
+
+  // A token stops when its person leaves the company (the directory's leaver, R2 rule 3): Pavel left above.
+  r = await amara('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: 'tok_pavelproof', personId: 'pavel', name: 'Pavel’s assistant', createdBy: 'amara', createdAt: new Date().toISOString(), lastUsedAt: null, revokedAt: null }], changes: [] });
+  r = await mcp('tools/list', {}, r.json?.secret);
+  check('MCP: the token of someone who left the company is refused (R2 rule 3)', r.status === 401, String(r.status));
+  // A token stops when its person is marked as left in Faro (R1 rules 2 and 5).
+  r = await amara('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: 'tok_tariqproof', personId: 'tariq', name: 'Tariq’s assistant', createdBy: 'amara', createdAt: new Date().toISOString(), lastUsedAt: null, revokedAt: null }], changes: [] });
+  const tariqSecret = r.json?.secret;
+  const tariq = client(); await tariq.signIn('tariq.haddad@example.com');
+  const tp = snap.people.find((p) => p.id === 'tariq');
+  r = await amara('POST', `/api/workspaces/${WS}/commit`, { people: [{ ...tp, leftAt: new Date().toISOString(), leftBy: 'amara' }], changes: [{ ...change('amara', 'person', 'tariq', null, 'Marked as left'), action: 'left' }] });
+  check('an admin marks someone as left in Faro', r.status === 200, r.json?.error);
+  const [ws2, who, load, tok] = await Promise.all([tariq('GET', '/api/workspaces'), tariq('GET', `/api/workspaces/${WS}/whoami`), tariq('GET', `/api/workspaces/${WS}`), mcp('tools/list', {}, tariqSecret)]);
+  check('someone marked as left can’t open the workspace, and their token is refused at once', ws2.json?.length === 0 && who.json?.reason === 'left' && load.status === 404 && tok.status === 401, `workspaces ${ws2.json?.length}, whoami ${JSON.stringify(who.json)}, load ${load.status}, token ${tok.status}`);
+
+  // ---------- Files ----------
+  r = await rhea('PUT', '/api/files/exports/proof.txt', 'hello');
+  const got = await rhea('GET', '/api/files/exports/proof.txt');
+  const again = await rhea('PUT', '/api/files/exports/proof.txt', 'other');
+  const del = await rhea('DELETE', '/api/files/exports/proof.txt');
+  check('files: put, get, never replaced, delete', r.status === 200 && got.text === 'hello' && again.status === 409 && del.status === 200);
+
+  // ---------- Through the app, then a restart ----------
+  const title = 'Runbooks with an owner (proof)';
+  const ui = await new Promise((res) => { const p = spawn(process.execPath, ['platform/ui-proof.mjs', B, 'rhea.kapoor@example.com', PASSWORD, title], { stdio: ['ignore', 'pipe', 'inherit'] }); let out = ''; p.stdout.on('data', (d) => (out += d)); p.on('exit', () => res(JSON.parse(out.trim().split('\n').pop() || '{}'))); });
+  check('through the app’s screens: signs in, makes a goal with New goal and posts a check-in on it', !!ui.goalId && !ui.failed, JSON.stringify(ui).slice(0, 200));
+  await stop(server);
+  server = await start();
+  const db = new DatabaseSync(path.join(DATA, 'faro.db'));
+  const g = db.prepare('select id, key, title, owner_id from okr_goals where id = ?').get(ui.goalId ?? '');
+  const ci = db.prepare('select id, week, value, author_id from okr_check_ins where goal_id = ?').all(ui.goalId ?? '');
+  const log = db.prepare('select count(*) n from okr_changes where goal_id = ? and actor_id = ?').get(ui.goalId ?? '', 'rhea');
+  db.close();
+  check('after a restart, the goal and its check-in are in SQLite, logged as the person signed in', g?.title === title && g?.owner_id === 'rhea' && ci.length === 1 && ci[0].author_id === 'rhea' && log.n >= 2, `${JSON.stringify(g)} check-ins ${JSON.stringify(ci)} log ${log?.n}`);
+  const again2 = client(); await again2.signIn('rhea.kapoor@example.com');
+  r = await again2('GET', `/api/workspaces/${WS}`);
+  check('after a restart, the app loads it back', r.json?.goals?.some((x) => x.id === ui.goalId) && r.json?.checkIns?.some((x) => x.goalId === ui.goalId));
+} finally {
+  await stop(server);
+}
+const failed = results.filter((x) => !x.ok);
+console.log(`\n${results.length - failed.length}/${results.length} checks pass${failed.length ? '; failing: ' + failed.map((f) => f.name).join('; ') : ''}`);
+process.exitCode = failed.length ? 1 : 0;
diff --git a/platform/server.ts b/platform/server.ts
new file mode 100644
index 0000000..5ed2935
--- /dev/null
+++ b/platform/server.ts
@@ -0,0 +1,263 @@
+/* The stand-in platform's server (drill item 11): one node:http server that serves the built app, a JSON API under
+   /api/, the platform's sign-in (/signin, /sso/stub, /sso/callback) and the MCP server at /mcp. Records are kept in one
+   SQLite file (src/adapters/standin/sqliteStore.ts); every access rule is enforced here: who may read a workspace
+   (its members: a live person with the signed-in email, R1 rules 2 and 3) and who may change what (guard.ts, R1 rule 4).
+   Built by `npm run build:standin` into platform/dist/server.mjs; run with `node platform/dist/server.mjs`.
+   Environment: STANDIN_PORT (47310), STANDIN_DATA (platform/data), STANDIN_APP (platform/dist/app). */
+import fs from 'node:fs';
+import http from 'node:http';
+import path from 'node:path';
+import { serve as serveMcp } from '../server/mcp';
+import { openDatabase } from '../src/adapters/standin/migrate';
+import { Refused, SqliteStore } from '../src/adapters/standin/sqliteStore';
+import { standinDeps } from '../src/adapters/standin/deps';
+import { folderFiles } from '../src/adapters/standin/files';
+import { refusal } from '../src/adapters/standin/guard';
+import { matchSignIn } from '../src/adapters/signIn';
+import { isStale } from '../src/ports/store';
+import { personFromRow, type PersonRow } from '../src/data/rows';
+import type { Commit } from '../src/data/store';
+import type { Person, Snapshot, Workspace } from '../src/domain/types';
+import { buildPlatformOrg } from '../src/data/platformOrg/generate';
+import { Auth, COOKIE, type Session } from './auth';
+import { signInPage, ssoStubPage } from './pages';
+
+const ROOT = process.cwd();
+const PORT = Number(process.env.STANDIN_PORT || 47310);
+const DATA = path.resolve(process.env.STANDIN_DATA || path.join(ROOT, 'platform/data'));
+const APP = path.resolve(process.env.STANDIN_APP || path.join(ROOT, 'platform/dist/app'));
+const MIGRATIONS = path.resolve(process.env.STANDIN_MIGRATIONS || path.join(ROOT, 'platform/migrations'));
+
+const db = openDatabase(path.join(DATA, 'faro.db'), MIGRATIONS);
+const store = new SqliteStore(db);
+const auth = new Auth(db);
+const files = folderFiles(path.join(DATA, 'files'));
+const deps = standinDeps(store, () => new Date(), (email) => auth.hasLeft(email));
+
+// ---------- Small helpers ----------
+
+class HttpError extends Error { constructor(readonly status: number, message: string, readonly extra: Record<string, unknown> = {}) { super(message); } }
+const cookies = (req: http.IncomingMessage) => Object.fromEntries((req.headers.cookie ?? '').split(';').map((c) => c.trim().split('=')).filter((p) => p.length === 2).map(([k, v]) => [k!, decodeURIComponent(v!)]));
+const sessionCookie = (token: string) => `${COOKIE}=${token}; HttpOnly; SameSite=Lax; Path=/; Max-Age=${12 * 3600}`;
+function send(res: http.ServerResponse, status: number, body: unknown, headers: Record<string, string> = {}) {
+  res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers });
+  res.end(body === undefined ? '' : JSON.stringify(body));
+}
+function html(res: http.ServerResponse, status: number, body: string, headers: Record<string, string> = {}) {
+  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store', ...headers });
+  res.end(body);
+}
+const redirect = (res: http.ServerResponse, to: string, headers: Record<string, string> = {}) => { res.writeHead(303, { Location: to, ...headers }); res.end(); };
+async function body(req: http.IncomingMessage, limit = 20 * 1024 * 1024): Promise<Buffer> {
+  const chunks: Buffer[] = []; let n = 0;
+  for await (const c of req) { n += (c as Buffer).length; if (n > limit) throw new HttpError(413, 'That is too large to save.'); chunks.push(c as Buffer); }
+  return Buffer.concat(chunks);
+}
+async function input<T>(req: http.IncomingMessage): Promise<T> {
+  const b = (await body(req)).toString('utf8');
+  if ((req.headers['content-type'] ?? '').includes('application/x-www-form-urlencoded')) return Object.fromEntries(new URLSearchParams(b)) as T;
+  return (b ? JSON.parse(b) : {}) as T;
+}
+
+/** The workspace's people with this email (the membership rule reads only these). */
+function peopleWith(ws: string, email: string): Person[] {
+  const rows = db.prepare('select * from okr_people where workspace_id = ? and lower(trim(email)) = ?').all(ws, email.trim().toLowerCase()) as unknown as PersonRow[];
+  return rows.map((r) => personFromRow({ ...r, is_admin: !!r.is_admin }));
+}
+/** Who the signed-in person is in this workspace (R1 rule 2), or why no one. */
+const whoIn = (ws: string, s: Session) => matchSignIn(s.email, peopleWith(ws, s.email));
+/** The member acting, or a refusal: someone who isn't a member reads nothing of a workspace, not even that it exists. */
+function member(ws: string, s: Session): Person {
+  const m = whoIn(ws, s);
+  if (!('id' in m)) throw new HttpError(404, 'There’s no such workspace.');
+  return peopleWith(ws, s.email).find((p) => p.id === m.id)!;
+}
+/** What a member reads (R1 rule 3): everything, but tokens (an admin all, anyone else their own) and feedback (admins). */
+function readable(s: Snapshot, me: Person): Snapshot {
+  if (me.admin) return s;
+  return { ...s, tokens: (s.tokens ?? []).filter((t) => t.personId === me.id), feedback: [] };
+}
+function refuse(e: unknown): never {
+  if (e instanceof HttpError) throw e;
+  if (isStale(e)) throw new HttpError(409, e instanceof Error ? e.message : String(e), { stale: true });
+  if (e instanceof Refused) throw new HttpError(403, e.message);
+  throw new HttpError(400, e instanceof Error ? e.message : String(e));
+}
+
+// ---------- The API ----------
+
+async function api(req: http.IncomingMessage, res: http.ServerResponse, url: URL, s: Session | null) {
+  const p = url.pathname;
+  if (p === '/api/signin' && req.method === 'POST') {
+    const f = await input<{ email?: string; password?: string; next?: string }>(req);
+    const r = auth.signIn(f.email ?? '', f.password ?? '');
+    const form = (req.headers['content-type'] ?? '').includes('form');
+    if ('error' in r) return form ? html(res, 401, signInPage(r.error, f.next)) : send(res, 401, { error: r.error });
+    const next = f.next && f.next.startsWith('/') && !f.next.startsWith('//') ? f.next : '/';
+    return form ? redirect(res, next, { 'Set-Cookie': sessionCookie(r.token) }) : send(res, 200, { ok: true }, { 'Set-Cookie': sessionCookie(r.token) });
+  }
+  if (p === '/api/signout' && req.method === 'POST') { auth.signOut(cookies(req)[COOKIE]); return send(res, 200, { ok: true }, { 'Set-Cookie': `${COOKIE}=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0` }); }
+  if (!s) throw new HttpError(401, 'Sign in first.');
+  if (p === '/api/me') return send(res, 200, { email: s.email, via: s.via });
+
+  if (p === '/api/workspaces' && req.method === 'GET') {
+    const mine = (await store.workspaces()).filter((w) => 'id' in whoIn(w.id, s));
+    return send(res, 200, mine);
+  }
+  if (p === '/api/workspaces' && req.method === 'POST') {
+    // Whoever creates a workspace is its first admin (R1 rule 2): an admin with their email, given to the first admin
+    // without one when the set-up didn't ask for it.
+    const { workspace, snapshot } = await input<{ workspace: Workspace; snapshot: Snapshot }>(req);
+    const people = snapshot.people.map((x) => ({ ...x }));
+    let me = people.find((x) => x.admin && x.email?.trim().toLowerCase() === s.email);
+    if (!me) { me = people.find((x) => x.admin && !x.email); if (me) me.email = s.email; }
+    if (!me) throw new HttpError(403, 'Whoever sets up a workspace is its first admin: add yourself, with your email, as an admin.');
+    try { await store.createWorkspace({ ...workspace, kind: 'own' }, { ...snapshot, people }); } catch (e) { refuse(e); }
+    return send(res, 200, { ok: true });
+  }
+
+  const m = p.match(/^\/api\/workspaces\/([^/]+)(\/[a-z]+)?$/);
+  if (m) {
+    const ws = decodeURIComponent(m[1]!);
+    const rest = m[2] ?? '';
+    if (rest === '/whoami') return send(res, 200, whoIn(ws, s));
+    const me = member(ws, s);
+    if (rest === '' && req.method === 'GET') {
+      const from = url.searchParams.get('from');
+      return send(res, 200, readable(await store.load(ws, from ? { from } : undefined), me));
+    }
+    if (rest === '' && req.method === 'DELETE') {
+      if (!me.admin) throw new HttpError(403, 'Only admins can delete the workspace.');
+      await store.deleteWorkspace(ws);
+      return send(res, 200, { ok: true });
+    }
+    if (rest === '/history' && req.method === 'POST') return send(res, 200, await store.history(ws, await input(req)));
+    if (rest === '/commit' && req.method === 'POST') {
+      const c = await input<Commit>(req);
+      const why = refusal(await store.load(ws), c, me);
+      if (why) throw new HttpError(403, why);
+      // Revoking a token: the store checks that it's the token's person or an admin, as the actor the change names.
+      try { await store.commit(ws, c); } catch (e) { refuse(e); }
+      return send(res, 200, { ok: true });
+    }
+    if (rest === '/tokens' && req.method === 'POST') {
+      const c = await input<Commit>(req);
+      if (c.tokens?.some((t) => t.createdBy !== me.id) || c.changes.some((x) => x.actorId !== me.id)) throw new HttpError(403, 'A save can only be made as the person signed in.');
+      try { return send(res, 200, { secret: await store.issueToken(ws, c) }); } catch (e) { refuse(e); }
+    }
+    if (rest === '/prefs' && req.method === 'GET') return send(res, 200, (await store.personPrefs(ws)).filter((x) => x.personId === me.id));
+    if (rest === '/prefs' && req.method === 'POST') {
+      const pref = await input<{ personId: string; key: string; value: unknown }>(req);
+      if (pref.personId !== me.id) throw new HttpError(403, 'A preference is kept only for the person signed in.');
+      try { await store.keepPersonPref(ws, pref); } catch (e) { refuse(e); }
+      return send(res, 200, { ok: true });
+    }
+  }
+
+  // Files: a local folder behind put, get and delete (anything Faro keeps as a file: markup pictures, exports).
+  const f = p.match(/^\/api\/files\/(.+)$/);
+  if (f) {
+    const name = decodeURIComponent(f[1]!);
+    if (req.method === 'GET') { const b = await files.bytes(name); if (!b) throw new HttpError(404, 'There’s no such file.'); res.writeHead(200, { 'Content-Type': 'application/octet-stream' }); return res.end(b); }
+    if (req.method === 'PUT') { try { await files.put(name, new Blob([new Uint8Array(await body(req))]), String(req.headers['content-type'] ?? '')); } catch (e) { throw new HttpError(409, e instanceof Error ? e.message : String(e)); } return send(res, 200, { ok: true }); }
+    if (req.method === 'DELETE') return send(res, (await files.remove(name)) ? 200 : 404, { ok: true });
+  }
+  throw new HttpError(404, 'There’s nothing at that address.');
+}
+
+// ---------- The stub identity provider ----------
+
+async function sso(req: http.IncomingMessage, res: http.ServerResponse, url: URL) {
+  if (url.pathname === '/sso/stub' && req.method === 'GET') return html(res, 200, ssoStubPage(auth.directory(), url.searchParams.get('next') ?? '/'));
+  if (url.pathname === '/sso/stub/assert' && req.method === 'POST') {
+    const f = await input<{ email: string; next?: string }>(req);
+    const a = auth.assert(f.email);
+    if (!a) return html(res, 403, ssoStubPage(auth.directory(), f.next ?? '/', 'The company’s sign-in refused: that person has left.'));
+    return redirect(res, `/sso/callback?assertion=${encodeURIComponent(a)}&next=${encodeURIComponent(f.next ?? '/')}`);
+  }
+  // The directory's own change (a leaver, or back again): what HR's system does in the company.
+  if (url.pathname === '/sso/stub/left' && req.method === 'POST') {
+    const f = await input<{ email: string; left?: boolean | string }>(req);
+    auth.markLeft(f.email, f.left !== false && f.left !== 'false');
+    return send(res, 200, { ok: true });
+  }
+  if (url.pathname === '/sso/callback') {
+    const r = auth.ssoCallback(url.searchParams.get('assertion') ?? '');
+    if ('error' in r) return html(res, 401, signInPage(r.error));
+    const next = url.searchParams.get('next') ?? '/';
+    return redirect(res, next.startsWith('/') && !next.startsWith('//') ? next : '/', { 'Set-Cookie': sessionCookie(r.token) });
+  }
+  throw new HttpError(404, 'There’s nothing at that address.');
+}
+
+// ---------- The MCP server ----------
+
+async function mcp(req: http.IncomingMessage, res: http.ServerResponse, url: URL) {
+  const b = req.method === 'GET' || req.method === 'HEAD' || req.method === 'OPTIONS' ? undefined : await body(req);
+  const headers = new Headers();
+  for (const [k, v] of Object.entries(req.headers)) if (typeof v === 'string') headers.set(k, v);
+  const r = await serveMcp(new Request(url, { method: req.method, headers, body: b ? new Uint8Array(b) : undefined }), deps);
+  res.writeHead(r.status, Object.fromEntries(r.headers));
+  res.end(Buffer.from(await r.arrayBuffer()));
+}
+
+// ---------- The app ----------
+
+const TYPES: Record<string, string> = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.jpg': 'image/jpeg', '.ico': 'image/x-icon', '.webmanifest': 'application/manifest+json', '.txt': 'text/plain', '.woff2': 'font/woff2', '.md': 'text/markdown' };
+function app(_req: http.IncomingMessage, res: http.ServerResponse, url: URL, s: Session | null) {
+  const file = path.join(APP, path.normalize(decodeURIComponent(url.pathname)).replace(/^(\.\.[/\\])+/, ''));
+  if (file.startsWith(APP) && fs.existsSync(file) && fs.statSync(file).isFile()) {
+    res.writeHead(200, { 'Content-Type': TYPES[path.extname(file)] ?? 'application/octet-stream', 'Cache-Control': url.pathname.startsWith('/assets/') ? 'public, max-age=31536000, immutable' : 'no-cache' });
+    return res.end(fs.readFileSync(file));
+  }
+  // The demo is open (it keeps its example in the browser); anything else opens on the sign-in (R1 rule 9).
+  const demo = url.pathname === '/demo' || url.pathname.startsWith('/demo/');
+  if (!demo && !s) return redirect(res, '/signin?next=' + encodeURIComponent(url.pathname + url.search));
+  if (path.extname(url.pathname) && !demo) return send(res, 404, { error: 'There’s no such file.' });
+  return html(res, 200, fs.readFileSync(path.join(APP, 'index.html'), 'utf8'));
+}
+
+// ---------- The server ----------
+
+const server = http.createServer(async (req, res) => {
+  const url = new URL(req.url ?? '/', `http://${req.headers.host ?? 'localhost'}`);
+  try {
+    const s = auth.session(cookies(req)[COOKIE]);
+    if (url.pathname === '/signin') return html(res, 200, signInPage(undefined, url.searchParams.get('next') ?? '/'));
+    if (url.pathname.startsWith('/sso/')) return await sso(req, res, url);
+    if (url.pathname === '/mcp' || url.pathname === '/api/mcp') return await mcp(req, res, url);
+    if (url.pathname.startsWith('/api/')) return await api(req, res, url, s);
+    return app(req, res, url, s);
+  } catch (e) {
+    const err = e instanceof HttpError ? e : new HttpError(500, e instanceof Error ? e.message : String(e));
+    if (err.status === 500) console.error(e);
+    if (!res.headersSent) send(res, err.status, { error: err.message, ...err.extra });
+  }
+});
+
+// ---------- Jobs: what runs on a timer ----------
+
+const jobs = [
+  // Sessions that expired, and every session of someone the directory marks as left.
+  { every: 60_000, run: () => auth.sweep() },
+];
+
+/** Seeds a workspace from the demo's example (as a workspace of its own, kind "own") and signs everyone in it up: a
+    password for each, and the stub directory with each. For trying the platform; never real people. */
+async function seed(password: string) {
+  const today = new Date();
+  const s = buildPlatformOrg(today);
+  const ws: Workspace = { id: 'ws_platform', name: 'Platform Engineering', kind: 'own', createdAt: today.toISOString() };
+  if (!(await store.workspaces()).some((w) => w.id === ws.id)) await store.createWorkspace(ws, { ...s, tokens: [], feedback: [] });
+  for (const p of s.people) if (p.email) { auth.addUser(p.email, p.name, password); auth.addToDirectory(p.email, p.name, p.admin ? ['faro-admins'] : []); }
+  console.log(`Seeded ${ws.name}: ${s.people.length} people, ${s.goals.length} goals; password “${password}” for each.`);
+}
+
+const args = process.argv.slice(2);
+if (args[0] === 'seed') {
+  await seed(args[1] ?? 'faro-standin');
+  db.close();
+} else {
+  server.listen(PORT, () => console.log(`Faro on the stand-in platform: http://localhost:${PORT} (data ${DATA})`));
+  for (const j of jobs) setInterval(() => { try { j.run(); } catch (e) { console.error('job', e); } }, j.every).unref();
+}
diff --git a/platform/translate-schema.mjs b/platform/translate-schema.mjs
new file mode 100644
index 0000000..a2f7338
--- /dev/null
+++ b/platform/translate-schema.mjs
@@ -0,0 +1,84 @@
+/* Writes platform/migrations/0001_core.sql: Faro's core tables for SQLite, translated from spec/core/schema.sql (the
+   database after every migration). Mechanical: columns, defaults, primary keys, unique keys and
+   indexes. Foreign keys, CHECK constraints, triggers, functions and grants are left out: on the stand-in platform the
+   server enforces every rule (src/adapters/standin/sqliteStore.ts, guard.ts). Run: node platform/translate-schema.mjs */
+import fs from 'node:fs';
+import path from 'node:path';
+
+const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
+const src = fs.readFileSync(path.join(root, 'spec/core/schema.sql'), 'utf8');
+/** Not the core's: Faro's own telemetry, markups and research (the feedback module and Faro's builders). */
+const SKIP = /^okr_(telemetry_|markup|research_notes|builders)/;
+
+/** Splits on top-level commas, outside quotes and brackets. */
+function split(body) {
+  const out = []; let depth = 0, q = false, cur = '';
+  for (const ch of body) {
+    if (ch === "'") q = !q;
+    if (!q && ch === '(') depth++;
+    if (!q && ch === ')') depth--;
+    if (!q && depth === 0 && ch === ',') { out.push(cur.trim()); cur = ''; continue; }
+    cur += ch;
+  }
+  if (cur.trim()) out.push(cur.trim());
+  return out;
+}
+
+const TYPES = [
+  [/^timestamp with time zone/, 'timestamptext'], [/^text\[\]/, 'textarray'], [/^jsonb/, 'jsontext'], [/^text/, 'text'], [/^uuid/, 'text'],
+  [/^(integer|bigint|smallint)/, 'integer'], [/^(numeric|double precision)/, 'real'], [/^boolean/, 'boolean'], [/^date/, 'datetext'],
+];
+function defaultOf(expr) {
+  const e = expr.trim();
+  if (e === 'now()') return "(strftime('%Y-%m-%dT%H:%M:%fZ','now'))";
+  if (e === 'gen_random_uuid()') return '(lower(hex(randomblob(16))))';
+  if (e === 'false') return '0';
+  if (e === 'true') return '1';
+  if (/^-?\d+(\.\d+)?$/.test(e)) return e;
+  let m = e.match(/^'(.*)'::(text|jsonb)$/); if (m) return `'${m[1]}'`;
+  if (/^'\{\}'::text\[\]$/.test(e)) return "'[]'";
+  throw new Error('No SQLite default for ' + e);
+}
+function column(def) {
+  const m = def.match(/^("?[a-z_0-9]+"?)\s+(.*)$/i);
+  const [, name, rest] = m;
+  const t = TYPES.find(([re]) => re.test(rest));
+  if (!t) throw new Error('No SQLite type for ' + def);
+  const notNull = /\bnot null\b/.test(rest) ? ' not null' : '';
+  const d = rest.match(/\bdefault (.+)$/);
+  return `  ${name} ${t[1]}${notNull}${d ? ' default ' + defaultOf(d[1]) : ''}`;
+}
+
+const tables = [...src.matchAll(/^create table (\w+) \(\n([\s\S]*?)\n\);/gm)];
+let out = `-- Generated by platform/translate-schema.mjs from spec/core/schema.sql (Faro's database after every migration).
+-- SQLite, for the stand-in platform. Kept: columns, defaults, primary and unique keys, indexes. Left out on purpose:
+-- foreign keys, CHECK constraints, triggers, functions and grants (the server enforces the rules), and the tables that
+-- are not the core's (telemetry, markups, research notes, builders). Declared types say how the store reads a value
+-- back: boolean (0/1), jsontext and textarray (JSON text), timestamptext and datetext (ISO text), real, integer, text.
+
+`;
+const kept = [];
+for (const [, name, body] of tables) {
+  if (SKIP.test(name)) continue;
+  kept.push(name);
+  const parts = split(body).map((p) => {
+    const c = p.match(/^constraint \w+ (PRIMARY KEY|UNIQUE) (\(.*\))$/s);
+    if (c) return `  ${c[1].toLowerCase()} ${c[2]}`;
+    if (/^constraint /.test(p)) return null;
+    return column(p);
+  }).filter(Boolean);
+  out += `create table if not exists ${name} (\n${parts.join(',\n')}\n);\n\n`;
+}
+for (const m of src.matchAll(/^CREATE (UNIQUE )?INDEX (\w+) ON faro\.(\w+) USING btree (\(.*?\))( WHERE (.*))?;$/gm)) {
+  const [, uniq, name, tbl, cols, , where] = m;
+  if (!kept.includes(tbl)) continue;
+  const fix = (s) => s.replace(/TRIM\(BOTH FROM (\w+)\)/g, 'trim($1)').replace(/'([^']*)'::text/g, "'$1'");
+  out += `create ${uniq ? 'unique ' : ''}index if not exists ${name} on ${tbl} ${fix(cols)}${where ? ' where ' + fix(where.replace(/^\((.*)\)$/, '$1')) : ''};\n`;
+}
+out += `
+-- The feature modules' tables on the allowed list a save may write (migrations 0033, 0052): okr_write's module_tables.
+insert or ignore into module_tables (table_name, module, position) values
+  ('okr_metrics', 'metrics', 10), ('okr_goal_metrics', 'metrics', 20), ('goal_fields', 'tags', 30), ('goal_field_values', 'tags', 40);
+`;
+fs.writeFileSync(path.join(root, 'platform/migrations/0001_core.sql'), out);
+console.log(`0001_core.sql: ${kept.length} tables`);
diff --git a/platform/ui-proof.mjs b/platform/ui-proof.mjs
