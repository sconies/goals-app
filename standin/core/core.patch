+  /** A value as SQLite keeps it, by the column's declared type. */
+  private encode(type: string, v: unknown): SQLInputValue {
+    if (v === undefined || v === null) return null;
+    if (type === 'boolean') return v ? 1 : 0;
+    if (type === 'jsontext' || type === 'textarray') return JSON.stringify(v);
+    if (type === 'timestamptext' && typeof v === 'string') { const t = Date.parse(v); return Number.isNaN(t) ? v : new Date(t).toISOString(); }
+    if (typeof v === 'boolean') return v ? 1 : 0;
+    if (typeof v === 'object') return JSON.stringify(v);
+    return v as SQLInputValue;
+  }
+
+  /** A row as src/data/rows.ts reads it. */
+  private decode(table: string, r: Row): Row {
+    const c = this.columns(table);
+    const out: Row = {};
+    for (const [k, v] of Object.entries(r)) {
+      const t = c.get(k);
+      out[k] = v === null ? null : t === 'boolean' ? !!v : t === 'jsontext' || t === 'textarray' ? JSON.parse(v as string) : v;
+    }
+    return out;
+  }
