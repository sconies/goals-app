+  /** okr_token_revoke: the token's person or an admin; true when it was live. */
+  revokeToken(ws: string, id: string, by: string, change: Row | null): boolean {
+    return this.tx(() => {
+      const t = this.db.prepare('select person_id, revoked_at from okr_api_tokens where id = ? and workspace_id = ?').get(id, ws) as { person_id: string; revoked_at: string | null } | undefined;
