+  private tokens(ws: string): TokenRow[] {
+    return this.select('okr_api_tokens', 'workspace_id = ?', [ws], 'created_at, id').map(({ token_hash: _h, builder_email: b, ...r }) => ({ ...r, builder: b != null })) as unknown as TokenRow[];
