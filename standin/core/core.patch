+    this.upsert('okr_decisions', p.decisions as unknown as Row[], ['id']);
+    this.upsert('okr_watches', p.watches as unknown as Row[], ['id']);
+    for (const id of p.unwatch ?? []) this.db.prepare('delete from okr_watches where workspace_id = ? and id = ?').run(ws, id);
+    this.upsert('okr_views', p.views as unknown as Row[], ['id']);
+    this.upsert('okr_requests', p.requests as unknown as Row[], ['id']);
+    const order = this.db.prepare('select table_name from module_tables order by position, table_name').all() as { table_name: string }[];
+    for (const { table_name: t } of order) if (t in mods) this.upsert(t, mods[t], ['id']);
