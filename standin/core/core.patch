+/* The behaviour proof through the app (drill item 11): signs in by password, makes a goal with New goal and checks in
+   on it, all through the screens on the stand-in server. Prints the new goal's id. Usage:
+   node platform/ui-proof.mjs <base> <email> <password> <goal title> [shots folder] */
+import { chromium } from 'playwright';
+const [B, EMAIL, PASSWORD, TITLE, SHOTS] = process.argv.slice(2);
+const browser = await chromium.launch();
+const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });
+const errs = []; page.on('pageerror', (e) => errs.push(String(e)));
+const shot = (n) => SHOTS ? page.screenshot({ path: `${SHOTS}/${n}.png` }) : null;
+const buttons = async () => (await page.locator('button:visible').allInnerTexts()).map((t) => t.trim()).filter(Boolean).join(' | ');
+try {
+  await page.goto(B + '/goals/new');
+  await page.fill('input[name=email]', EMAIL);
+  await page.fill('input[name=password]', PASSWORD);
+  await page.click('button[type=submit]');
+  for (const step of ['what', 'who', 'measure', 'check']) {
+    await page.waitForURL(new RegExp(`/goals/new/${step}`), { timeout: 15000 });
+    await page.waitForTimeout(300);
+    if (step === 'what') await page.getByLabel(/Name it the way/).fill(TITLE);
+    if (step === 'who') { const lv = page.getByRole('group', { name: 'Level' }); if (await lv.count()) await lv.getByRole('button', { name: 'Team' }).click(); }
+    if (step === 'measure') { await page.getByLabel('Unit').fill('%'); await page.getByLabel(/^Baseline$/).fill('20'); await page.getByLabel(/^Target$/).fill('90'); }
+    await shot('goal-' + step);
+    if (step !== 'check') await page.getByRole('button', { name: 'Continue' }).click();
+  }
+  console.error('check step buttons:', await buttons());
+  await page.locator('.focus-foot .btn.primary').click();
+  await page.waitForURL((u) => !/\/goals\/new/.test(u.pathname), { timeout: 15000 });
+  await page.waitForTimeout(1000);
+  await shot('goal-made');
+  console.error('after publish:', page.url());
+  const id = decodeURIComponent(new URL(page.url()).pathname.split('/').filter(Boolean).pop());
+  await page.goto(B + '/check-in/' + id);
+  await page.waitForTimeout(1000);
+  await shot('checkin-1');
+  console.error('check-in buttons:', await buttons());
+  await page.getByLabel('This week’s value').fill('20');
+  await page.waitForTimeout(150);
+  const meant = page.locator('.level-check .level-actions button').first();
+  if (await meant.isVisible().catch(() => false)) await meant.click();
+  const cont = page.getByRole('button', { name: 'Continue' });
+  if (await cont.count()) await cont.click();
+  await page.waitForTimeout(300);
+  await shot('checkin-2');
+  console.error('check-in step 2 buttons:', await buttons());
+  await page.getByRole('button', { name: 'Post check-in' }).click();
+  await page.getByText('Check-in saved').first().waitFor({ timeout: 8000 });
+  await shot('checkin-saved');
+  console.log(JSON.stringify({ goalId: id, errors: errs }));
+} catch (e) {
+  await shot('failed');
+  console.log(JSON.stringify({ failed: String(e).slice(0, 400), url: page.url(), errors: errs, buttons: await buttons() }));
+  process.exitCode = 1;
+} finally { await browser.close(); }
