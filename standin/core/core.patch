+    this.tx(() => {
+      this.upsert('okr_workspaces', [{ ...workspaceToRow(w), ...(w.modulesOff?.length ? { modules_off: w.modulesOff } : {}) } as unknown as Row], ['id'], 'nothing');
+      if (!this.db.prepare('select 1 from okr_workspaces where id = ?').get(w.id)) throw new Refused('The workspace couldn’t be made.');
+      this.sameWorkspace(w.id, p);
+      this.write(w.id, p);
+    });
+  }
+
+  async deleteWorkspace(ws: string) {
+    if (ws === EXAMPLE.id) throw new Error('The example can’t be deleted.');
+    this.tx(() => {
+      const mods = (this.db.prepare('select table_name from module_tables').all() as { table_name: string }[]).map((r) => r.table_name).filter((t) => this.exists(t));
+      for (const t of [...mods, ...ALL_TABLES]) this.db.prepare(`delete from ${t} where workspace_id = ?`).run(ws);
+      this.db.prepare('delete from okr_goal_keys where workspace_id = ?').run(ws);
+      this.db.prepare('delete from okr_workspaces where id = ?').run(ws);
+    });
+  }
+
+  async personPrefs(ws: string): Promise<PersonPref[]> {
+    return (this.select('person_prefs', 'workspace_id = ?', [ws], 'person_id, key') as { person_id: string; key: string; value: unknown }[]).map((r) => ({ personId: r.person_id, key: r.key, value: r.value }));
+  }
+
+  /** Keeps one, replacing the person's value for that key; only the listed keys, and small (person_prefs' checks). */
+  async keepPersonPref(ws: string, p: PersonPref) {
+    if (p.key !== 'proposals') throw new Refused(`person_prefs: ${p.key} isn’t a preference the server keeps`);
+    if (JSON.stringify(p.value).length > 16384) throw new Refused('person_prefs: the value is too large');
+    this.upsert('person_prefs', [{ workspace_id: ws, person_id: p.personId, key: p.key, value: p.value, updated_at: this.now().toISOString() }], ['workspace_id', 'person_id', 'key']);
+  }
+}
