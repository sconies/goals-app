+  /** okr_same_workspace: every row says this workspace, and none a save updates is kept under another. */
+  private sameWorkspace(ws: string, p: Payload) {
+    const mods = this.mods(p);
+    const allowed = new Set((this.db.prepare('select table_name from module_tables').all() as { table_name: string }[]).map((r) => r.table_name));
+    for (const t of Object.keys(mods)) if (!allowed.has(t)) throw new Refused(`a save can't write to ${t}: it isn't a table a module declares`);
+    const p2 = p as unknown as Record<string, Row[] | undefined>;
+    for (const k of ['teams', 'people', 'cycles', 'goals', 'check_ins', 'reviews', 'feedback', 'retros', 'decisions', 'watches', 'tokens', 'views', 'requests', 'changes']) {
+      for (const r of p2[k] ?? []) if (r.workspace_id !== ws) throw new Refused(`a ${k} row belongs to another workspace`);
+    }
+    for (const [t, rows] of Object.entries(mods)) for (const r of rows ?? []) if (r.workspace_id !== ws) throw new Refused(`a ${t} row belongs to another workspace`);
+    for (const [k, t] of [...CORE, ...Object.keys(mods).map((m) => [m, m] as [string, string])]) {
+      const ids = ((k === t ? mods[t] : p2[k]) ?? []).filter((r) => 'id' in r).map((r) => String(r.id));
+      if (!ids.length || !this.exists(t)) continue;
+      const clash = this.db.prepare(`select id from ${t} where id in (${ids.map(() => '?').join(', ')}) and workspace_id is not ? limit 1`).get(...ids, ws);
+      if (clash) throw new Refused(`a ${k} row belongs to another workspace`);
+    }
+    for (const s of (p.stages ?? []) as unknown as { goal_id: string; rows: Row[] }[]) {
+      if (this.db.prepare('select 1 from okr_goals where id = ? and workspace_id is not ?').get(s.goal_id, ws)) throw new Refused('a stages row belongs to another workspace');
+      for (const r of s.rows ?? []) if (r.workspace_id !== ws || r.goal_id !== s.goal_id) throw new Refused('a stages row belongs to another workspace');
+    }
+  }
+
+  /** okr_check_expectations: refused as stale when a goal or review has moved on, or a week's check-in has changed. */
+  private expectations(ws: string, e: Payload['expect']) {
+    if (!e) return;
+    for (const [list, table, what] of [[e.goals, 'okr_goals', 'goal'], [e.reviews, 'okr_reviews', 'review']] as const) {
+      for (const x of (list ?? []) as { id: string; version?: number | null }[]) {
+        const cur = this.db.prepare(`select version from ${table} where id = ? and workspace_id = ?`).get(x.id, ws) as { version: number } | undefined;
+        if (cur && (x.version === null || x.version === undefined || cur.version !== Number(x.version))) throw new StaleError(`${what} ${x.id}`);
+      }
+    }
+    for (const x of e.check_ins ?? []) {
+      const cur = this.db.prepare('select id from okr_check_ins where goal_id = ? and week = ?').get(x.goal_id, x.week) as { id: string } | undefined;
