@@ -0,0 +1,70 @@
+// @vitest-environment node
+/* The stand-in platform's adapters pass the ports' contracts (drill item 11): the goals store on SQLite (every
+   migration in platform/migrations, then the contract module's table as its migration would make it), the AI tools'
+   endpoint's Deps on it, files in a local folder, the system clock, and who is viewing from the platform's sign-in. */
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { CONTRACT_MODULE, contractWorkspace, storeContract } from '../../ports/contracts/store';
+import { depsContract } from '../../ports/contracts/deps';
+import { clockContract, filesContract, identityContract } from '../../ports/contracts/parts';
+import { MODULE_RECORDS } from '../../core/records';
+import { systemClock } from '../local';
+import { signInIdentity } from '../signIn';
+import { openDatabase } from './migrate';
+import { SqliteStore } from './sqliteStore';
+import { standinDeps } from './deps';
+import { folderFiles } from './files';
+import type { Person } from '../../domain/types';
+
+const MIGRATIONS = path.resolve(__dirname, '../../../platform/migrations');
+/** The contract module's table for SQLite: CONTRACT_MODULE_SQL is Postgres's (faro schema, grants, a view). */
+const CONTRACT_MODULE_SQLITE = `create table okr_contract_marks (id text primary key, workspace_id text not null, goal_id text not null, text text not null, at timestamptext not null, removed_at timestamptext, removed_by text);
+  insert or ignore into module_tables (table_name, module, position) values ('okr_contract_marks', 'contract', 100);`;
+const fresh = () => { const db = openDatabase(':memory:', MIGRATIONS); db.exec(CONTRACT_MODULE_SQLITE); return db; };
+
+storeContract('the stand-in platform (SQLite)', async () => new SqliteStore(fresh(), [...MODULE_RECORDS, CONTRACT_MODULE]));
+
+depsContract('the stand-in platform (SQLite)', async () => {
+  const store = new SqliteStore(fresh());
+  return { deps: standinDeps(store), create: (w, d) => store.createWorkspace(w, d) };
+});
+
+filesContract('a local folder (the stand-in platform)', async () => folderFiles(fs.mkdtempSync(path.join(os.tmpdir(), 'faro-files-'))));
+clockContract('the stand-in platform’s clock (the system’s)', () => systemClock);
+
+// Who is viewing: the platform's session says the email (GET /api/me); the person is matched in the workspace's people.
+identityContract('the stand-in platform’s sign-in', () => {
+  let email: string | null = null;
+  const people = new Map<string, Person[]>();
+  const identity = signInIdentity(async () => email, async (ws) => people.get(ws) ?? []);
+  return {
+    identity,
+    signIn: (ws, id) => {
+      email = 'Someone@Example.com';
+      for (const [w, list] of people) people.set(w, list.filter((p) => p.id !== id));
+      people.set(ws, [...(people.get(ws) ?? []).filter((p) => p.email !== 'someone@example.com'), { id, name: id, role: '', initials: '', teamId: null, admin: false, email: 'someone@example.com' } as Person]);
+    },
+  };
+});
+
+describe('the stand-in platform beyond the contracts', () => {
+  it('applies each migration once, and keeps what was saved across a reopen of the file', async () => {
+    const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'faro-db-')), 'faro.db');
+    const s1 = new SqliteStore(openDatabase(file, MIGRATIONS));
+    await s1.createWorkspace({ id: 'ws_keep', name: 'Kept', kind: 'own', createdAt: '2026-11-01T00:00:00.000Z' }, contractWorkspace('k1'));
+    s1.db.close();
+    const s2 = new SqliteStore(openDatabase(file, MIGRATIONS));
+    expect((await s2.workspaces()).map((w) => w.id)).toEqual(['ws_keep']);
+    expect((await s2.load('ws_keep')).goals.length).toBe(contractWorkspace('k1').goals.length);
+  });
+
+  it('keeps Prefs on the server: one value per person and key, only the listed keys', async () => {
+    const s = new SqliteStore(fresh());
+    await s.createWorkspace({ id: 'ws_pp', name: 'Prefs', kind: 'own', createdAt: '2026-11-01T00:00:00Z' }, contractWorkspace('pp1'));
+    await s.keepPersonPref('ws_pp', { personId: 'ada', key: 'proposals', value: { opened: ['g1'] } });
+    await s.keepPersonPref('ws_pp', { personId: 'ada', key: 'proposals', value: { opened: ['g1', 'g2'] } });
+    expect(await s.personPrefs('ws_pp')).toEqual([{ personId: 'ada', key: 'proposals', value: { opened: ['g1', 'g2'] } }]);
+    await expect(s.keepPersonPref('ws_pp', { personId: 'ada', key: 'recents', value: [] })).rejects.toThrow();
+  });
+});
