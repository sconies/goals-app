+/* The stand-in platform's ports behind the drill harness's shim (spec/conformance/contracts): the goals store is the
+   SQLite one (a fresh database per case, every migration in platform/migrations, and the contract module's table); the
+   goal lists, Search and Prefs are Faro's own, which the platform keeps unchanged. */
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { caller } from '../../src/ports/contracts/cases/run';
+import { storeStart, CONTRACT_MODULE } from '../../src/ports/contracts/store';
+import { prefsStart, searchStart } from '../../src/ports/contracts/search';
+import { goalsStart } from '../../src/ports/contracts/goals';
+import { conformanceBase, conformanceGoals, memoryPrefs, seededSearch } from '../../src/adapters/contractPorts';
+import { MODULE_RECORDS } from '../../src/core/records';
+import { openDatabase } from '../../src/adapters/standin/migrate';
+import { SqliteStore } from '../../src/adapters/standin/sqliteStore';
+
+const MIGRATIONS = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../migrations');
+const sqlite = async () => {
+  const db = openDatabase(':memory:', MIGRATIONS);
+  db.exec(`create table okr_contract_marks (id text primary key, workspace_id text not null, goal_id text not null, text text not null, at timestamptext not null, removed_at timestamptext, removed_by text);
+    insert or ignore into module_tables (table_name, module, position) values ('okr_contract_marks', 'contract', 100);`);
+  return new SqliteStore(db, [...MODULE_RECORDS, CONTRACT_MODULE]);
+};
+export const standinCaller = () => caller({ store: storeStart(sqlite), search: searchStart(seededSearch), prefs: prefsStart(memoryPrefs), goals: goalsStart(conformanceBase, conformanceGoals) });
diff --git a/platform/drill/shim.mjs b/platform/drill/shim.mjs
