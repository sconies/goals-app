+  /** okr_token_create: an admin makes one for someone here; the secret is made here, kept only as its hash, and returned once. */
+  async issueToken(ws: string, c: Commit): Promise<string> {
+    const t = c.tokens?.[0];
+    if (!t || c.tokens!.length !== 1) throw new Error('Saving the token: one token at a time.');
+    const change = c.changes[0] ? changeToRow(ws, c.changes[0]) as unknown as Row : null;
+    return this.tx(() => {
+      const name = (t.name ?? '').trim();
