+/** The secret of a new token: "gk_" and 40 letters and digits (okr_token_secret). */
+export function tokenSecret(): string {
+  const abc = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
