+  async load(ws: string, window?: LoadWindow): Promise<Snapshot> {
+    const cycles = this.all<CycleRow>('okr_cycles', ws);
+    if (!cycles.length) throw new Error('This workspace has no cycle yet.');
+    const stages = this.all<StageRow>('okr_stages', ws);
+    const goals = this.all<GoalRow>('okr_goals', ws);
+    const modules = await loadModules(this.records, async (t) => (this.exists(t) ? this.all<DbRow>(t, ws) : null));
+    const s = upgradeAsks({
+      teams: this.all<TeamRow>('okr_teams', ws).map(teamFromRow),
+      people: this.all<PersonRow>('okr_people', ws).map(personFromRow),
+      cycles: cycles.map(cycleFromRow),
+      goals: withKeys(goals.sort((a, b) => a.created_at.localeCompare(b.created_at) || a.id.localeCompare(b.id)).map((g) => goalFromRows(g, stages))),
+      checkIns: this.all<CheckInRow>('okr_check_ins', ws).map(checkInFromRow),
+      decisions: this.all<DecisionRow>('okr_decisions', ws).map(decisionFromRow),
+      changes: this.all<ChangeRow>('okr_changes', ws).map(changeFromRow).sort((a, b) => a.at.localeCompare(b.at)),
+      watches: this.all<WatchRow>('okr_watches', ws).map(watchFromRow),
+      reviews: this.all<ReviewRow>('okr_reviews', ws).map(reviewFromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt)),
+      retros: this.all<RetroRow>('okr_retros', ws).map(retroFromRow),
+      // okr_feedback_list: the newest 500.
+      feedback: (this.select('okr_feedback', 'workspace_id = ?', [ws], 'at desc limit 500') as unknown as FeedbackRow[]).map(feedbackFromRow),
+      // okr_token_list: never the hash.
+      tokens: this.tokens(ws).map(tokenFromRow),
+      views: this.all<ViewRow>('okr_views', ws).map(viewFromRow),
+      requests: this.all<RequestRow>('okr_requests', ws).map(requestFromRow),
+      ...(modules ? { modules } : {}),
+    });
+    // The window's rules once, as the browser store applies them (ports/window.ts): loaded whole, then trimmed. Fine at
+    // the demo's size; a company-scale store trims in its queries (spec/rebuild/ports-at-scale.md).
+    return window ? windowed(s, window) : s;
+  }
