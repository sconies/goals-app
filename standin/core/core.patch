+export class SqliteStore implements Store {
+  // The Store port names its adapters' kinds; this one reports as the plain-Postgres kind it ports (a kit gap: the
+  // union is closed, so a new platform can't name itself without changing the port).
+  readonly kind = 'postgres' as const;
+  /** Each table's columns and the declared type that says how a value reads back. */
+  private readonly cols = new Map<string, Map<string, string>>();
