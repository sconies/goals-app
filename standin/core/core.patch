+  private columns(table: string): Map<string, string> {
+    let c = this.cols.get(table);
+    if (!c) {
+      const info = this.db.prepare(`pragma table_info(${JSON.stringify(table)})`).all() as { name: string; type: string }[];
+      c = new Map(info.map((i) => [i.name, i.type.toLowerCase()]));
