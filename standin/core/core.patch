@@ -0,0 +1,18 @@
+/* Builds the stand-in platform's server (platform/server.ts) into one file, platform/dist/server.mjs, run with plain
+   Node 22 (drill item 11). The modules come through the module registry as in the app; FARO_WITHOUT leaves them out. */
+import { defineConfig } from 'vite';
+import { faroModules } from './vite.modules.ts';
+
+export default defineConfig({
+  plugins: [faroModules()],
+  ssr: { noExternal: true, target: 'node' },
+  build: {
+    ssr: 'platform/server.ts',
+    outDir: 'platform/dist',
+    emptyOutDir: false,
+    minify: false,
+    target: 'node22',
+    copyPublicDir: false,
+    rolldownOptions: { external: [/^node:/], output: { entryFileNames: 'server.mjs', format: 'es', codeSplitting: false } },
+  },
+});
