+  async workspaces(): Promise<Workspace[]> {
+    const rows = this.select('okr_workspaces', '1', [], 'created_at') as unknown as WorkspaceRow[];
+    return rows.map(workspaceFromRow).filter((w) => w.kind !== 'example' && w.id !== EXAMPLE.id);
