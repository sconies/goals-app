new file mode 100644
index 0000000..7e1cddb
--- /dev/null
+++ b/src/adapters/standin/httpStore.ts
@@ -0,0 +1,40 @@
+/* The browser's goals store on the stand-in platform: every call goes to the server's JSON API (/api/workspaces...)
+   with the session cookie, and the server keeps the records (SqliteStore) and enforces who may change what (guard.ts).
+   A refusal comes back with the server's own words; a stale save comes back as StaleError, so the app reruns it as it
+   does on any store (AX6). Who is viewing is the server's answer too (standinIdentity). */
+import type { Snapshot, Workspace } from '../../domain/types';
+import type { Identity, NoEntry } from '../../ports';
+import { StaleError, type Commit, type HistoryAsk, type HistoryPage, type LoadWindow, type PersonPref, type Store } from '../../ports/store';
+
+async function call<T>(method: string, url: string, body?: unknown): Promise<T> {
+  const r = await fetch(url, { method, credentials: 'same-origin', headers: body === undefined ? {} : { 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
+  const text = await r.text();
+  const data = text ? JSON.parse(text) as { error?: string; stale?: boolean } & T : ({} as T & { error?: string; stale?: boolean });
+  if (r.status === 401) { location.assign('/signin?next=' + encodeURIComponent(location.pathname + location.search)); throw new Error('Signed out.'); }
+  if (!r.ok) throw data.stale ? new StaleError(data.error ?? 'stale') : new Error(data.error ?? `The server said ${r.status}.`);
+  return data;
+}
+const ws = (id: string, rest = '') => `/api/workspaces/${encodeURIComponent(id)}${rest}`;
+
+export class HttpStore implements Store {
+  readonly kind = 'postgres' as const;
+  workspaces() { return call<Workspace[]>('GET', '/api/workspaces'); }
+  load(id: string, window?: LoadWindow) { return call<Snapshot>('GET', ws(id, window ? `?from=${encodeURIComponent(window.from)}` : '')); }
+  history(id: string, ask: HistoryAsk) { return call<HistoryPage>('POST', ws(id, '/history'), ask); }
+  async commit(id: string, c: Commit) { await call('POST', ws(id, '/commit'), c); }
+  async createWorkspace(w: Workspace, data: Snapshot) { await call('POST', '/api/workspaces', { workspace: w, snapshot: data }); }
+  async deleteWorkspace(id: string) { await call('DELETE', ws(id)); }
+  async issueToken(id: string, c: Commit) { return (await call<{ secret: string }>('POST', ws(id, '/tokens'), c)).secret; }
+  personPrefs(id: string) { return call<PersonPref[]>('GET', ws(id, '/prefs')); }
+  async keepPersonPref(id: string, p: PersonPref) { await call('POST', ws(id, '/prefs'), p); }
+}
+
+/** Who is viewing: the server matches the signed-in email to the workspace's people (signIn.ts matchSignIn) and says
+    who, or why no one. No `choose`: who you are is not a choice. Asked each time a workspace opens. */
+export function standinIdentity(): Identity {
+  const ask = (id: string) => call<{ id: string } | NoEntry>('GET', ws(id, '/whoami'));
+  return {
+    async current(id) { const m = await ask(id); return 'id' in m ? m.id : null; },
+    async why(id) { const m = await ask(id); return 'id' in m ? null : m; },
+  };
+}
diff --git a/src/adapters/standin/migrate.ts b/src/adapters/standin/migrate.ts
new file mode 100644
index 0000000..ed4422c
--- /dev/null
+++ b/src/adapters/standin/migrate.ts
@@ -0,0 +1,33 @@
+/* The stand-in platform's schema changes: plain numbered .sql files (platform/migrations), applied in order when the
+   server starts, each once, each in its own transaction, and noted in _migrations. Server-only. */
+import fs from 'node:fs';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+
+/** Opens (or makes) the database file and brings its schema up to date. `:memory:` for a test. */
+export function openDatabase(file: string, migrations: string): DatabaseSync {
+  if (file !== ':memory:') fs.mkdirSync(path.dirname(file), { recursive: true });
+  const db = new DatabaseSync(file);
+  db.exec('pragma journal_mode = wal; pragma busy_timeout = 5000;');
+  migrate(db, migrations);
+  return db;
+}
+
+/** Applies every numbered .sql file in `dir` not applied yet, in order. Returns the names it applied. */
+export function migrate(db: DatabaseSync, dir: string): string[] {
+  db.exec('create table if not exists _migrations (name text primary key, applied_at text not null)');
+  const done = new Set((db.prepare('select name from _migrations').all() as { name: string }[]).map((r) => r.name));
+  const files = fs.readdirSync(dir).filter((f) => /^\d{4}_.*\.sql$/.test(f)).sort();
+  const applied: string[] = [];
+  for (const f of files) {
+    if (done.has(f)) continue;
+    db.exec('begin');
+    try {
+      db.exec(fs.readFileSync(path.join(dir, f), 'utf8'));
+      db.prepare('insert into _migrations (name, applied_at) values (?, ?)').run(f, new Date().toISOString());
+      db.exec('commit');
+    } catch (e) { db.exec('rollback'); throw new Error(`Migration ${f}: ${e instanceof Error ? e.message : String(e)}`); }
+    applied.push(f);
+  }
+  return applied;
+}
diff --git a/src/adapters/standin/sqliteStore.ts b/src/adapters/standin/sqliteStore.ts
new file mode 100644
index 0000000..cf79a7b
--- /dev/null
+++ b/src/adapters/standin/sqliteStore.ts
@@ -0,0 +1,377 @@
+/* The goals store on the stand-in platform's SQLite (node:sqlite, one file): drill item 11. A port of the plain-Postgres
+   adapter (src/adapters/postgres/goalsStore.ts) to a database with no functions, no triggers and no row rules: what the
+   migrations' database functions did (okr_commit and the rest: okr_same_workspace, okr_check_expectations, okr_write,
+   okr_upsert, the goal-key and version triggers, okr_token_create, okr_token_revoke) is done here, in TypeScript, in one
+   SQLite transaction per save. The schema is platform/migrations (translated from spec/core/schema.sql). Rows are read
+   back as JSON rows (booleans, JSON columns parsed), the shape src/data/rows.ts converts for every database store.
+   It passes the same contract as every other store (src/adapters/standin/standin.test.ts). Server-only. */
+import { createHash, randomBytes } from 'node:crypto';
+import type { DatabaseSync, SQLInputValue } from 'node:sqlite';
+import { upgradeAsks } from '../../domain/asks';
+import { withKeys } from '../../domain/goalKey';
+import type { ApiToken, Snapshot, Workspace } from '../../domain/types';
+import { hasModuleRows, type DbRow, type ModuleRecords } from '../../domain/records';
+import {
+  changeFromRow, changeToRow, checkInFromRow, commitPayload, cycleFromRow, decisionFromRow, feedbackFromRow, goalFromRows, loadModules, personFromRow,
+  requestFromRow, retroFromRow, reviewFromRow, teamFromRow, teamToRow, tokenFromRow, viewFromRow, watchFromRow, workspaceFromRow, workspaceToRow,
+  type ChangeRow, type CheckInRow, type CycleRow, type DecisionRow, type FeedbackRow, type GoalRow, type PersonRow, type RequestRow,
+  type RetroRow, type ReviewRow, type StageRow, type TeamRow, type TokenRow, type ViewRow, type WatchRow, type WorkspaceRow,
+} from '../../data/rows';
+import { EXAMPLE, StaleError, type Commit, type Store } from '../../data/store';
+import type { HistoryAsk, HistoryPage, LoadWindow, PersonPref } from '../../ports/store';
+import { historySize, wholeOnly, windowed } from '../../ports/window';
+import { MODULE_RECORDS } from '../../core/records';
+
+type Row = Record<string, unknown>;
+type Payload = ReturnType<typeof commitPayload> & { teams?: Row[]; remove_teams?: string[]; workspace_name?: string; workspace_recording?: boolean; workspace_modules_off?: string[]; modules?: Record<string, Row[]> };
+
+/** A refusal the database functions raised with errcode P0001: said to the person as it is. */
+export class Refused extends Error { constructor(m: string) { super(m); this.name = 'Refused'; } }
