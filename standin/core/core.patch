+  async history(ws: string, ask: HistoryAsk): Promise<HistoryPage> {
+    const size = historySize(ask);
+    const b = ask.before ?? null;
+    const at = b ? new Date(b.at).toISOString() : null;
+    const rows = this.select('okr_changes', `workspace_id = ? and (? is null or at < ? or (at = ? and id < ?)) and (? is null or goal_id = ?)`,
+      [ws, at, at, at, b?.id ?? null, ask.goalId ?? null, ask.goalId ?? null], `at desc, id desc limit ${size + 1}`) as unknown as ChangeRow[];
+    const changes = rows.slice(0, size).map(changeFromRow);
+    const last = changes.at(-1);
+    return { changes, next: rows.length > size && last ? { at: last.at, id: last.id } : null };
+  }
