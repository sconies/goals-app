+  const toks = (await amara('GET', `/api/workspaces/${WS}`)).json.tokens;
+  const amaraTok = toks.find((x) => x.id === 'tok_amaraai');
+  const spare = toks.find((x) => x.id === 'tok_rheaspare');
+  const now = () => new Date().toISOString();
+  const chg = (id, entityId, summary) => ({ id, at: now(), actorId: 'rhea', goalId: null, entity: 'person', entityId, action: 'edited', summary, diffs: [] });
+  const forged = [
+    ['forges a new token through a save', { tokens: [{ id: 'tok_forged', personId: 'rhea', name: 'Forged', createdBy: 'rhea', createdAt: now(), lastUsedAt: null, revokedAt: null }], changes: [chg('chg_f1', 'rhea', 'Forged')] }, /Only admins can make tokens/],
+    ['revokes someone else’s token', { tokens: [{ ...amaraTok, revokedAt: now() }], changes: [chg('chg_f2', 'amara', 'Revoked')] }, /Only an admin or the token’s person can revoke it/],
+    ['renames their own token', { tokens: [{ ...spare, name: 'Renamed' }], changes: [chg('chg_f3', 'rhea', 'Renamed')] }, /can only be revoked, not changed/],
+    ['hands their own token to someone else', { tokens: [{ ...spare, personId: 'amara', revokedAt: now() }], changes: [chg('chg_f4', 'rhea', 'Moved')] }, /can only be revoked, not changed/],
+  ];
+  for (const [what, commit, words] of forged) {
