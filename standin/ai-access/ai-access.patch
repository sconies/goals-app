+    check(`R1 tokens: a member who ${what}: refused by the server`, r.status === 403 && words.test(r.json?.error ?? ''), `${r.status} ${r.json?.error}`);
+  }
+  r = await rhea('POST', `/api/workspaces/${WS}/commit`, { tokens: [{ ...spare, revokedAt: now() }], changes: [{ ...chg('chg_f5', 'rhea', 'Revoked the MCP token “Spare”'), diffs: [{ field: 'MCP token', from: 'Spare', to: 'Revoked' }] }] });
+  check('R1 tokens: a member revokes their own token: allowed', r.status === 200, r.json?.error);
+  r = await rhea('POST', `/api/workspaces/${WS}/commit`, { tokens: [{ ...spare, revokedAt: null }], changes: [chg('chg_f6', 'rhea', 'Unrevoked')] });
+  check('R1 tokens: a revoked token can’t be brought back by a save', r.status === 403, `${r.status} ${r.json?.error}`);
+
+  // ---------- Switching off, as an AI tool (criterion 7) ----------
+  r = await mcp(amaraSecret, 'tools/call', { name: 'set_feature', arguments: { feature: 'ai-access', on: false } });
+  check('7: set_feature switching AI access off answers the last words', said(r) === `AI access is off in ${WSNAME}. This connection stops working now. An admin switches it back on in Faro.`, said(r));
+
+  // ---------- Off: the door (criterion 3) ----------
+  await new Promise((res) => setTimeout(res, 20));
+  r = await mcp(rheaSecret, 'tools/call', { name: 'find_goals', arguments: { text: 'G-1' } });
+  const callSaid = said(r);
+  const init = await mcp(rheaSecret, 'initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'proof', version: '1' } });
+  const list = await mcp(rheaSecret, 'tools/list');
+  const ping = await mcp(rheaSecret, 'ping');
+  check('3: off, a tool call is answered with the switched-off sentence', callSaid.includes(SHUT), callSaid);
+  check('3: off, initialize and tools/list still answer (the tools still listed)', !!init.json?.result && (list.json?.result?.tools?.length ?? 0) > 0, `${list.json?.result?.tools?.length} tools`);
+  check('3: off, any other request (ping) gets the sentence too', said(ping).includes(SHUT), said(ping));
+  check('3: off, the token’s lastUsedAt does not move', lastUsed('tok_rheaai') === usedBefore, `${usedBefore} → ${lastUsed('tok_rheaai')}`);
+  d = db(); const kept = d.prepare("select count(*) n from okr_api_tokens where workspace_id = ? and revoked_at is null").get(WS).n; const offRow = d.prepare('select modules_off from okr_workspaces where id = ?').get(WS).modules_off; d.close();
+  check('off: kept in SQLite (modules_off), tokens kept, not revoked', /ai-access/.test(offRow) && kept === 3, `${offRow}, ${kept} live tokens`);
+
+  // ---------- Off: making refused, revoking runs (criteria 4 and 8) ----------
+  r = await amara('POST', `/api/workspaces/${WS}/tokens`, token('tok_off', 'rhea', 'While off', 'amara'));
+  check('4/8: off, making a token is refused by the server with “AI access is off in {workspace}.”', r.status === 403 && r.json?.error === `AI access is off in ${WSNAME}.`, `${r.status} ${r.json?.error}`);
+  const at = new Date().toISOString();
+  const tariqRow = (await amara('GET', `/api/workspaces/${WS}`)).json.tokens.find((t) => t.personId === 'tariq');
+  r = await amara('POST', `/api/workspaces/${WS}/commit`, { tokens: [{ ...tariqRow, revokedAt: at }], changes: [{ id: 'chg_revokeoff', at, actorId: 'amara', goalId: null, entity: 'person', entityId: 'tariq', action: 'edited', summary: `Revoked the MCP token “${tariqRow.name}”`, diffs: [{ field: 'MCP token', from: tariqRow.name, to: 'Revoked' }] }] });
+  d = db(); const rev = d.prepare("select revoked_at from okr_api_tokens where person_id = 'tariq'").get(); d.close();
