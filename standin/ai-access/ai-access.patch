+  const usedBefore = lastUsed('tok_rheaai');
+  check('on: a token’s use is recorded (lastUsedAt)', !!usedBefore, usedBefore);
+
+  // ---------- R1 for the module's record (tokens) through /commit, as a member without the right ----------
