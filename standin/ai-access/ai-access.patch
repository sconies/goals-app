+  r = await mcp(amaraSecret, 'tools/call', { name: 'create_token', arguments: { person: 'tariq', name: 'Tariq’s assistant' } });
+  const tariqSecret = /gk_[A-Za-z0-9]+/.exec(said(r))?.[0];
+  d = db(); const via = d.prepare("select summary, diffs from okr_changes where actor_id = 'amara' and summary like 'Gave Tariq%'").get(); d.close();
+  check('MCP-TOKENS: an admin’s token makes one via MCP, logged as theirs “via MCP”', !!tariqSecret && /MCP/.test(String(via?.diffs)), `${said(r).slice(0, 60)} | ${via?.diffs}`);
+  r = await mcp(rheaSecret, 'tools/call', { name: 'list_tokens', arguments: {} });
