+/* Stage 4 (AI access) on the stand-in platform: its exit criteria, checked on the running server, with the module on,
+   switched off, and back on, through the API, /mcp and the app's screens. With `--without` it checks a build that left
+   the module out (STANDIN_WITHOUT=…,ai-access npm run build:standin): no token made, no token tools, the core's still
+   answering. Usage: node platform/prove-ai.mjs [port] [--without]. One line per check and a tally. */
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { chromium } from 'playwright';
+
+const WITHOUT = process.argv.includes('--without');
+const PORT = Number(process.argv.find((a) => /^\d+$/.test(a)) || 47410);
+const B = `http://localhost:${PORT}`;
+const DATA = fs.mkdtempSync(path.join(os.tmpdir(), 'faro-standin-ai-'));
+const ENV = { ...process.env, STANDIN_PORT: String(PORT), STANDIN_DATA: DATA, NODE_NO_WARNINGS: '1' };
+const PASSWORD = 'faro-standin';
+const WS = 'ws_platform';
+const WSNAME = 'Platform Engineering';
+const SHUT = `AI access is switched off in ${WSNAME}. An admin can switch it on in Faro, under Workspace, Features.`;
+const results = [];
+const check = (name, ok, detail = '') => { results.push({ name, ok: !!ok, detail }); console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ' — ' + detail : ''}`); };
+
+function run(args) { return new Promise((res, rej) => { const p = spawn(process.execPath, ['platform/dist/server.mjs', ...args], { env: ENV, stdio: 'inherit' }); p.on('exit', (c) => (c ? rej(new Error('exit ' + c)) : res())); }); }
+async function start() {
+  const p = spawn(process.execPath, ['platform/dist/server.mjs'], { env: ENV, stdio: ['ignore', 'pipe', 'inherit'] });
+  await new Promise((res) => p.stdout.on('data', (d) => { if (/stand-in platform/.test(String(d))) res(); }));
+  return p;
+}
+const stop = (p) => new Promise((res) => { p.on('exit', res); p.kill(); });
+function client() {
+  let cookie = '';
+  const c = async (method, url, body, headers = {}) => {
+    const r = await fetch(B + url, { method, redirect: 'manual', headers: { ...(cookie ? { cookie } : {}), ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}), ...headers }, body: body === undefined ? undefined : JSON.stringify(body) });
+    const set = r.headers.get('set-cookie'); if (set) cookie = set.split(';')[0];
+    const text = await r.text(); let json = null; try { json = JSON.parse(text); } catch { /* html */ }
+    return { status: r.status, json, text };
+  };
+  c.signIn = (email) => c('POST', '/api/signin', { email, password: PASSWORD });
+  return c;
+}
+let n = 0;
+const token = (id, personId, name, createdBy) => ({ tokens: [{ id, personId, name, createdBy, createdAt: new Date(Date.now() + ++n).toISOString(), lastUsedAt: null, revokedAt: null }], changes: [] });
+const anon = client();
+const mcp = async (secret, method, params = {}) => (await anon('POST', '/mcp', { jsonrpc: '2.0', id: ++n, method, params }, { Authorization: `Bearer ${secret}`, Accept: 'application/json, text/event-stream' }));
+const said = (r) => String(r.json?.result?.content?.[0]?.text ?? r.json?.error?.message ?? r.json?.error ?? r.text).slice(0, 200);
+const db = () => new DatabaseSync(path.join(DATA, 'faro.db'));
+const lastUsed = (id) => { const d = db(); const v = d.prepare('select last_used_at from okr_api_tokens where id = ?').get(id)?.last_used_at ?? null; d.close(); return v; };
+
+await run(['seed', PASSWORD]);
+const server = await start();
+const browser = await chromium.launch();
+try {
+  const amara = client(); await amara.signIn('amara.nwosu@example.com');
+  const rhea = client(); await rhea.signIn('rhea.kapoor@example.com');
+
+  if (WITHOUT) {
