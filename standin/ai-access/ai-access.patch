+  r = await mcp(rheaSecret, 'tools/list');
+  const tools = r.json?.result?.tools?.map((t) => t.name) ?? [];
+  check('on: /mcp lists AI access’s tools (list_tokens, create_token, revoke_token)', ['list_tokens', 'create_token', 'revoke_token'].every((t) => tools.includes(t)), `${tools.length} tools`);
+  r = await mcp(rheaSecret, 'tools/call', { name: 'create_token', arguments: { person: 'rhea', name: 'Another' } });
