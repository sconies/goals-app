+/* The browser's side of the builders' inbox on the stand-in platform (Feedback, stage 5): the same shape as Faro's
+   database side that src/markup/backend.ts picks, over the server's /api/inbox/ with the session cookie. The server
+   keeps the markups, their pictures (on its files API) and every status, and reruns the one status rule as the person
+   signed in, so an admin's check made here is only a courtesy. `ws` is the workspace the inbox is opened from: the
+   server reads whether Feedback is on there, and whether the person is its admin. */
+import type { Pictures } from '../../markup/ink';
+import type { FeedbackStore, InboxFeedback, Triage } from '../../markup/feedback';
+import { MarkupError, type Markup, type Raised } from '../../markup/model';
+import { base64, type MarkupStore } from '../../markup/ops';
+
+async function call<T>(method: string, url: string, body?: unknown): Promise<T> {
+  const r = await fetch(url, { method, credentials: 'same-origin', headers: body === undefined ? {} : { 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
+  const text = await r.text();
+  const data = (text ? JSON.parse(text) : null) as (T & { error?: string }) | null;
+  if (r.status === 404 && data && 'missing' in (data as object)) return null as T;
+  if (!r.ok) throw new MarkupError(data?.error ?? `The server said ${r.status}.`);
+  return data as T;
+}
+const q = (o: Record<string, string | number | undefined>) => '?' + new URLSearchParams(Object.entries(o).filter(([, v]) => v !== undefined && v !== '').map(([k, v]) => [k, String(v)])).toString();
+
+export function standinMarkups() {
+  return {
+    newId: async () => (await call<{ id: string }>('POST', '/api/inbox/markup-id')).id,
+    /** The markup and its pictures in one request: the server keeps the pictures first, then the markup. */
+    async send(m: Markup, pictures: Pictures): Promise<void> {
+      const pics: Record<string, string> = {};
+      for (const name of m.pictures) pics[name] = base64(new Uint8Array(await (pictures[name as keyof Pictures] as Blob).arrayBuffer()));
+      await call('POST', '/api/inbox/markups' + q({ ws: m.workspaceId }), { markup: m, pictures: pics });
+    },
+    raised: (ws: string, _person: string) => call<Raised[]>('GET', '/api/inbox/raised' + q({ ws })).catch(() => [] as Raised[]),
+    inbox(ws = ''): MarkupStore {
+      return {
+        list: (o) => call<Markup[]>('GET', '/api/inbox/markups' + q({ ws, status: o.status, limit: o.limit, workspace: o.workspaceId })),
+        get: (id) => call<Markup | null>('GET', `/api/inbox/markups/${encodeURIComponent(id)}` + q({ ws })),
+        update: (id, patch) => call<Markup | null>('POST', `/api/inbox/markups/${encodeURIComponent(id)}/triage` + q({ ws }), patch),
+        pictureUrl: async (id, name) => `/api/inbox/markups/${encodeURIComponent(id)}/pictures/${name}` + q({ ws }),
+      };
+    },
+    feedback(ws = ''): FeedbackStore {
+      return {
+        list: (limit, o = {}) => call<InboxFeedback[]>('GET', '/api/inbox/feedback' + q({ ws, limit, status: o.status, workspace: o.workspaceId })),
+        get: (id) => call<InboxFeedback | null>('GET', `/api/inbox/feedback/${encodeURIComponent(id)}` + q({ ws })),
+        update: (id, t) => call<Triage | null>('POST', `/api/inbox/feedback/${encodeURIComponent(id)}/triage` + q({ ws }), t),
+      };
+    },
+  };
+}
