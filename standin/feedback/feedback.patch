+/* The Feedback module's store on the stand-in platform (stage 5): the builders' inbox, outside any workspace, in SQLite
+   (platform/migrations/0003_feedback.sql) with markups' pictures on the platform's files API (markups/<id>/<name>).
+   - markups: a MarkupStore (src/markup/ops.ts) for markupOps, the same rules the inbox and the AI tools run;
+   - feedback: a FeedbackStore (src/markup/feedback.ts) over the core's okr_feedback, every workspace's, with names;
+   - add: a markup is only ever added, untriaged, under an id this store issued, its pictures first;
+   - raised: which of a person's markups and feedback were fixed where ("You raised this");
+   - every triage change is kept in inbox_triage_log.
+   Who may do what (anyone reads and sends; only an admin triages) is the server's, through markupOps and feedbackOps
+   with the actor it knows (platform/server.ts, deps.ts). Server-only. */
+import crypto from 'node:crypto';
+import type { DatabaseSync } from 'node:sqlite';
+import type { Files } from '../../ports';
+import type { FeedbackStore, InboxFeedback, Triage } from '../../markup/feedback';
+import { feedbackFromInboxRow, matches, triageFromRow, type FeedbackInboxRow } from '../../markup/feedback';
+import { LINE_MAX, MarkupError, markupFromRow, markupToRow, type Markup, type MarkupRow, type MarkupStatus, type Raised } from '../../markup/model';
+import { PICTURE_FILES, type MarkupStore } from '../../markup/ops';
+
+type Row = Record<string, unknown>;
+const JSON_COLS = ['parts', 'strokes', 'context', 'steps', 'errors', 'pictures'];
+const COLUMN: Record<string, string> = { status: 'status', fixedIn: 'fixed_in', wontFixReason: 'wont_fix_reason', statusBy: 'status_by', statusAt: 'status_at', issueUrl: 'issue_url' };
+
+const fromRow = (r: Row): Markup => markupFromRow(Object.fromEntries(Object.entries(r).map(([k, v]) => [k, JSON_COLS.includes(k) && typeof v === 'string' ? JSON.parse(v) : k === 'demo' ? !!v : v])) as unknown as MarkupRow);
+
+/** The picture's address on this server (signed-in people only; never a public folder). */
+export const pictureAddress = (id: string, name: string) => `/api/inbox/markups/${id}/pictures/${name}`;
+
+export function standinInbox(db: DatabaseSync, files: Files, now: () => Date = () => new Date()) {
+  const log = (kind: 'markup' | 'feedback', id: string, r: Row) =>
+    db.prepare('insert into inbox_triage_log (kind, item_id, status, fixed_in, wont_fix_reason, issue_url, status_by, at) values (?, ?, ?, ?, ?, ?, ?, ?)')
+      .run(kind, id, String(r.status ?? 'new'), (r.fixed_in as string) ?? null, (r.wont_fix_reason as string) ?? null, (r.issue_url as string) ?? null, (r.status_by as string) ?? null, now().toISOString());
+
+  const markups: MarkupStore = {
+    async list(o) {
+      const where: string[] = []; const args: (string | number)[] = [];
+      if (o.workspaceId) { where.push('workspace_id = ? and demo = 0'); args.push(o.workspaceId); }
+      if (o.status) { where.push('status = ?'); args.push(o.status); }
+      const rows = db.prepare(`select * from okr_markups ${where.length ? 'where ' + where.join(' and ') : ''} order by created_at desc, id desc limit ?`).all(...args, o.limit) as Row[];
+      return rows.map(fromRow);
+    },
+    async get(id) { const r = db.prepare('select * from okr_markups where id = ?').get(id) as Row | undefined; return r ? fromRow(r) : null; },
+    async update(id, patch) {
+      const sets = Object.entries(patch).filter(([k]) => COLUMN[k]).map(([k, v]) => [COLUMN[k]!, v ?? null] as const);
+      if (!sets.length) return this.get(id);
+      const r = db.prepare(`update okr_markups set ${sets.map(([c]) => `${c} = ?`).join(', ')} where id = ?`).run(...sets.map(([, v]) => v as string | null), id);
+      if (!r.changes) return null;
+      const m = db.prepare('select * from okr_markups where id = ?').get(id) as Row;
+      log('markup', id, m);
+      return fromRow(m);
+    },
+    async pictureUrl(id, name) { return PICTURE_FILES.includes(name) ? pictureAddress(id, name) : null; },
+    async pictureBytes(id, name) { return PICTURE_FILES.includes(name) ? files.bytes(`markups/${id}/${name}`) : null; },
+  };
+
+  const FEEDBACK_SELECT = `select f.*, coalesce(w.name, '') as workspace_name, coalesce(p.name, '') as person_name from okr_feedback f
+    left join okr_workspaces w on w.id = f.workspace_id left join okr_people p on p.id = f.person_id and p.workspace_id = f.workspace_id`;
