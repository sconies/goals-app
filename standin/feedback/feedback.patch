diff --git a/platform/migrations/0003_feedback.sql b/platform/migrations/0003_feedback.sql
new file mode 100644
index 0000000..947c898
--- /dev/null
+++ b/platform/migrations/0003_feedback.sql
@@ -0,0 +1,55 @@
+-- Generated by platform/translate-schema.mjs from spec/core/schema.sql: the Feedback module's store (the builders'
+-- inbox), for SQLite on the stand-in platform. Same translation as 0001; the CHECK constraints are the server's
+-- (src/adapters/standin/inbox.ts, and markupOps' statusPatch for every status change).
+
+create table if not exists okr_markup_ids (
+  id text not null,
+  issued_at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  primary key (id)
+);
+
+create table if not exists okr_markups (
+  id text not null,
+  workspace_id text not null,
+  workspace_name text not null default '',
+  demo boolean not null default 0,
+  person_id text not null default '',
+  person_name text not null default '',
+  line text not null,
+  mood text,
+  route text not null default '',
+  path text not null default '',
+  goal_id text,
+  review_id text,
+  parts jsontext not null default '[]',
+  strokes jsontext not null default '[]',
+  context jsontext not null default '{}',
+  steps jsontext not null default '[]',
+  errors jsontext not null default '[]',
+  pictures textarray not null default '[]',
+  status text not null default 'new',
+  issue_url text,
+  fixed_in text,
+  wont_fix_reason text,
+  status_by text,
+  status_at timestamptext,
+  created_at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  primary key (id)
+);
+
+create index if not exists okr_markups_newest on okr_markups (created_at desc, id desc);
+create index if not exists okr_markups_person on okr_markups (workspace_id, person_id);
+
+-- Every triage change kept (stage 5's entry criteria): which item, what it became, who and when.
+create table if not exists inbox_triage_log (
+  seq integer primary key autoincrement,
+  kind text not null,
+  item_id text not null,
+  status text not null,
+  fixed_in text,
+  wont_fix_reason text,
+  issue_url text,
+  status_by text,
+  at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
+);
+create index if not exists inbox_triage_log_item on inbox_triage_log (item_id, seq);
diff --git a/platform/prove-feedback.mjs b/platform/prove-feedback.mjs
new file mode 100644
index 0000000..fe36e8c
--- /dev/null
+++ b/platform/prove-feedback.mjs
@@ -0,0 +1,167 @@
+/* The Feedback module on the stand-in platform (stage 5, drill item 11): its exit criteria and the server's refusals,
+   against the running server, called directly (not through the app). Starts the built server on a fresh data folder,
+   seeds it, and checks: sending feedback and markups (as the person signed in, only added, untriaged, under an issued
+   id, pictures on the files API), triage by admins only (each refusal as a member without the right), every change
+   kept and undoable, "You raised this", the eight AI tools, and Feedback switched off and on again.
+   Usage: npm run build:standin && node platform/prove-feedback.mjs [port]. */
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const PORT = Number(process.argv[2] || 47510);
+const B = `http://localhost:${PORT}`;
+const DATA = fs.mkdtempSync(path.join(os.tmpdir(), 'faro-standin-fb-'));
+const ENV = { ...process.env, STANDIN_PORT: String(PORT), STANDIN_DATA: DATA, NODE_NO_WARNINGS: '1' };
+const PASSWORD = 'faro-standin';
+const WS = 'ws_platform';
+const ENTRY = 'fields-import-undo';
+const results = [];
+const check = (name, ok, detail = '') => { results.push({ name, ok: !!ok, detail }); console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ' — ' + detail : ''}`); };
+
+function run(args) { return new Promise((res, rej) => { const p = spawn(process.execPath, ['platform/dist/server.mjs', ...args], { env: ENV, stdio: 'inherit' }); p.on('exit', (c) => (c ? rej(new Error('exit ' + c)) : res())); }); }
+async function start() {
+  const p = spawn(process.execPath, ['platform/dist/server.mjs'], { env: ENV, stdio: ['ignore', 'pipe', 'inherit'] });
+  await new Promise((res) => p.stdout.on('data', (d) => { if (/stand-in platform/.test(String(d))) res(); }));
+  return p;
+}
+const stop = (p) => new Promise((res) => { p.on('exit', res); p.kill(); });
+function client() {
+  let cookie = '';
+  const c = async (method, url, body, headers = {}) => {
+    const r = await fetch(B + url, { method, redirect: 'manual', headers: { ...(cookie ? { cookie } : {}), ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}), ...headers }, body: body === undefined ? undefined : JSON.stringify(body) });
+    const set = r.headers.get('set-cookie'); if (set) cookie = set.split(';')[0];
+    const buf = Buffer.from(await r.arrayBuffer()); const text = buf.toString('utf8'); let json = null; try { json = JSON.parse(text); } catch { /* bytes */ }
+    return { status: r.status, json, text, buf, type: r.headers.get('content-type') };
+  };
+  c.signIn = (email) => c('POST', '/api/signin', { email, password: PASSWORD });
+  return c;
+}
+let n = 0;
+const now = () => new Date().toISOString();
+const fbRow = (personId, text, o = {}) => ({ id: `fb_proof${++n}`, personId, mood: 'bad', text, path: '/goals', at: now(), ...o });
+const PNG = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==', 'base64');
+const markup = (id, line) => ({ id, workspaceId: 'ws_elsewhere', workspaceName: 'Forged', demo: true, personId: 'amara', personName: 'Not me', line, mood: 'meh', route: '/goals', path: '/goals', goalId: null, reviewId: null, parts: [[['Goals', 'List']]], strokes: [{ kind: 'note', at: [10, 10], text: 'Here' }], context: { viewport: { w: 390, h: 844, dpr: 2 }, theme: 'light', themeChoice: 'system', accent: 'blue', appVersion: ENTRY, sessionId: 's', userAgent: 'proof', host: 'localhost' }, steps: [], errors: [], pictures: ['screen.png', 'marked.jpg'], status: 'fixed', issueUrl: null, fixedIn: ENTRY, wontFixReason: null, statusBy: 'Forger', statusAt: now(), createdAt: now() });
+const pics = { 'screen.png': PNG.toString('base64'), 'marked.jpg': PNG.toString('base64') };
+const q = `?ws=${WS}`;
+
+await run(['seed', PASSWORD]);
+let server = await start();
+try {
+  const rhea = client(); await rhea.signIn('rhea.kapoor@example.com');   // a member, not an admin
+  const amara = client(); await amara.signIn('amara.nwosu@example.com'); // an admin
+  const anon = client();
+
+  // ---------- Sending feedback (the core's okr_feedback, Feedback's action) ----------
+  const mine = fbRow('rhea', 'The goals list is slow on my phone', { status: 'fixed', fixedIn: ENTRY });
+  let r = await rhea('POST', `/api/workspaces/${WS}/commit`, { feedback: [mine], changes: [] });
+  check('a member sends feedback (anyone may: R1 access table)', r.status === 200, r.json?.error);
+  r = await amara('GET', `/api/inbox/feedback/${mine.id}${q}`);
+  check('feedback always arrives New, whatever the save carried', r.json?.status === 'new' && r.json?.fixedIn === null && r.json?.personName === 'Rhea Kapoor' && r.json?.workspaceName === 'Platform Engineering', JSON.stringify(r.json).slice(0, 160));
+  r = await rhea('POST', `/api/workspaces/${WS}/commit`, { feedback: [fbRow('amara', 'Sent as Amara')], changes: [] });
+  check('refused: a member sends feedback as someone else', r.status === 403 && /as the person signed in/.test(r.json?.error ?? ''), r.json?.error);
+  r = await rhea('POST', `/api/workspaces/${WS}/commit`, { feedback: [{ ...mine, text: 'Rewritten' }], changes: [] });
+  check('refused: a member rewrites feedback already sent', r.status === 403 && /only ever added/.test(r.json?.error ?? ''), r.json?.error);
+  r = await anon('GET', `/api/inbox/feedback${q}`);
+  check('refused: the inbox signed out', r.status === 401);
+
+  // ---------- Sending a markup ----------
+  r = await rhea('POST', '/api/inbox/markups' + q, { markup: markup('mk_' + 'a'.repeat(16), 'Forged id'), pictures: pics });
+  check('refused: a markup under an id the inbox didn’t issue', r.status === 403 && /an id the inbox gave it/.test(r.json?.error ?? ''), r.json?.error);
+  const mkId = (await rhea('POST', '/api/inbox/markup-id')).json?.id;
+  r = await rhea('POST', '/api/inbox/markups' + q, { markup: markup(mkId, 'The filter line wraps badly'), pictures: pics });
+  check('a member sends a markup under an issued id, its pictures first', r.status === 200 && /^mk_[0-9a-f]{16}$/.test(mkId ?? ''), r.json?.error);
+  r = await rhea('POST', '/api/inbox/markups' + q, { markup: markup(mkId, 'Again'), pictures: pics });
+  check('refused: the same markup id twice', r.status === 403 && /sent already/.test(r.json?.error ?? ''), r.json?.error);
+  r = await rhea('GET', `/api/inbox/markups/${mkId}${q}`);
+  check('who sent it, from where and its status are the server’s, not the request’s', r.json?.personId === 'rhea' && r.json?.workspaceId === WS && r.json?.demo === false && r.json?.status === 'new' && r.json?.fixedIn === null, JSON.stringify({ p: r.json?.personId, w: r.json?.workspaceId, d: r.json?.demo, s: r.json?.status }));
+  r = await rhea('GET', `/api/inbox/markups/${mkId}/pictures/screen.png${q}`);
+  check('its picture comes back from the files API, signed in', r.status === 200 && r.buf.equals(PNG) && r.type === 'image/png');
+  check('the picture is in the platform’s files folder', fs.existsSync(path.join(DATA, 'files', 'markups', mkId, 'screen.png')));
+  r = await anon('GET', `/api/inbox/markups/${mkId}/pictures/screen.png${q}`);
+  check('refused: a picture signed out', r.status === 401);
+
+  // ---------- Triage: admins only, as the person signed in (INBOX-TRIAGE, R1 access table) ----------
+  r = await rhea('POST', `/api/inbox/markups/${mkId}/triage${q}`, { status: 'in-hand', statusBy: 'Amara Nwosu' });
+  check('refused: a member marks a markup in hand', r.status === 403 && /Only an admin/.test(r.json?.error ?? ''), r.json?.error);
+  r = await rhea('POST', `/api/inbox/markups/${mkId}/triage${q}`, { issueUrl: 'https://github.com/o/r/issues/1' });
+  check('refused: a member keeps an issue’s address', r.status === 403 && /Only an admin/.test(r.json?.error ?? ''), r.json?.error);
+  r = await rhea('POST', `/api/inbox/feedback/${mine.id}/triage${q}`, { status: 'wont-fix', wontFixReason: 'No' });
+  check('refused: a member changes feedback’s status', r.status === 403 && /Only an admin/.test(r.json?.error ?? ''), r.json?.error);
+  r = await amara('POST', `/api/inbox/markups/${mkId}/triage${q}`, { status: 'in-hand', statusBy: 'Someone Else' });
+  check('an admin marks it in hand, recorded as the admin signed in', r.status === 200 && r.json?.status === 'in-hand' && r.json?.statusBy === 'Amara Nwosu', JSON.stringify({ s: r.json?.status, by: r.json?.statusBy, e: r.json?.error }));
+  r = await amara('POST', `/api/inbox/markups/${mkId}/triage${q}`, { status: 'new' });
+  check('Undo: back to New through the same rule', r.json?.status === 'new');
+  r = await amara('POST', `/api/inbox/markups/${mkId}/triage${q}`, { issueUrl: 'https://github.com/o/r/issues/7?x=1' });
+  check('an admin keeps the issue’s address (query dropped)', r.json?.issueUrl === 'https://github.com/o/r/issues/7', r.json?.issueUrl ?? r.json?.error);
+  r = await amara('POST', `/api/inbox/markups/${mkId}/triage${q}`, { status: 'fixed', fixedIn: 'no-such-entry' });
+  check('refused: fixed in a What’s new entry that isn’t there', r.status === 403 && /no What’s new entry/.test(r.json?.error ?? ''), r.json?.error);
+  r = await amara('POST', `/api/inbox/markups/${mkId}/triage${q}`, { status: 'fixed', fixedIn: ENTRY });
+  check('an admin marks it fixed in a What’s new entry', r.json?.status === 'fixed' && r.json?.fixedIn === ENTRY);
+  r = await amara('POST', `/api/inbox/feedback/${mine.id}/triage${q}`, { status: 'in-hand' });
+  check('an admin marks feedback in hand', r.json?.status === 'in-hand' && r.json?.statusBy === 'Amara Nwosu', JSON.stringify(r.json));
+  r = await amara('GET', `/api/inbox/markups/${mkId}/history${q}`);
+  check('every triage change is kept', r.json?.map((x) => x.status).join(',') === 'in-hand,new,new,fixed', r.json?.map((x) => x.status).join(','));
+  r = await rhea('GET', `/api/inbox/raised${q}`);
+  check('“You raised this”: the sender’s markups and feedback, with where each was fixed', r.json?.some((x) => x.id === mkId && x.fixedIn === ENTRY) && r.json?.some((x) => x.id === mine.id && x.kind === 'feedback'), JSON.stringify(r.json));
+  r = await rhea('GET', `/api/inbox/markups${q}&status=fixed`);
+  check('anyone reads the inbox, filtered by status', r.status === 200 && r.json?.some((x) => x.id === mkId));
+
+  // ---------- The AI tools ----------
+  const tok = async (who, c) => (await c('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: `tok_fb${who}`, personId: who, name: 'Proof', createdBy: 'amara', createdAt: now(), lastUsedAt: null, revokedAt: null }], changes: [] })).json?.secret;
+  const rheaTok = await tok('rhea', amara), amaraTok = await tok('amara', amara);
+  const mcp = async (method, params, token) => (await anon('POST', '/mcp', { jsonrpc: '2.0', id: ++n, method, params }, { Authorization: `Bearer ${token}`, Accept: 'application/json, text/event-stream' })).json;
+  const call = (name, args, token = rheaTok) => mcp('tools/call', { name, arguments: args }, token);
+  const text = (x) => JSON.stringify(x?.result?.content ?? x?.error ?? x);
+  const EIGHT = ['list_markups', 'get_markup', 'review_inbox', 'update_markup', 'list_feedback', 'get_feedback', 'update_feedback', 'send_feedback'];
+  r = await mcp('tools/list', {}, rheaTok);
+  const names = (r?.result?.tools ?? []).map((t) => t.name);
+  check('/mcp lists Feedback’s eight tools', EIGHT.every((t) => names.includes(t)), `${names.length} tools`);
+  r = await call('list_markups', {});
+  check('list_markups (any token)', !r?.result?.isError && text(r).includes(mkId), text(r).slice(0, 120));
+  r = await call('get_markup', { id: mkId });
+  check('get_markup gives the picture as MCP image content', (r?.result?.content ?? []).some((c) => c.type === 'image' && c.mimeType === 'image/jpeg' && c.data === PNG.toString('base64')), (r?.result?.content ?? []).map((c) => c.type).join(','));
+  r = await call('review_inbox', { status: 'fixed' });
+  check('review_inbox', !r?.result?.isError && text(r).includes(mkId), text(r).slice(0, 120));
+  r = await call('update_markup', { id: mkId, status: 'in-hand' });
+  check('update_markup with a member’s token: refused', r?.result?.isError && /Only an admin/.test(text(r)), text(r).slice(0, 120));
+  r = await call('list_feedback', {});
+  check('list_feedback: every workspace’s, with statuses', !r?.result?.isError && text(r).includes(mine.id) && text(r).includes('in-hand'), text(r).slice(0, 120));
+  r = await call('get_feedback', { id: mine.id });
+  check('get_feedback', !r?.result?.isError && text(r).includes('slow on my phone'));
+  r = await call('update_feedback', { id: mine.id, status: 'fixed', fixed_in: ENTRY });
+  check('update_feedback with a member’s token: refused', r?.result?.isError && /Only an admin/.test(text(r)), text(r).slice(0, 120));
+  r = await call('update_feedback', { id: mine.id, status: 'fixed', fixed_in: ENTRY }, amaraTok);
+  check('update_feedback with an admin’s token, recorded via the assistant', !r?.result?.isError && (await amara('GET', `/api/inbox/feedback/${mine.id}${q}`)).json?.statusBy === 'Amara Nwosu via MCP', text(r).slice(0, 120));
+  r = await call('send_feedback', { mood: 'good', text: 'Sent by my assistant' });
+  check('send_feedback', r?.result && !r.result.isError, text(r).slice(0, 120));
+
+  // ---------- Switched off, then on again (exit criteria 4 and 5) ----------
+  const before = (await amara('GET', `/api/inbox/feedback${q}`)).json?.length;
+  r = await rhea('POST', `/api/workspaces/${WS}/commit`, { modulesOff: ['feedback'], changes: [{ id: 'chg_fboff_r', at: now(), actorId: 'rhea', goalId: null, entity: 'workspace', entityId: WS, action: 'edited', summary: 'Off', diffs: [] }] });
+  check('refused: a member switches Feedback off', r.status === 403 && /Only admins can switch features/.test(r.json?.error ?? ''));
+  r = await amara('POST', `/api/workspaces/${WS}/commit`, { modulesOff: ['feedback'], changes: [{ id: 'chg_fboff', at: now(), actorId: 'amara', goalId: null, entity: 'workspace', entityId: WS, action: 'edited', summary: 'Switched Feedback off', diffs: [] }] });
+  check('an admin switches Feedback off', r.status === 200, r.json?.error);
+  r = await rhea('POST', `/api/workspaces/${WS}/commit`, { feedback: [fbRow('rhea', 'While off')], changes: [] });
+  check('off: sending feedback refuses “Feedback is off in {workspace}.”', r.status === 403 && r.json?.error === 'Feedback is off in Platform Engineering.', r.json?.error);
+  const OFF = 'Feedback is switched off in Platform Engineering. An admin can switch it on in Workspace, Features.';
+  const doors = await Promise.all([rhea('GET', `/api/inbox/markups${q}`), rhea('GET', `/api/inbox/feedback${q}`), rhea('POST', '/api/inbox/markups' + q, { markup: markup((await rhea('POST', '/api/inbox/markup-id')).json.id, 'Off'), pictures: pics })]);
+  check('off: the inbox’s doors answer with the page’s sentence (reads and a markup sent)', doors.every((d) => d.status === 404 && d.json?.error === OFF), doors.map((d) => d.status + ' ' + d.json?.error).join(' | '));
+  const offAnswers = await Promise.all(EIGHT.map((t) => call(t, t === 'send_feedback' ? { mood: 'good', text: 'x' } : t.startsWith('get_') || t.startsWith('update_') ? { id: mkId, status: 'new' } : {})));
+  check('off: all eight tools answer the switched-off module’s sentence (N22)', offAnswers.every((x) => /Feedback is switched off in Platform Engineering/.test(text(x))), offAnswers.map((x) => text(x).slice(0, 60)).join(' | '));
+  r = await amara('POST', `/api/workspaces/${WS}/commit`, { modulesOff: [], changes: [{ id: 'chg_fbon', at: now(), actorId: 'amara', goalId: null, entity: 'workspace', entityId: WS, action: 'edited', summary: 'Switched Feedback on', diffs: [] }] });
+  const after = (await amara('GET', `/api/inbox/feedback${q}`)).json?.length;
+  const mk = (await rhea('GET', `/api/inbox/markups/${mkId}${q}`)).json;
+  check('back on: everything sent before is still in the inbox, as it was', r.status === 200 && after === before && mk?.status === 'fixed', `${before} → ${after}, markup ${mk?.status}`);
+
+  // Kept across a restart: SQLite and the files folder.
+  await stop(server); server = await start();
+  const back = client(); await back.signIn('rhea.kapoor@example.com');
+  r = await back('GET', `/api/inbox/markups/${mkId}/pictures/marked.jpg${q}`);
+  check('after a restart, the markup and its pictures load back', r.status === 200 && r.buf.equals(PNG));
+} finally {
+  await stop(server);
+}
+const failed = results.filter((x) => !x.ok);
+console.log(`\n${results.length - failed.length}/${results.length} checks pass${failed.length ? '; failing: ' + failed.map((f) => f.name).join('; ') : ''}`);
+process.exitCode = failed.length ? 1 : 0;
