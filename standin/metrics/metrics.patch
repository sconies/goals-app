+  await page.goto(B + '/check-in/' + encodeURIComponent(GOAL)); await page.waitForTimeout(2000);
+  check('switched off: the number step reads no source', !/From CI (runner metrics|analytics), read/.test(await page.locator('main').innerText()));
+  await admin.evaluate(async () => fetch('/api/workspaces/ws_platform/commit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ modulesOff: [], changes: [{ id: 'chg_ui_on', at: new Date().toISOString(), actorId: 'amara', goalId: null, entity: 'workspace', entityId: 'ws_platform', action: 'edited', summary: 'On', diffs: [] }] }) }));
