index 0000000..4fc3440
--- /dev/null
+++ b/platform/prove-metrics.mjs
@@ -0,0 +1,203 @@
+/* Stage 7 (Metric library) on the running stand-in platform: its exit criteria checked through the API and /mcp, as a
+   member without the right (rhea), an admin (amara) and goal owners' tokens. Phases, each against the server built
+   as named (platform/prove-metrics.sh runs them in order on one data folder):
+     on      built with the module: rows, refusals, the switch, MCP tools, readings, a restart
+     without built with the module left out: the workspace loads and saves; its rows untouched in SQLite
+     back    built with it again: every row there
+   Usage: node platform/prove-metrics.mjs <phase> <data dir> [port]. Prints one line per check and a tally. */
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+
+const [PHASE = 'on', DATA, PORT_ARG] = process.argv.slice(2);
+const PORT = Number(PORT_ARG || 47610);
+const B = `http://localhost:${PORT}`;
+const ENV = { ...process.env, STANDIN_PORT: String(PORT), STANDIN_DATA: DATA, NODE_NO_WARNINGS: '1' };
+const PASSWORD = 'faro-standin';
+const WS = 'ws_platform';
+const results = [];
+const check = (name, ok, detail = '') => { results.push({ name, ok: !!ok }); console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ' — ' + String(detail).slice(0, 220) : ''}`); };
+
+function run(args) { return new Promise((res, rej) => { const p = spawn(process.execPath, ['platform/dist/server.mjs', ...args], { env: ENV, stdio: ['ignore', 'pipe', 'inherit'] }); let out = ''; p.stdout.on('data', (d) => { out += d; }); p.on('exit', (c) => (c ? rej(new Error('exit ' + c)) : res(out))); }); }
+async function start() {
+  const p = spawn(process.execPath, ['platform/dist/server.mjs'], { env: ENV, stdio: ['ignore', 'pipe', 'inherit'] });
+  await new Promise((res) => p.stdout.on('data', (d) => { if (/stand-in platform/.test(String(d))) res(); }));
+  return p;
+}
+const stop = (p) => new Promise((res) => { p.on('exit', res); p.kill(); });
+function client() {
+  let cookie = '';
+  const c = async (method, url, body, headers = {}) => {
+    const r = await fetch(B + url, { method, redirect: 'manual', headers: { ...(cookie ? { cookie } : {}), ...(body !== undefined ? { 'Content-Type': typeof body === 'string' ? 'text/csv' : 'application/json' } : {}), ...headers }, body: body === undefined ? undefined : typeof body === 'string' ? body : JSON.stringify(body) });
+    const set = r.headers.get('set-cookie'); if (set) cookie = set.split(';')[0];
+    const text = await r.text(); let json = null; try { json = JSON.parse(text); } catch { /* html */ }
+    return { status: r.status, json, text };
+  };
+  c.signIn = (email) => c('POST', '/api/signin', { email, password: PASSWORD });
+  return c;
+}
+let n = 0;
+const id = (p) => `${p}_pm${PHASE}${String(++n).padStart(3, '0')}`;
+const now = () => new Date().toISOString();
+const change = (actor, entity, entityId, goalId, summary) => ({ id: id('chg'), at: now(), actorId: actor, goalId, entity, entityId, action: 'edited', summary, diffs: [] });
+const rows = (metrics = [], metricLinks = []) => ({ metrics: { ...(metrics.length ? { metrics } : {}), ...(metricLinks.length ? { metricLinks } : {}) } });
+const dbCounts = () => { const db = new DatabaseSync(path.join(DATA, 'faro.db')); const r = { metrics: db.prepare('select count(*) n from okr_metrics').get().n, links: db.prepare('select count(*) n from okr_goal_metrics').get().n, sig: JSON.stringify([db.prepare('select * from okr_metrics order by id').all(), db.prepare('select * from okr_goal_metrics order by id').all()]) }; db.close(); return r; };
+const SIG = path.join(DATA, 'metric-rows.json');
+
+if (PHASE === 'on') {
+  const out = await run(['seed', PASSWORD]);
+  check('seed: the demo’s workspace with its readings dropped on the files API', /Readings: \d+ from 2 sources/.test(out), out.match(/Readings.*/)?.[0]);
+}
+let server = await start();
+try {
+  const rhea = client(); await rhea.signIn('rhea.kapoor@example.com');
+  const amara = client(); await amara.signIn('amara.nwosu@example.com');
+  const load = async (c = rhea) => (await c('GET', `/api/workspaces/${WS}`)).json;
+  let s = await load();
+  const metrics = s.modules?.metrics?.metrics ?? [];
+  const links = s.modules?.metrics?.metricLinks ?? [];
+  const people = s.people;
+
+  if (PHASE === 'without') {
+    const before = JSON.parse(fs.readFileSync(SIG, 'utf8'));
+    check('left out: the workspace loads, with no metric rows offered', !!s.goals?.length && s.modules?.metrics === undefined, `${s.goals?.length} goals`);
+    const g = s.goals.find((x) => x.ownerId === 'rhea' && !x.removedAt);
+    let r = await rhea('POST', `/api/workspaces/${WS}/commit`, { goals: [{ ...g, title: g.title + ' (saved while metrics was left out)' }], changes: [change('rhea', 'goal', g.id, g.id, 'Renamed')] });
+    check('left out: a goal of a measured workspace saves', r.status === 200, r.json?.error);
+    r = await rhea('POST', `/api/workspaces/${WS}/commit`, { modules: rows([{ id: id('metric'), name: 'Sneaked in', unit: 'n', direction: 'higher' }]), changes: [change('rhea', 'metric', 'x', null, 'x')] });
+    check('left out: a save carrying metric rows is refused (its records are not saved without the module)', r.status === 403, r.json?.error);
+    const secret = (await amara('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: id('tok'), personId: 'amara', name: 'proof', createdBy: 'amara', createdAt: now(), lastUsedAt: null, revokedAt: null }], changes: [] })).json?.secret;
+    const t = await rhea('POST', '/mcp', { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} }, { Authorization: `Bearer ${secret}`, Accept: 'application/json, text/event-stream' });
+    check('left out: /mcp lists none of its tools', !t.json.result.tools.some((x) => /metric/.test(x.name)), `${t.json.result.tools.length} tools`);
+    check('left out: none of its rows in SQLite changed or was deleted', dbCounts().sig === before.sig, `${dbCounts().metrics} metrics, ${dbCounts().links} links`);
+  } else if (PHASE === 'back') {
+    const before = JSON.parse(fs.readFileSync(SIG, 'utf8'));
+    check('back: every metric and link is there again', metrics.length === before.metrics && links.length === before.links && dbCounts().sig === before.sig, `${metrics.length} metrics, ${links.length} links`);
+  } else {
+    // ---------- Criterion 7: the demo's rows ----------
+    const live = metrics.filter((m) => !m.removedAt);
+    check('C7: 13 metrics and 12 links load, two links for one part', live.length === 13 && links.length === 12 && links.filter((l) => l.part).map((l) => l.part).sort().join('|') === 'main branch pipelines|main pipelines', `${live.length} metrics, ${links.length} links`);
+    // People and rows to work with: a metric rhea doesn't own, and a measured goal she doesn't own.
+    const theirs = live.find((m) => m.ownerId !== 'rhea' && links.some((l) => l.metricId === m.id));
+    const link = links.find((l) => s.goals.find((g) => g.id === l.goalId)?.ownerId !== 'rhea');
+    const goal = s.goals.find((g) => g.id === link.goalId);
+    const rheaIsAdmin = people.find((p) => p.id === 'rhea')?.admin;
+    check('rhea is a member, not an admin; amara is an admin', !rheaIsAdmin && people.find((p) => p.id === 'amara')?.admin);
+
+    // ---------- Criterion 4, 6, 3, 15: forged saves by a member without the right ----------
+    const forge = async (c, actor, m, l, extra = {}) => c('POST', `/api/workspaces/${WS}/commit`, { modules: rows(m ? [m] : [], l ? [l] : []), ...extra, changes: [change(actor, 'metric', (m ?? l).id, l?.goalId ?? null, 'forged')] });
+    let r = await forge(rhea, 'rhea', { ...theirs, caveats: 'Changed by rhea' });
+    check('C4 R1: a member changes a metric she doesn’t own: refused', r.status === 403 && /or an admin can change this metric/.test(r.json?.error), r.json?.error);
+    r = await forge(rhea, 'rhea', { ...theirs, removedAt: now(), removedBy: 'rhea' });
+    check('C4 R1: a member removes a metric she doesn’t own: refused', r.status === 403 && /or an admin can change this metric/.test(r.json?.error), r.json?.error);
+    r = await forge(rhea, 'rhea', null, { ...link, part: 'taken over' });
+    check('C4 R1: a member changes the link of a goal she doesn’t own: refused', r.status === 403 && r.json?.error === 'Only the goal’s owner or an admin can choose what measures it.', r.json?.error);
+    r = await forge(rhea, 'rhea', null, { ...link, removedAt: now(), removedBy: 'rhea' });
+    check('C4 R1: a member unlinks a goal she doesn’t own: refused', r.status === 403, r.json?.error);
+    const fresh = { id: id('metric'), name: 'Proof metric', meaning: '', unit: 'jobs', decimals: 0, direction: 'lower', source: '', sourceOwner: '', refresh: null, ownerId: 'rhea', caveats: '', createdBy: 'rhea', createdAt: now(), updatedAt: now() };
+    r = await forge(rhea, 'rhea', { ...fresh, createdBy: 'amara' });
+    check('R1: a metric added as someone else: refused', r.status === 403 && /as the person signed in/.test(r.json?.error), r.json?.error);
+    r = await forge(rhea, 'rhea', { ...fresh, unit: '' });
+    check('C3: a metric without a unit: refused with what is missing', r.status === 403 && /Say its unit/.test(r.json?.error), r.json?.error);
+    r = await forge(rhea, 'rhea', { ...fresh, direction: 'sideways' });
+    check('C3: a metric without a direction: refused', r.status === 403 && /which way is better/.test(r.json?.error), r.json?.error);
+    r = await forge(rhea, 'rhea', fresh);
+    check('C3: anyone adds a metric with a name, a unit and a direction', r.status === 200, r.json?.error);
+    r = await forge(rhea, 'rhea', { ...fresh, id: id('metric'), name: 'PROOF METRIC' });
+    check('C3: a second metric with the same name in another case: refused', r.status === 403 && /already a metric called/.test(r.json?.error), r.json?.error);
+    r = await forge(rhea, 'rhea', { ...fresh, caveats: 'Mine to change' });
+    check('C4: its owner changes it', r.status === 200, r.json?.error);
+    r = await forge(amara, 'amara', { ...theirs, removedAt: now(), removedBy: 'amara' });
+    check('C6: a metric that has measured a goal can’t be deleted, even by an admin (Retire it instead.)', r.status === 403 && /Retire it instead\./.test(r.json?.error), r.json?.error);
+    r = await forge(amara, 'amara', null, { ...link, part: 'x'.repeat(61) });
+    check('C15: a part over 60 characters: refused', r.status === 403 && /60 characters/.test(r.json?.error), r.json?.error);
+    const otherUnit = live.find((m) => m.unit !== metrics.find((x) => x.id === link.metricId).unit);
+    r = await forge(amara, 'amara', null, { ...link, metricId: otherUnit.id });
+    check('C5: a goal linked to a metric in another unit: refused', r.status === 403 && /Use the same unit for both/.test(r.json?.error), r.json?.error);
+    const g2 = { ...goal, title: goal.title + ' (by a metric save)' };
+    r = await rhea('POST', `/api/workspaces/${WS}/commit`, { modules: rows([{ ...fresh, caveats: 'again' }]), goals: [g2], changes: [change('rhea', 'metric', fresh.id, null, 'x')] });
+    check('R1: a metric save can’t carry a change to someone else’s goal beyond what the library writes', r.status === 403 && /its owner/.test(r.json?.error), r.json?.error);
+
+    // ---------- The switch (criterion 8 in a workspace; "with it off") ----------
+    r = await rhea('POST', `/api/workspaces/${WS}/commit`, { modulesOff: ['metrics'], changes: [change('rhea', 'workspace', WS, null, 'Off')] });
+    check('a member can’t switch the Metric library off', r.status === 403, r.json?.error);
+    r = await amara('POST', `/api/workspaces/${WS}/commit`, { modulesOff: ['metrics'], changes: [change('amara', 'workspace', WS, null, 'Off')] });
+    check('an admin switches it off', r.status === 200, r.json?.error);
+    r = await forge(rhea, 'rhea', { ...fresh, caveats: 'while off' });
+    check('switched off: a save of its rows is refused with the module-off sentence', r.status === 403 && /^Metric library is switched off in Platform Engineering/.test(r.json?.error), r.json?.error);
+    r = await rhea('GET', `/api/workspaces/${WS}/readings`);
+    check('switched off: no readings are offered', r.status === 200 && r.json.length === 0);
+    const tok = async (person) => (await amara('POST', `/api/workspaces/${WS}/tokens`, { tokens: [{ id: id('tok'), personId: person, name: 'proof', createdBy: 'amara', createdAt: now(), lastUsedAt: null, revokedAt: null }], changes: [] })).json?.secret;
+    const rheaTok = await tok('rhea');
+    const mcp = async (method, params, token = rheaTok) => (await rhea('POST', '/mcp', { jsonrpc: '2.0', id: ++n, method, params }, { Authorization: `Bearer ${token}`, Accept: 'application/json, text/event-stream' })).json;
+    const said = (j) => j?.result?.content?.[0]?.text ?? JSON.stringify(j?.error ?? j);
+    let j = await mcp('tools/call', { name: 'list_metrics', arguments: {} });
+    check('switched off: an MCP tool refuses with the module-off sentence', j?.result?.isError && /Metric library is switched off in Platform Engineering, so list_metrics can’t be used there/.test(said(j)), said(j));
+    check('switched off: its rows are still in SQLite', dbCounts().metrics === 14);
+    r = await amara('POST', `/api/workspaces/${WS}/commit`, { modulesOff: [], changes: [change('amara', 'workspace', WS, null, 'On')] });
+    check('an admin switches it back on', r.status === 200, r.json?.error);
+
+    // ---------- MCP tools (same rules, through the token) ----------
+    j = await mcp('tools/list', {});
+    const names = j.result.tools.map((t) => t.name);
+    check('/mcp lists its seven tools', ['list_metrics', 'get_metric', 'save_metric', 'remove_metric', 'retire_metric', 'merge_metrics', 'link_goal_metric'].every((t) => names.includes(t)), `${names.length} tools`);
+    j = await mcp('tools/call', { name: 'list_metrics', arguments: {} });
+    check('MCP list_metrics reads the library from SQLite', !j.result.isError && /Lead time for changes/.test(said(j)));
+    j = await mcp('tools/call', { name: 'save_metric', arguments: { id: theirs.id, caveats: 'By rhea’s assistant' } });
+    check('MCP save_metric on a metric rhea doesn’t own: refused', j.result.isError && /or an admin can change this metric/.test(said(j)), said(j));
+    j = await mcp('tools/call', { name: 'link_goal_metric', arguments: { goal: goal.id, unlink: true } });
+    check('MCP link_goal_metric on a goal rhea doesn’t own: refused', j.result.isError && /goal’s owner or an admin/.test(said(j)), said(j));
+    j = await mcp('tools/call', { name: 'remove_metric', arguments: { metric: theirs.id } }, await tok(theirs.ownerId));
+    check('MCP remove_metric on a metric that has measured goals: Retire it instead.', j.result.isError && /Retire it instead/.test(said(j)), said(j));
+    j = await mcp('tools/call', { name: 'save_metric', arguments: { name: 'Zebra crossings counted', unit: 'runs', direction: 'higher', answers: { unit: 'keep', meaning: 'as-written' } } });
+    check('MCP save_metric adds one for the token’s person', !j.result.isError && !/Nothing saved/.test(said(j)), said(j));
+    j = await mcp('tools/call', { name: 'remove_metric', arguments: { metric: 'Zebra crossings counted' } });
+    check('C6: one that never measured a goal is deleted (comes back with Undo or Recently removed)', !j.result.isError, said(j));
+    s = await load();
+    const removed = s.modules.metrics.metrics.find((m) => m.name === 'Zebra crossings counted');
+    check('C6: the deleted metric keeps its row, marked removed', !!removed?.removedAt);
+    j = await mcp('tools/call', { name: 'restore_removed', arguments: { kind: 'metric', id: removed.id } });
+    s = await load();
+    check('C6: restore_removed brings it back', !j.result.isError && !s.modules.metrics.metrics.find((m) => m.id === removed.id)?.removedAt, said(j));
+
+    // ---------- Criterion 18 to 20: the number source on the files API ----------
+    r = await rhea('GET', `/api/workspaces/${WS}/readings`);
+    const readings = r.json ?? [];
+    check('C18: the readings drop is served to members, from two sources', readings.length > 0 && new Set(readings.map((x) => x.source)).size === 2, `${readings.length} rows`);
+    const outsider = client(); r = await outsider('GET', `/api/workspaces/${WS}/readings`);
+    check('C18: signed out, no readings', r.status === 401);
+    const csv = 'source,metric,team,part,at,value\nProof source,' + fresh.id + ',,,' + now() + ',4\n';
+    r = await rhea('PUT', `/api/files/readings/${WS}/proof-rhea.csv`, csv);
+    check('R12.3: a member who isn’t an admin drops readings: refused', r.status === 403, r.json?.error);
