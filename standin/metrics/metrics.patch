+-- keeps its rows while the module is left out.
+
+create table if not exists okr_goal_metrics (
+  id text not null,
+  workspace_id text not null,
+  goal_id text not null,
+  metric_id text not null,
+  team_id text,
+  linked_by text not null,
+  linked_at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  removed_at timestamptext,
+  removed_by text,
+  part text not null default '',
+  primary key (id)
+);
+
+create table if not exists okr_metrics (
+  id text not null,
+  workspace_id text not null,
+  name text not null,
+  meaning text not null default '',
+  unit text not null,
+  decimals integer not null default 0,
+  direction text not null,
+  source text not null default '',
+  source_owner text not null default '',
+  refresh text,
+  owner_id text not null,
+  caveats text not null default '',
+  created_by text not null,
+  created_at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  updated_at timestamptext not null default (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  removed_at timestamptext,
+  removed_by text,
+  retired_at timestamptext,
+  retired_by text,
+  retired_why text not null default '',
+  replaced_by text,
+  marks jsontext not null default '[]',
+  measurement text not null default 'measured',
+  measurement_note text not null default '',
+  level text,
+  parent_id text,
+  confidence text,
+  gaming text,
+  primary key (id)
+);
+
+create index if not exists okr_goal_metrics_metric on okr_goal_metrics (metric_id);
+create index if not exists okr_goal_metrics_ws on okr_goal_metrics (workspace_id);
+create index if not exists okr_metrics_ws on okr_metrics (workspace_id);
+create unique index if not exists okr_metrics_ws_name on okr_metrics (workspace_id, lower(trim(name))) where removed_at IS NULL;
