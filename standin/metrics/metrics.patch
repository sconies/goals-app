+// @vitest-environment node
+/* Stage 7 on the stand-in platform: the Metric library's rows in SQLite (its own migration), the server's check of every
+   record it owns (guards/metrics.ts) against the module's actions and against forged saves, a workspace keeping its rows
+   while the module is left out, and the stand-in's number source passing the module's source contract. */
+import path from 'node:path';
+import { buildPlatformOrg } from '../../data/platformOrg';
+import { applyCommit, type Commit } from '../../data/store';
+import type { ActionContext } from '../../domain/actions';
+import { currentCycle, scopeToCycle } from '../../domain/cycle';
+import { currentWeek } from '../../domain/plan';
+import { MODULE_RECORDS } from '../../core/records';
+import type { Goal, Person, Snapshot, Workspace } from '../../domain/types';
+import * as M from '../../modules/metrics/rules';
+import { linkGoalMetric } from '../../modules/metrics/rulesLink';
+import { mergeMetrics, retireMetric, saveMetricChange } from '../../modules/metrics/rulesChange';
+import { numberSourceContract } from '../../modules/metrics/source.contract';
+import type { Metric } from '../../modules/metrics/types';
+import { refusal, type GuardModules } from './guard';
+import { openDatabase } from './migrate';
+import { SqliteStore } from './sqliteStore';
+import { parseReadings, readingsCsv, sourcesFromRows, type ReadingRow } from '../../modules/metrics/standinSources';
+
+const MIGRATIONS = path.resolve(__dirname, '../../../platform/migrations');
+const today = new Date('2026-11-05T12:00:00Z');
+let n = 0;
+const newId = (p: string) => `${p}_s${++n}`;
+
+function world() {
+  let full: Snapshot = buildPlatformOrg(today);
+  const cycle = currentCycle(full.cycles, today)!;
+  const week = currentWeek(cycle, today);
+  const x = (who: Person): ActionContext => ({ snapshot: scopeToCycle(full, cycle, MODULE_RECORDS), cycle, week, actor: who, now: new Date().toISOString(), newId, allGoals: full.goals, full });
+  return {
+    x, get full() { return full; },
+    apply(c: Commit | null) { if (c) full = applyCommit(full, c); return c; },
+  };
+}
+const ON: GuardModules = { on: new Set(['metrics']), workspace: 'Platform Engineering', name: () => 'Metric library' };
+const OFF: GuardModules = { ...ON, on: new Set() };
+
+describe('the Metric library’s rows on SQLite (platform/migrations/0010_module_metrics.sql)', () => {
+  it('makes its two tables, on the list a save may write; the core’s file names neither', () => {
+    const db = openDatabase(':memory:', MIGRATIONS);
+    const t = (db.prepare("select table_name from module_tables where module = 'metrics' order by position").all() as { table_name: string }[]).map((r) => r.table_name);
+    expect(t).toEqual(['okr_metrics', 'okr_goal_metrics']);
+    expect(require('node:fs').readFileSync(path.join(MIGRATIONS, '0001_core.sql'), 'utf8')).not.toMatch(/okr_metrics|okr_goal_metrics/);
+  });
+
+  it('keeps the demo’s 13 metrics and 12 links; built without the module, loads and saves without changing one; back, they are all there', async () => {
+    const db = openDatabase(':memory:', MIGRATIONS);
+    const s = buildPlatformOrg(today);
+    const ws: Workspace = { id: 'ws_p', name: 'Platform Engineering', kind: 'own', createdAt: today.toISOString() };
+    const withIt = new SqliteStore(db, MODULE_RECORDS);
+    await withIt.createWorkspace(ws, { ...s, tokens: [], feedback: [] });
+    const rows = () => JSON.stringify([db.prepare('select * from okr_metrics order by id').all(), db.prepare('select * from okr_goal_metrics order by id').all()]);
+    const before = rows();
+    const loaded = await withIt.load(ws.id);
+    expect(M.metricsOf(loaded)).toHaveLength(13);
+    expect(M.linksOf(loaded)).toHaveLength(12);
+    expect(M.linksOf(loaded).filter((l) => l.part).map((l) => l.part).sort()).toEqual(['main branch pipelines', 'main pipelines']);
+    // Left out: the store knows no metric records, so it neither reads nor writes them.
+    const without = new SqliteStore(db, MODULE_RECORDS.filter((r) => r.module !== 'metrics'));
+    const bare = await without.load(ws.id);
+    expect(bare.modules?.metrics).toBeUndefined();
+    const g = bare.goals[0]!;
+    await without.commit(ws.id, { goals: [{ ...g, title: g.title + ' (kept)' }], changes: [] });
+    expect(rows()).toBe(before);
+    const back = await new SqliteStore(db, MODULE_RECORDS).load(ws.id);
+    expect(M.metricsOf(back)).toEqual(M.metricsOf(loaded));
+    expect(M.linksOf(back)).toEqual(M.linksOf(loaded));
+  });
+});
+
+describe('the server’s check of the Metric library’s rows (guards/metrics.ts)', () => {
+  const w = world();
+  const admin = w.full.people.find((p) => p.admin && !p.leftAt)!;
+  const metric = (name: string) => M.metricsOf(w.full).find((m) => m.name === name)!;
+  const lead = metric('Lead time for changes');
+  const owner = w.full.people.find((p) => p.id === lead.ownerId)!;
+  const stranger = w.full.people.find((p) => !p.admin && !p.leftAt && p.id !== lead.ownerId && !w.full.goals.some((g) => g.ownerId === p.id && M.linksOf(w.full).some((l) => l.goalId === g.id)))!;
+  const forged = (actor: Person, rows: { metrics?: Metric[]; metricLinks?: ReturnType<typeof M.linksOf> }, goals?: Goal[]): Commit => ({ ...M.metricRows(rows), ...(goals ? { goals } : {}), changes: [{ id: newId('chg'), at: new Date().toISOString(), actorId: actor.id, goalId: null, entity: 'metric', entityId: 'x', action: 'edited', summary: 'forged', diffs: [] }] });
+  const check = (c: Commit, who: Person, mods = ON) => refusal(w.full, c, who, mods);
+
+  it('lets the module’s own actions through: anyone adds a metric; its owner changes it; a goal’s owner links it', () => {
+    const added = M.saveMetric(w.x(stranger), { name: 'Stand-in reading count', unit: 'readings', direction: 'higher', confirm: true }).commit!;
+    expect(check(added, stranger)).toBeNull();
+    const changed = saveMetricChange(w.x(owner), { id: lead.id, caveats: 'Reworded on the stand-in.' }).commit!;
+    expect(check(changed, owner)).toBeNull();
+    const l = M.linksOf(w.full)[0]!;
+    const g = w.full.goals.find((x) => x.id === l.goalId)!;
+    const gOwner = w.full.people.find((p) => p.id === g.ownerId)!;
+    const unlinked = M.unlinkGoalMetric(w.x(gOwner), g)!;
+    expect(check(unlinked, gOwner)).toBeNull();
+  });
+
+  it('refuses a metric changed or removed by someone who isn’t its owner or an admin, in the module’s words', () => {
+    expect(check(forged(stranger, { metrics: [{ ...lead, caveats: 'not mine' }] }), stranger)).toMatch(/or an admin can change this metric\./);
+    expect(check(forged(stranger, { metrics: [{ ...lead, removedAt: new Date().toISOString(), removedBy: stranger.id }] }), stranger)).toMatch(/or an admin can change this metric\./);
+    expect(check(forged(admin, { metrics: [{ ...lead, caveats: 'admin' }] }), admin)).toBeNull();
+  });
+
+  it('refuses a metric added as someone else, one without a unit, and a second with the same name in another case', () => {
+    const fresh = M.saveMetric(w.x(stranger), { name: 'Queue depth on the stand-in', unit: 'jobs', direction: 'lower', confirm: true }).metric;
+    expect(check(forged(stranger, { metrics: [{ ...fresh, createdBy: owner.id }] }), stranger)).toBe('A metric is added as the person signed in.');
+    expect(check(forged(stranger, { metrics: [{ ...fresh, unit: '' }] }), stranger)).toMatch(/Say its unit/);
+    expect(check(forged(stranger, { metrics: [{ ...fresh, name: lead.name.toUpperCase() }] }), stranger)).toMatch(/There’s already a metric called/);
+  });
+
+  it('refuses deleting a metric that has measured a goal (Retire it instead.)', () => {
+    expect(check(forged(owner, { metrics: [{ ...lead, removedAt: new Date().toISOString(), removedBy: owner.id }] }), owner)).toMatch(/Retire it instead\./);
+  });
+
+  it('refuses a link made or changed by someone who doesn’t own the goal, a link not filed under its goal, a part over 60 characters, a unit that differs, and a retired metric', () => {
+    const l = M.linksOf(w.full).find((x) => x.metricId === lead.id)!;
+    expect(check(forged(stranger, { metricLinks: [{ ...l, part: 'mine now' }] }), stranger)).toBe('Only the goal’s owner or an admin can choose what measures it.');
+    expect(check(forged(admin, { metricLinks: [{ ...l, id: 'other' }] }), admin)).toBe('A goal’s link to its metric is filed under the goal.');
+    expect(check(forged(admin, { metricLinks: [{ ...l, part: 'x'.repeat(61) }] }), admin)).toBe('Keep the part to 60 characters or fewer.');
+    const minutes = M.metricsOf(w.full).find((m) => m.unit !== 'hours' && !m.retiredAt && m.unit !== '%')!;
+    expect(check(forged(admin, { metricLinks: [{ ...l, metricId: minutes.id }] }), admin)).toMatch(/Use the same unit for both\./);
+    const retired = retireMetric(w.x(admin), minutes.id, 'Stand-in check.');
+    const after = { ...w.full, modules: applyCommit(w.full, retired).modules };
+    expect(refusal(after, forged(admin, { metricLinks: [{ ...l, metricId: minutes.id }] }), admin, ON)).toMatch(/was retired on/);
+  });
+
+  it('lets a metric’s owner relabel the goals it measures, and nothing else on them; a non-admin can’t merge', () => {
+    const q = M.metricsOf(w.full).find((m) => M.linksOf(w.full).some((l) => l.metricId === m.id && !l.removedAt) && w.full.goals.some((g) => g.ownerId !== m.ownerId && M.linksOf(w.full).some((l) => l.goalId === g.id && l.metricId === m.id)))!;
+    const qOwner = w.full.people.find((p) => p.id === q.ownerId)!;
+    const relabel = saveMetricChange(w.x(qOwner), { id: q.id, unit: q.unit + 's', relabel: true, confirm: true }).commit!;
+    expect(relabel.goals?.length).toBeGreaterThan(0);
+    expect(check(relabel, qOwner)).toBeNull();
+    const g = relabel.goals![0]!;
+    expect(check({ ...relabel, goals: [{ ...g, title: 'Renamed by the metric’s owner' }] }, qOwner)).toMatch(/\(its owner\) or an admin can change/);
+    const other = M.metricsOf(w.full).find((m) => m.unit === q.unit && m.id !== q.id);
+    if (other) expect(() => mergeMetrics(w.x(qOwner), q.id, other.id)).toThrow();
+  });
+
+  it('refuses every metric row while the module is switched off or left out, with the module-off sentence', () => {
+    const added = M.saveMetric(w.x(stranger), { name: 'Off reading', unit: 'n', direction: 'higher', confirm: true }).commit!;
+    expect(check(added, stranger, OFF)).toBe('Metric library is switched off in Platform Engineering, so its records can’t be saved there. An admin can switch it on in Workspace, under Features.');
+  });
+
+  it('lets a goal’s new owner link it in the same save that creates it', () => {
+    const g = w.full.goals.find((x) => M.linksOf(w.full).some((l) => l.goalId === x.id && l.metricId === lead.id))!;
+    const copy = { ...g, id: 'goal_new_standin', ownerId: stranger.id } as Goal;
+    const x = { ...w.x(stranger), snapshot: { ...w.x(stranger).snapshot, goals: [...w.full.goals, copy] } };
+    const c = linkGoalMetric(x, copy, lead.id, null)!;
+    expect(check({ ...c, goals: [copy, ...(c.goals ?? [])] }, stranger)).toBeNull();
+  });
+});
+
+numberSourceContract('the stand-in platform’s CSV drops on the files API', async () => {
+  const rows: ReadingRow[] = [
+    { source: 'Warehouse', metric: 'metric_q', team: null, part: '', at: '2026-10-01T09:00:00Z', value: 10 },
+    { source: 'Warehouse', metric: 'metric_q', team: null, part: '', at: '2026-10-08T09:00:00Z', value: 12 },
+    { source: 'Warehouse', metric: 'metric_q', team: 'team_a', part: 'tier-1', at: '2026-10-08T09:00:00Z', value: 3 },
+    { source: 'Elsewhere', metric: 'metric_r', team: null, part: '', at: '2026-10-08T09:00:00Z', value: 1 },
+  ];
+  // Through the file's own words, as the server reads a drop.
+  const source = sourcesFromRows(parseReadings(readingsCsv(rows))).find((s) => s.name === 'Warehouse')!;
