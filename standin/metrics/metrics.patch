+    before: new Date('2026-09-01T00:00:00Z'), after: new Date('2026-10-20T00:00:00Z'),
+    slices: { read: [{ teamId: null, part: '' }, { teamId: 'team_a', part: 'tier-1' }], unread: { teamId: 'team_b', part: '' } },
+  };
+});
+
+describe('the stand-in’s number source', () => {
+  it('never reads a team’s slice from a company-wide row, throws when unreachable, and skips a row that isn’t one', async () => {
+    const rows = parseReadings('source,metric,team,part,at,value\nW,m,,,2026-10-01T09:00:00Z,5\nW,m,,,not a time,6\nW,m,,,2026-10-02T09:00:00Z,\n');
+    expect(rows).toHaveLength(1);
+    const [s] = sourcesFromRows(rows);
