+DATA=$(mktemp -d -t faro-metrics-XXXX)
+ALL=ai-access,feedback,goal-map,reviews,spreadsheets,tags,watching,wrap-up
+fail=0
+npm run -s build:standin >/dev/null
+node platform/prove-metrics.mjs on "$DATA" "$PORT" || fail=1
+STANDIN_WITHOUT=$ALL,metrics npm run -s build:standin >/dev/null
+node platform/prove-metrics.mjs without "$DATA" "$PORT" || fail=1
+npm run -s build:standin >/dev/null
+node platform/prove-metrics.mjs back "$DATA" "$PORT" || fail=1
+exit $fail
