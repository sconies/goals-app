+/* The Metric library on the platform Faro runs on (src/core/platform.ts; drill item 11, stage 7): the server's check of
+   its two records on every save (./standinGuard.ts), and its number sources read from CSV drops on the platform's files
+   API, under readings/<workspace>/ (./standinSources.ts): the browser fetches them from GET /api/workspaces/:id/readings,
+   the AI tools' check-ins read the folder; only a workspace's admins drop readings (R12.3). The seed drops the demo's
+   two sources' weekly readings, so a check-in on the stand-in opens with a reading as the demo's does. */
+import type { ModulePlatform, PlatformServer } from '../../core/platform';
+import { currentCycle } from '../../domain/cycle';
+import { demoSources } from './numbers';
+import { linksOf, metricsOf } from './rules';
+import { registerNumberSources } from './sources';
+import { metricsGuard } from './standinGuard';
+import { httpNumberSources, parseReadings, readingsCsv, sourcesFromRows, type ReadingRow } from './standinSources';
+
+const folder = (ws: string) => `readings/${ws.replace(/[^A-Za-z0-9_-]/g, '_')}/`;
+
+/** Every drop for a workspace, oldest file first. */
+async function readingRows(p: PlatformServer, ws: string): Promise<ReadingRow[]> {
+  const out: ReadingRow[] = [];
+  for (const f of (await p.files.list(folder(ws))).filter((x) => x.endsWith('.csv')).sort()) {
+    const b = await p.files.bytes(f);
+    if (b) out.push(...parseReadings(new TextDecoder().decode(b)));
+  }
+  return out;
+}
+
+const platform: ModulePlatform = {
+  guard: metricsGuard,
+  browser: () => registerNumberSources(httpNumberSources()),
+  server: (p) => registerNumberSources(async (ws) => sourcesFromRows(await readingRows(p, ws))),
+  routes: { readings: (p, ws) => readingRows(p, ws) },
+  adminFiles: ['readings'],
+  async seed(p, ws, s, today) {
+    const metrics = metricsOf(s);
+    const cycle = currentCycle(s.cycles, today) ?? s.cycles.at(-1);
+    const file = `${folder(ws)}seed.csv`;
+    if (!metrics.length || !cycle || (await p.files.url(file))) return null;
+    const sources = demoSources(s, cycle);
+    const rows: ReadingRow[] = [];
+    for (const l of linksOf(s).filter((x) => !x.removedAt)) {
+      const m = metrics.find((x) => x.id === l.metricId);
+      const slice = { teamId: l.teamId, part: l.part ?? '' };
+      const src = m && sources.find((x) => x.reads(m, slice));
+      if (!m || !src) continue;
+      const seen = new Set<string>();
+      for (let w = 1; w <= cycle.weeks; w++) {
+        const r = await src.read(m, new Date(Date.parse(cycle.startDate) + w * 7 * 86_400_000), slice);
+        if (r && !seen.has(r.at) && Date.parse(r.at) <= today.getTime()) { seen.add(r.at); rows.push({ source: src.name, metric: m.id, team: l.teamId, part: l.part ?? '', at: r.at, value: r.value }); }
+      }
+    }
+    if (!rows.length) return null;
+    await p.files.put(file, new Blob([readingsCsv(rows)]), 'text/csv');
+    return `Readings: ${rows.length} from ${new Set(rows.map((r) => r.source)).size} sources.`;
+  },
+};
+export default platform;
