diff --git a/src/modules/metrics/standinGuard.ts b/src/modules/metrics/standinGuard.ts
new file mode 100644
index 0000000..e4acb12
--- /dev/null
+++ b/src/modules/metrics/standinGuard.ts
@@ -0,0 +1,105 @@
+/* The Metric library's rows, checked by the stand-in platform's server on every save (R1 rule 4, drill item 11, stage 7).
+   The browser runs the module's actions (src/modules/metrics) and sends their Commit; on Faro's Postgres the table's CHECK
+   constraints and row rules stood behind it, here nothing does, so the server asks the module's own rules of each row
+   the save changes, against the workspace as stored with the save applied:
+
+     a metric   anyone adds one (as themselves); its owner or an admin changes or removes it (canEditMetric); it must be
+                one metricProblems passes (name, unit, direction, decimals, refresh, owner, lengths, one name per
+                workspace); one that has measured a goal is retired, never removed (removeMetric's words);
+     a link     filed under its goal (id = goal id); for a goal created in the same save, whoever creates it; otherwise
+                the goal's owner or an admin (canLinkGoal); its metric and goal in the workspace; a part of at most
+                PART_MAX; a new or moved link passes linkProblems (unit, dated stages) and names no retired metric;
+     a goal     someone else's goal may change in a metric's save only in what the library writes on it: its unit (a
+                new label for the metric's unit) and whether it is held to no number (a gap), for a goal that metric
+                measures (rulesChange saveMetricChange, rulesMeasured heldBy).
+
+   Pure; the words are the module's. */
+import type { Commit } from '../../data/store';
+import type { Goal, Person, Snapshot } from '../../domain/types';
+import { applyModuleRows } from '../../domain/records';
+import { canEditMetric, canLinkGoal, everUsed, linkProblems, linksOf, LINKS_KEY, METRICS_KEY, metricProblems, metricsOf, MODULE } from './rules';
+import { retiredWords } from './rulesChange';
+import { PART_MAX } from './rulesParts';
+import type { Metric, MetricLink } from './types';
+import type { ModuleGuard } from '../../core/platform';
+
+const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
+const byId = <T extends { id: string }>(xs: readonly T[]) => new Map(xs.map((x) => [x.id, x]));
+const nameOf = (s: Snapshot, id: string) => s.people.find((p) => p.id === id)?.name;
+
+/** The workspace as it would be after this save: its goals and the module's rows (what the module's rules read). */
+function after(stored: Snapshot, c: Commit): Snapshot {
+  const goals = byId(stored.goals);
+  for (const g of c.goals ?? []) goals.set(g.id, g);
+  return { ...stored, goals: [...goals.values()], modules: applyModuleRows(stored.modules, c.modules) };
+}
+const commitMetrics = (c: Commit) => (c.modules?.[MODULE]?.[METRICS_KEY] ?? []) as Metric[];
+const commitLinks = (c: Commit) => (c.modules?.[MODULE]?.[LINKS_KEY] ?? []) as MetricLink[];
+
+export const metricsGuard: ModuleGuard = {
+  refusal(stored, c, actor) {
+    const me = { id: actor.id, admin: !!actor.admin, name: actor.name } as Person;
+    const next = after(stored, c);
+    const metrics = byId(metricsOf(stored));
+    const links = linksOf(stored);
+    for (const m of commitMetrics(c)) {
+      const was = metrics.get(m.id);
+      if (same(was, m)) continue;
+      if (!was) {
+        if (m.createdBy !== actor.id) return 'A metric is added as the person signed in.';
+      } else {
+        if (!canEditMetric(me, was)) return `Only ${nameOf(stored, was.ownerId) ?? 'the metric’s owner'} or an admin can change this metric.`;
+        if (m.removedAt && !was.removedAt && everUsed(was.id, links)) return `${was.name} has measured goals, so it can’t be deleted. Retire it instead.`;
+      }
+      if (m.removedAt) continue;
+      const problems = metricProblems(m, next);
+      if (problems.length) return problems.join(' ');
+    }
+    const goalsWas = byId(stored.goals);
+    const goalsNow = byId(next.goals);
+    const metricsNow = byId(metricsOf(next));
+    const linksWas = byId(links);
+    for (const l of commitLinks(c)) {
+      const was = linksWas.get(l.id);
+      if (same(was, l)) continue;
+      if (l.id !== l.goalId) return 'A goal’s link to its metric is filed under the goal.';
+      const g = goalsNow.get(l.goalId);
+      if (!g) return 'That link’s goal isn’t in this workspace.';
+      const m = metricsNow.get(l.metricId);
+      if (!m) return 'That link’s metric isn’t in this workspace.';
+      const before = goalsWas.get(l.goalId);
+      if (before && !canLinkGoal(me, before)) return 'Only the goal’s owner or an admin can choose what measures it.';
+      if ((l.part ?? '').trim().length > PART_MAX) return `Keep the part to ${PART_MAX} characters or fewer.`;
+      const moved = !was || was.removedAt || was.metricId !== l.metricId;
+      if (l.removedAt || !moved) continue;
+      if (m.retiredAt) return retiredWords(m);
+      const { errors } = linkProblems(g, m);
+      if (errors.length) return errors.join(' ');
+    }
+    // A metric whose unit changed: every goal it measures takes the new unit in the same save (rule 3's new label).
+    for (const m of commitMetrics(c)) {
+      const was = metrics.get(m.id);
+      if (!was || was.unit === m.unit || m.removedAt) continue;
+      for (const l of linksOf(next).filter((x) => x.metricId === m.id && !x.removedAt)) {
+        const g = goalsNow.get(l.goalId);
+        if (g && !g.removedAt) { const { errors } = linkProblems(g, m); if (errors.length) return errors.join(' '); }
+      }
+    }
+    return null;
+  },
+
+  allowsGoal(stored, c, actor, was, now) {
+    // Only what the library writes on a goal: its unit and whether it is held to no number.
+    type Written = { unit?: string; unmeasuredSince?: string | null };
+    const { unit: unitNow, unmeasuredSince: _h, ...rest } = now as Goal & Written;
+    const { unit: unitWas, unmeasuredSince: _h2, ...restWas } = was as Goal & Written;
+    if (!same(rest, restWas)) return false;
+    // …in a save of the metric that measures it, by someone that save's rules allow (refusal checks them).
+    const link = linksOf(after(stored, c)).find((l) => l.goalId === now.id);
+    const m = link && commitMetrics(c).find((x) => x.id === link.metricId);
+    const linkSaved = commitLinks(c).some((l) => l.goalId === now.id);
+    if (!m && !linkSaved) return false;
+    if (unitNow !== unitWas && (!m || m.unit !== unitNow)) return false;
+    return !!actor;
+  },
+};
