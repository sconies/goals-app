+   Usage: node platform/ui-metrics.mjs <base> <member email> <admin email> <password> <a goal the member owns, read by a source> [shots] */
+import { chromium } from 'playwright';
+const [B, EMAIL, ADMIN, PASSWORD, GOAL, SHOTS] = process.argv.slice(2);
+const results = [];
+const check = (name, ok, detail = '') => { results.push(!!ok); console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ' — ' + String(detail).slice(0, 200) : ''}`); };
+const browser = await chromium.launch();
+async function signedIn(email) {
+  const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });
+  page.errs = []; page.on('pageerror', (e) => page.errs.push(String(e)));
+  await page.goto(B + '/');
+  await page.fill('input[name=email]', email);
+  await page.fill('input[name=password]', PASSWORD);
+  await page.click('button[type=submit]');
+  await page.waitForLoadState('networkidle');
+  return page;
+}
+const shot = (page, n) => SHOTS ? page.screenshot({ path: `${SHOTS}/${n}.png` }) : null;
+const nav = async (page) => (await page.locator('nav').first().innerText()).split('\n').map((t) => t.trim()).filter(Boolean);
+try {
+  const page = await signedIn(EMAIL);
+  await page.waitForTimeout(800);
+  let items = await nav(page);
+  check('C11: Metrics is in the menu, after People', items.indexOf('Metrics') > items.indexOf('People') && items.indexOf('People') >= 0, items.join(' | '));
+  await page.goto(B + '/metrics'); await page.waitForTimeout(1200); await shot(page, 'library');
+  const body = await page.locator('main').innerText();
+  check('C11: the library lists the demo’s metrics from SQLite', /Lead time for changes/.test(body) && /Pipeline queue wait/.test(body), body.slice(0, 160).replace(/\n/g, ' · '));
+  await page.goto(B + '/data/metrics'); await page.waitForTimeout(800);
+  check('C11: the old address under Data leads to the library', new URL(page.url()).pathname === '/metrics', page.url());
