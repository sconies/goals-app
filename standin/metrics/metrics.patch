index 0000000..6733cef
--- /dev/null
+++ b/src/modules/metrics/standinSources.ts
@@ -0,0 +1,66 @@
+/* The Metric library's number sources on the stand-in platform (stage 7, criterion 18; R12 names real connectors): a
+   source's readings arrive as CSV drops on the platform's files API, under readings/<workspace>/ (one file per drop,
+   never replaced: the Files port adds a file once), with the header
+
+     source,metric,team,part,at,value
+
+   (`metric` a metric's id; `team` a team's id, empty for the whole company; `part` empty for all of it; `at` an ISO
+   time; `value` a number). Each source named in the drops is a NumberSource (src/modules/metrics/source.ts) that reads
+   exactly the slices it has rows for: a company-wide row never reads a team's slice. The browser fetches the rows from
+   GET /api/workspaces/:id/readings (members only); the AI tools' endpoint reads the folder itself. Pure apart from
+   `httpNumberSources`' fetch. */
+import type { NumberSource, Reading, Slice, SourcedMetric } from './source';
+
+export interface ReadingRow { source: string; metric: string; team: string | null; part: string; at: string; value: number }
+
+/** The rows of one drop; a row that isn't one (a bad time or number, a missing source or metric) is skipped. */
+export function parseReadings(csv: string): ReadingRow[] {
+  const [head, ...lines] = csv.replace(/\r/g, '').split('\n').filter((l) => l.trim());
+  if (!head) return [];
+  const cols = head.split(',').map((c) => c.trim().toLowerCase());
+  const at = (k: string) => cols.indexOf(k);
+  const out: ReadingRow[] = [];
+  for (const line of lines) {
+    const v = line.split(',').map((c) => c.trim());
+    const row = { source: v[at('source')] ?? '', metric: v[at('metric')] ?? '', team: v[at('team')] || null, part: v[at('part')] ?? '', at: v[at('at')] ?? '', value: Number(v[at('value')]) };
+    if (row.source && row.metric && !Number.isNaN(Date.parse(row.at)) && v[at('value')] !== '' && Number.isFinite(row.value)) out.push(row);
+  }
+  return out;
+}
+
+/** The rows as CSV (the seed's drop, and a test's). */
+export const readingsCsv = (rows: readonly ReadingRow[]) =>
+  ['source,metric,team,part,at,value', ...rows.map((r) => [r.source, r.metric, r.team ?? '', r.part, r.at, r.value].join(','))].join('\n') + '\n';
+
+const sameSlice = (r: ReadingRow, s: Slice) => (r.team ?? null) === (s.teamId ?? null) && r.part.trim() === (s.part ?? '').trim();
+
+/** One NumberSource per source the rows name. `reachable` says whether the source answers now (false: read throws). */
+export function sourcesFromRows(rows: readonly ReadingRow[], reachable: () => boolean = () => true): NumberSource[] {
+  const names = [...new Set(rows.map((r) => r.source))].sort();
+  return names.map((name): NumberSource => {
+    const mine = (m: SourcedMetric, slice?: Slice) =>
+      m.source === name && !m.removedAt ? rows.filter((r) => r.source === name && r.metric === m.id && (!slice || sameSlice(r, slice))) : [];
+    return {
+      name,
+      reads: (m, slice) => mine(m, slice).length > 0,
+      async read(m, at, slice): Promise<Reading | null> {
+        if (!reachable()) throw new Error(`${name} can’t be reached.`);
+        let own = mine(m, slice);
+        // Left out, the slice is any: the whole company's where it has one, else the first it reads.
+        if (!slice && own.length) { const first = own.find((r) => r.team == null && !r.part) ?? own[0]!; own = own.filter((r) => sameSlice(r, { teamId: first.team, part: first.part })); }
+        const before = own.filter((r) => Date.parse(r.at) <= at.getTime()).sort((a, b) => Date.parse(a.at) - Date.parse(b.at));
+        const last = before.at(-1);
+        return last ? { value: last.value, at: new Date(Date.parse(last.at)).toISOString() } : null;
+      },
+    };
+  });
+}
+
+/** The browser's: the open workspace's rows from the server, once each time the sources are asked for. */
+export function httpNumberSources(base = '/api/workspaces'): (workspaceId: string) => Promise<NumberSource[]> {
+  return async (ws) => {
+    const r = await fetch(`${base}/${encodeURIComponent(ws)}/readings`, { credentials: 'same-origin' });
+    if (!r.ok) return [];
+    return sourcesFromRows((await r.json()) as ReadingRow[]);
+  };
+}
