@@ -0,0 +1,35 @@
+/* A feature module's part on the platform Faro runs on (drill item 11; the registry's `virtual:faro-modules/platform`,
+   each module's platform.ts): what the server checks of its rows on every save, what it reads from the platform's
+   files, and what it registers in the browser. The core never names a module; the platform's server and app ask each
+   module the build keeps, and only while it is on in the workspace. Types only. */
+import type { Commit } from '../data/store';
+import type { Goal, Person, Snapshot } from '../domain/types';
+
+/** A module's part of the server's save check (R1 rule 4): its own rows, and the changes to core rows its actions
+    make for someone else (a metric relabelling the goals it measures). Pure. */
+export interface ModuleGuard {
+  /** Why this save of the module's rows is refused, in the module's words; null when it may. */
+  refusal(stored: Snapshot, c: Commit, actor: Person): string | null;
+  /** Whether a change to a goal whose owner isn't `actor` is the module's to make in this save. */
+  allowsGoal?(stored: Snapshot, c: Commit, actor: Person, was: Goal, now: Goal): boolean;
+}
+
+/** What the platform's server lends a module: its files (the Files port, plus listing a folder). */
+export interface PlatformServer {
+  files: { bytes(path: string): Promise<Uint8Array | null>; put(path: string, data: Blob, contentType?: string): Promise<void>; url(path: string): Promise<string | null>; list(prefix: string): Promise<string[]> };
+}
+
+export interface ModulePlatform {
+  guard?: ModuleGuard;
+  /** Once in the browser, when the platform starts the app. */
+  browser?(): void;
+  /** Once in the server, at start. */
+  server?(p: PlatformServer): void;
+  /** GET /api/workspaces/:id/<name>, for members, while the module is on there. */
+  routes?: Record<string, (p: PlatformServer, workspaceId: string) => Promise<unknown>>;
+  /** Paths on the files API under which only a workspace's admins may add or remove files (`<prefix>/<workspace>/…`);
+      its members read them. */
+  adminFiles?: string[];
+  /** For a seeded workspace: what it keeps on the platform beside its rows. Says what it did, or null. */
+  seed?(p: PlatformServer, workspaceId: string, s: Snapshot, today: Date): Promise<string | null>;
+}
