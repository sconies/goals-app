+  const admin = await signedIn(ADMIN);
+  const r = await admin.evaluate(async () => (await fetch('/api/workspaces/ws_platform/commit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ modulesOff: ['metrics'], changes: [{ id: 'chg_ui_off', at: new Date().toISOString(), actorId: 'amara', goalId: null, entity: 'workspace', entityId: 'ws_platform', action: 'edited', summary: 'Off', diffs: [] }] }) })).status);
+  await page.goto(B + '/'); await page.waitForTimeout(1200);
