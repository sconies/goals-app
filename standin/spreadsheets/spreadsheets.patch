diff --git a/platform/importJobs.ts b/platform/importJobs.ts
new file mode 100644
index 0000000..a54926d
--- /dev/null
+++ b/platform/importJobs.ts
@@ -0,0 +1,263 @@
+/* A large import as a job on the stand-in platform's server (R11, R-L1 to R-L6; stage 9). Faro checks and saves an
+   import in the browser; here the file goes up once (the files API), the server reads it with Faro's own reader
+   (domain/sheets readTables) and checks it with Faro's change engine (planChangesInChunks, via "spreadsheet"), as the
+   person signed in, a chunk at a time so the server keeps answering, and keeps the preview with the job. Saving checks
+   the file again on the server (R-L3), refuses while a Must fix or a question is open, and writes everything in one
+   SQLite transaction (R-L2), through the same guard as every save (R1 rule 4). The file is removed when the job ends
+   (R-L6). Nothing here restates a rule: the groups, counts and sentences are the engine's. Server-only. */
+import type { DatabaseSync } from 'node:sqlite';
+import { planChangesInChunks, describe, sheetCounts, type Answer, type Answers, type ChangeSet, type PlanProgress } from '../src/domain/changeset';
+import { parseDelimited, readLine, readTables, sheetsIn, type NamedGrid, type ReadTables } from '../src/domain/sheets';
+import { tooLarge } from '../src/domain/importLimits';
+import { currentCycle, scopeToCycle } from '../src/domain/cycle';
+import { currentWeek } from '../src/domain/plan';
+import { withRecarry } from '../src/domain/recarry';
+import { goalSheetsOn, loadSheetPlanners, MODULE_RECORDS, recordsOn, sheetHeadsFor } from '../src/core/records';
+import { newId, withExpectations, type Commit } from '../src/data/store';
+import { importEntry, importUndone } from '../src/domain/removal';
+import type { Person, Snapshot } from '../src/domain/types';
+import type { SqliteStore } from '../src/adapters/standin/sqliteStore';
+import { refusal } from '../src/adapters/standin/guard';
+
+export type JobState = 'checking' | 'checked' | 'saving' | 'saved' | 'stopped' | 'failed' | 'expired';
+export interface JobFiles { put(p: string, b: Blob, type?: string): Promise<void>; bytes(p: string): Promise<Uint8Array | null>; remove(p: string): Promise<boolean> }
+export interface Job {
+  id: string; workspaceId: string; personId: string; fileName: string; bytes: number; state: JobState;
+  done: number; total: number; answers: Answers; reason: string | null; preview: Preview | null;
+  importId: string | null; error: string | null; createdAt: string; updatedAt: string; endedAt: string | null; endedBy: string | null;
+}
+/** What the job's preview says, in the order Faro's does (R-L1): sheets read, counts by sheet, Must fix, Check, changes. */
+export interface Preview {
+  read: string;
+  summary: string;
+  sheets: { sheet: string; added: number; changed: number; stopped: number; unchanged: number; must: number; check: number }[];
+  mustFix: { id: string; kind: string; sheet: string; where: string; rows: number; title: string; example: string }[];
+  check: { id: string; kind: string; sheet: string; where: string; rows: number; title: string; answers: { choice: string; label: string }[] }[];
+  changes: number;
+  unchanged: number;
+  examples: number;
+  needsReason: boolean;
+  ready: boolean;
+}
+
+/** When a job that was never saved ends by itself, and its file with it (R-L6): a day. */
+export const JOB_KEEP_MS = 24 * 3600 * 1000;
+/** How long an import can still be undone (R-L4's suggested 90 days). */
+export const UNDO_DAYS = 90;
+export const undoTooLate = (at: string, now: Date) => now.getTime() - new Date(at).getTime() > UNDO_DAYS * 86_400_000
+  ? `This import was saved more than ${UNDO_DAYS} days ago, so it can no longer be undone.` : null;
+
+const isText = (name: string) => /\.(csv|tsv|txt)$/i.test(name);
+/** Every sheet in an uploaded file, as named grids of text: the same three kinds the app reads (src/app/spreadsheet.ts). */
+export async function gridsOf(name: string, bytes: Uint8Array): Promise<NamedGrid[]> {
+  if (isText(name)) return [{ name, rows: parseDelimited(new TextDecoder().decode(bytes).replace(/^﻿/, ''), { keepBlank: true, ...(/\.tsv$/i.test(name) ? { sep: '\t' as const } : {}) }) }];
+  const dec = new TextDecoder();
+  if (/\.zip$/i.test(name)) {
+    const { unzipFiles } = await import('../src/app/zip');
+    return (await unzipFiles(bytes)).filter((f) => isText(f.name)).map((f) => ({ name: f.name.replace(/^.*\//, ''), rows: parseDelimited(dec.decode(f.data).replace(/^﻿/, ''), { keepBlank: true }) }));
+  }
+  if (!/\.xlsx$/i.test(name)) throw new Error(`${name} isn’t a file Faro reads: use a workbook (.xlsx), a zip of CSVs, or one CSV.`);
+  const { default: readXlsx } = await import('read-excel-file/node');
+  const { gridOf } = await import('../src/domain/sheets');
+  const sheets = (await (readXlsx as unknown as (b: Buffer) => Promise<{ sheet: string; data: unknown[][] }[]>)(Buffer.from(bytes)));
+  return sheets.map((s) => ({ name: s.sheet, rows: gridOf(s.data) }));
+}
+
+type Row = Record<string, string | number | null>;
+const json = <T>(s: unknown, d: T): T => { try { return s == null ? d : JSON.parse(String(s)) as T; } catch { return d; } };
+const toJob = (r: Row): Job => ({
+  id: String(r.id), workspaceId: String(r.workspace_id), personId: String(r.person_id), fileName: String(r.file_name), bytes: Number(r.bytes),
+  state: r.state as JobState, done: Number(r.done), total: Number(r.total), answers: json(r.answers, {}), reason: (r.reason as string) ?? null,
+  preview: json(r.preview, null), importId: (r.import_id as string) ?? null, error: (r.error as string) ?? null,
+  createdAt: String(r.created_at), updatedAt: String(r.updated_at), endedAt: (r.ended_at as string) ?? null, endedBy: (r.ended_by as string) ?? null,
+});
+
+export class JobRefused extends Error { constructor(readonly status: number, message: string) { super(message); } }
+
+export class ImportJobs {
+  /** Checks running now, by job: Stop ends one between two chunks. */
+  private running = new Map<string, { stop: boolean }>();
+  constructor(private db: DatabaseSync, private store: SqliteStore, private files: JobFiles, private now: () => Date = () => new Date(),
+    private modulesOff: (ws: string) => string[] = () => []) {}
+
+  get(id: string): Job | null { const r = this.db.prepare('select * from import_jobs where id = ?').get(id) as Row | undefined; return r ? toJob(r) : null; }
+  /** Someone's own jobs; an admin's list has everyone's. */
+  list(ws: string, me: Person): Job[] {
+    const rows = this.db.prepare('select * from import_jobs where workspace_id = ? order by created_at desc').all(ws) as Row[];
+    return rows.map(toJob).filter((j) => me.admin || j.personId === me.id);
+  }
+  /** A job this person may see and act on (its starter or an admin), or a refusal that says nothing of others' jobs. */
+  mine(ws: string, id: string, me: Person): Job {
+    const j = this.get(id);
+    if (!j || j.workspaceId !== ws || (j.personId !== me.id && !me.admin)) throw new JobRefused(404, 'There’s no such import.');
+    return j;
+  }
+  private set(id: string, patch: Record<string, string | number | null>) {
+    const keys = Object.keys(patch);
+    this.db.prepare(`update import_jobs set ${keys.map((k) => `${k} = ?`).join(', ')}, updated_at = ? where id = ?`).run(...keys.map((k) => patch[k]!), this.now().toISOString(), id);
+  }
+  private filePath = (j: { workspaceId: string; id: string }) => `imports/${j.workspaceId}/${j.id}`;
+
+  /** Uploads a file and starts checking it (R-L1): answers at once with the job; the check carries on on the server. */
+  async start(ws: string, me: Person, fileName: string, bytes: Uint8Array): Promise<Job> {
+    // R-L6: limited in size before anything is kept (the same limit and words as Import's, domain/importLimits).
+    const big = tooLarge(fileName, { bytes: bytes.length });
+    if (big) throw new JobRefused(413, big);
+    if (!fileName.trim() || /[/\\]/.test(fileName)) throw new JobRefused(400, 'Give the file’s name.');
+    const id = newId('job');
+    const at = this.now().toISOString();
+    const job = { id, workspaceId: ws };
+    await this.files.put(this.filePath(job), new Blob([bytes as BlobPart]), 'application/octet-stream');
+    this.db.prepare('insert into import_jobs (id, workspace_id, person_id, file_name, file_path, bytes, state, created_at, updated_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?)')
+      .run(id, ws, me.id, fileName, this.filePath(job), bytes.length, 'checking', at, at);
+    void this.check(id, me).catch((e) => this.set(id, { state: 'failed', error: e instanceof Error ? e.message : String(e) }));
+    return this.get(id)!;
+  }
+
+  /** The engine's input, as the person signed in, from the workspace as stored now (what MCP's bulk_change gives it). */
+  private async input(ws: string, actor: Person, read: ReadTables, j: Job) {
+    const all = await this.store.load(ws);
+    const now = this.now();
+    const cycle = currentCycle(all.cycles, now);
+    if (!cycle) throw new JobRefused(409, 'This workspace has no cycle yet.');
+    const w = { modulesOff: this.modulesOff(ws) };
+    if (read.tables.modules) await loadSheetPlanners();
+    return { all, cycle, x: {
+      tables: read.tables, snapshot: scopeToCycle(all, cycle, MODULE_RECORDS), full: all, cycle, week: currentWeek(cycle, now), actor, now: now.toISOString(), newId,
+      via: 'spreadsheet' as const, answers: j.answers, ...(j.reason ? { reason: j.reason } : {}), records: recordsOn(w), goalSheets: goalSheetsOn(w), file: { name: j.fileName, leftOut: 0 },
+    } };
+  }
+
+  /** Reads the job's file and runs the change engine over it a chunk at a time, keeping progress and then the preview. */
+  async check(id: string, actor: Person, opts: { forSave?: boolean } = {}): Promise<{ cs: ChangeSet; all: Snapshot } | null> {
+    const j = this.get(id)!;
+    const bytes = await this.files.bytes(this.filePath(j));
+    if (!bytes) throw new JobRefused(410, 'The file for this import is no longer kept. Upload it again.');
+    const read = readTables(await gridsOf(j.fileName, bytes), sheetHeadsFor({ modulesOff: this.modulesOff(j.workspaceId) }));
+    const rows = sheetsIn(read.tables).length ? (read.tables.goals?.length ?? 0) + (read.tables.plan?.length ?? 0) + (read.tables.checkIns?.length ?? 0) + (read.tables.people?.length ?? 0) + Object.values(read.tables.modules ?? {}).reduce((n, r) => n + r.length, 0) : 0;
+    const big = tooLarge(j.fileName, { rows });
+    if (big) { this.end(id, 'failed', null, big); return null; }
+    const { all, x } = await this.input(j.workspaceId, actor, read, j);
+    const flag = { stop: false };
+    this.running.set(id, flag);
+    if (!opts.forSave) this.set(id, { state: 'checking', done: 0, total: rows, error: null });
+    try {
+      const gen = planChangesInChunks(x);
+      let step = gen.next();
+      while (!step.done) {
+        const p: PlanProgress = step.value;
+        if (!opts.forSave) this.set(id, { done: p.done, total: p.total });
+        // Between two chunks, the server answers others (and this job's progress), and Stop is heard.
+        await new Promise((r) => setImmediate(r));
+        if (flag.stop) return null;
+        step = gen.next();
+      }
+      const cs = step.value;
+      if (!opts.forSave) this.set(id, { state: 'checked', done: rows, total: rows, preview: JSON.stringify(previewOf(cs, read)), goal_ids: JSON.stringify(goalsOf(cs.commit)) });
+      return { cs, all };
+    } finally { this.running.delete(id); }
+  }
+
+  /** Answers a question group (or a reason) and checks the file again. */
+  async answer(ws: string, id: string, me: Person, given: Record<string, string | Answer>, reason?: string): Promise<Job> {
+    // An answer by its choice ("use"), or in full ({ choice, value }), as MCP's bulk_change takes them.
+    const answers: Answers = Object.fromEntries(Object.entries(given ?? {}).map(([k, v]) => [k, typeof v === 'string' ? { choice: v } : v]));
+    const j = this.mine(ws, id, me);
+    if (j.state !== 'checked') throw new JobRefused(409, j.state === 'checking' ? 'This import is still being checked.' : 'This import has ended.');
+    if (j.personId !== me.id) throw new JobRefused(403, 'Only whoever started this import can answer its questions.');
+    this.set(id, { answers: JSON.stringify({ ...j.answers, ...answers }), ...(reason !== undefined ? { reason } : {}), state: 'checking' });
+    await this.check(id, me);
+    return this.get(id)!;
+  }
+
+  /** Stop: ends the job, keeps nothing, removes the file (“Stopped. Nothing was saved.”). */
+  async stop(ws: string, id: string, me: Person): Promise<Job> {
+    const j = this.mine(ws, id, me);
+    if (['saved', 'stopped', 'failed', 'expired'].includes(j.state)) throw new JobRefused(409, 'This import has ended.');
+    if (j.state === 'saving') throw new JobRefused(409, 'This import is being saved and can’t be stopped now.');
+    const r = this.running.get(id); if (r) r.stop = true;
+    await this.end(id, 'stopped', me.id);
+    return this.get(id)!;
+  }
+
+  /** Saves the job: checked again here (R-L3), one transaction (R-L2), one at a time per goal (R-L5), file removed (R-L6). */
+  async save(ws: string, id: string, me: Person): Promise<Job> {
+    const j = this.mine(ws, id, me);
+    if (j.personId !== me.id) throw new JobRefused(403, 'Only whoever started this import can save it.');
+    if (j.state !== 'checked') throw new JobRefused(409, j.state === 'checking' ? 'This import is still being checked.' : 'This import has ended.');
+    // R-L5: another save running in this workspace that writes one of these goals holds them; this one is refused, with who.
+    const goalIdsOf = (jid: string) => json<string[]>((this.db.prepare('select goal_ids from import_jobs where id = ?').get(jid) as Row | undefined)?.goal_ids, []);
+    const mineGoals = new Set(goalIdsOf(id));
+    const holding = (this.db.prepare("select * from import_jobs where workspace_id = ? and state = 'saving' and id <> ?").all(ws, id) as Row[]).map(toJob)
+      .find((o) => goalIdsOf(o.id).some((g) => mineGoals.has(g)));
+    if (holding) {
+      const all = await this.store.load(ws);
+      throw new JobRefused(409, `${all.people.find((p) => p.id === holding.personId)?.name ?? 'Someone'} is saving an import that changes the same goals. Try again once it is saved.`);
+    }
+    this.set(id, { state: 'saving' });
+    try {
+      const checked = await this.check(id, me, { forSave: true });
+      if (!checked) { this.set(id, { state: 'checked' }); throw new JobRefused(409, 'This import was stopped.'); }
+      const { cs, all } = checked;
+      this.set(id, { preview: JSON.stringify(previewOf(cs, null, this.get(id)!.preview?.read ?? '')) });
+      if (!cs.commit) {
+        this.set(id, { state: 'checked' });
+        throw new JobRefused(409, cs.issues.some((i) => i.level === 'must') ? 'Not saved: some rows must be fixed first.' : cs.needsReason ? 'Not saved: give a reason for the plan changes.' : 'Not saved: answer the questions first.');
+      }
+      const first = cs.commit.changes[0];
+      const c: Commit = withRecarry(all, cs.commit, { now: first?.at ?? this.now().toISOString(), actorId: me.id, newId, records: MODULE_RECORDS });
+      // The same guard as every save (R1 rule 4): the server's check, not the browser's.
+      const why = refusal(all, c, me);
+      if (why) { this.set(id, { state: 'checked' }); throw new JobRefused(403, why); }
+      await this.store.commit(ws, withExpectations(c, all));
+      const importId = c.changes.find((x) => x.action === 'imported')?.entityId ?? null;
+      await this.end(id, 'saved', me.id, null, importId);
+      return this.get(id)!;
+    } catch (e) {
+      if (this.get(id)!.state === 'saving') this.set(id, { state: 'checked' });
+      throw e;
+    }
+  }
+
+  private async end(id: string, state: JobState, by: string | null, error: string | null = null, importId: string | null = null) {
+    const j = this.get(id)!;
+    await this.files.remove(this.filePath(j)).catch(() => false);
+    this.set(id, { state, file_path: null, ended_at: this.now().toISOString(), ended_by: by, error, ...(importId ? { import_id: importId } : {}) });
+  }
+
+  /** The timer's job: a job nobody saved within a day ends, and its file goes (R-L6). */
+  async sweep(): Promise<number> {
+    const cutoff = new Date(this.now().getTime() - JOB_KEEP_MS).toISOString();
+    const old = (this.db.prepare("select * from import_jobs where state in ('checking', 'checked') and updated_at < ?").all(cutoff) as Row[]).map(toJob);
+    for (const j of old) await this.end(j.id, 'expired', null, 'Nobody saved it within a day, so its file was removed.');
+    return old.length;
+  }
+}
+
+/** The goals a commit writes, by id: what two saves mustn't both hold (R-L5). */
+const goalsOf = (c: Commit | null) => [...new Set([...(c?.goals ?? []).map((g) => g.id), ...(c?.checkIns ?? []).map((x) => x.goalId)])];
+
+/** The preview, from the engine's change set: nothing restated, only kept (R-L1). */
+export function previewOf(cs: ChangeSet, read: ReadTables | null, readWas = ''): Preview {
+  const sheets = [...new Set([...cs.items.map((i) => i.sheet), ...cs.issues.map((i) => i.sheet), ...Object.keys(cs.unchangedBy)])] as Parameters<typeof sheetCounts>[1][];
+  return {
+    read: read ? readLine(read, cs.examples) : readWas,
+    summary: describe(cs),
+    sheets: sheets.map((s) => ({ sheet: s, ...sheetCounts(cs, s) })),
+    mustFix: cs.groups.filter((g) => g.level === 'must').map((g) => ({ id: g.id, kind: g.kind, sheet: g.sheet, where: g.where, rows: g.count, title: g.title, example: g.example })),
+    check: cs.groups.filter((g) => g.level === 'check').map((g) => ({ id: g.id, kind: g.kind, sheet: g.sheet, where: g.where, rows: g.count, title: g.title, answers: g.answers.map((a) => ({ choice: a.choice, label: a.label })) })),
+    changes: cs.items.length, unchanged: cs.unchanged, examples: cs.examples, needsReason: cs.needsReason, ready: !!cs.commit,
+  };
+}
+
+/** Why the server refuses an import's undo (R-L4 and IMPORT-UNDO), in the app's words; null when it may. The undo itself
+    is Faro's (domain/removal undoImport); the server checks who and when, on the stored change log. */
+export function undoRefusal(stored: Snapshot, c: Commit, actor: Person, now: Date): string | null {
+  const undo = c.changes.find((x) => x.action === 'undone' && x.entity === 'workspace');
+  if (!undo) return null;
+  const entry = importEntry(stored, undo.entityId);
+  if (!entry) return null;
+  if (entry.actorId !== actor.id && !actor.admin) return 'Only whoever made the import, or an admin, can undo it.';
+  if (importUndone(stored, undo.entityId)) return 'That import has already been undone.';
+  return undoTooLate(entry.at, now);
+}
diff --git a/platform/migrations/0003_spreadsheets.sql b/platform/migrations/0003_spreadsheets.sql
new file mode 100644
index 0000000..d0c02b5
--- /dev/null
+++ b/platform/migrations/0003_spreadsheets.sql
@@ -0,0 +1,32 @@
+-- The spreadsheets module on the stand-in platform (stage 9). Faro's module keeps no tables of its own: an import is
+-- rows in Faro's own tables, its summary a change-log entry (okr_changes.import_id, with Undo's before-images). What
+-- this adds is the platform's: a large import as a job on the server (R11, R-L1 to R-L6), so it survives a closed tab,
+-- is checked by the server with the change engine, saved in one transaction, and its file is gone when the job ends.
+create table if not exists import_jobs (
+  id text primary key,
+  workspace_id text not null,
+  -- Who started it: only they (or an admin) see, answer, save or stop it.
+  person_id text not null,
+  file_name text not null,
+  -- Where the uploaded file is on the files API while the job runs; null once the job has ended (R-L6).
+  file_path text,
+  bytes integer not null,
+  -- checking, checked, saving, saved, stopped, failed, expired
+  state text not null,
+  -- How far the check has got: rows done of rows in the file.
+  done integer not null default 0,
+  total integer not null default 0,
+  answers text not null default '{}',
+  reason text,
+  -- The preview (sheets read, counts, Must fix, Check, changes) as JSON: the same groups and counts as Faro's (R-L1).
+  preview text,
+  -- The goals this job's save writes: two saves touching one goal don't interleave (R-L5).
+  goal_ids text not null default '[]',
+  import_id text,
+  error text,
+  created_at text not null,
+  updated_at text not null,
+  ended_at text,
+  ended_by text
+);
+create index if not exists import_jobs_ws on import_jobs (workspace_id, created_at);
diff --git a/platform/prove-spreadsheets.mjs b/platform/prove-spreadsheets.mjs
new file mode 100644
index 0000000..d1b15c2
--- /dev/null
+++ b/platform/prove-spreadsheets.mjs
@@ -0,0 +1,144 @@
+/* Stage 9 (Spreadsheets) on the stand-in platform, proved against the running server (drill item 11). Starts the built
+   server on a fresh data folder, seeds it, and checks through the API: an import as a job on the server (R11) by its
+   starter only, its file never served and gone once the job ends, a member's rows on someone else's goal refused, the
+   switch (an admin only; off: Import and its saves answer the module-off sentence, MCP's export refuses; back on works),
+   and an import's undo refused to a member who didn't make it. With `out` (a build with spreadsheets left out): the
+   import's addresses aren't there and a spreadsheet's rows are refused.
+   Usage: npm run build:standin && node platform/prove-spreadsheets.mjs [in|out] [port]. */
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const MODE = process.argv[2] || 'in';
+const PORT = Number(process.argv[3] || 47920);
+const B = `http://localhost:${PORT}`;
+const DATA = fs.mkdtempSync(path.join(os.tmpdir(), 'faro-sheets-'));
+const ENV = { ...process.env, STANDIN_PORT: String(PORT), STANDIN_DATA: DATA, NODE_NO_WARNINGS: '1' };
+const PASSWORD = 'faro-standin';
+const WS = 'ws_platform';
+const results = [];
+const check = (name, ok, detail = '') => { results.push({ name, ok: !!ok }); console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ' — ' + detail : ''}`); };
