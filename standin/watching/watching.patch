index 0000000..1a5eaed
--- /dev/null
+++ b/src/adapters/standin/watchGuard.test.ts
@@ -0,0 +1,55 @@
+// @vitest-environment node
+/* The stand-in server's check on watches (stage 11): anyone, for their own watches (R1, "Views and watching"); someone
+   else's only when restoring what you stopped (or as an admin) or carried along by a save about goals or a cycle; and
+   none of Watching's own saves while it is off. */
+import { describe, expect, it } from 'vitest';
+import { KEEPS_WHAT, SOMEONE_ELSES, watchRefusal } from './watchGuard';
+import type { Commit } from '../../data/store';
+import type { Goal, Person, Snapshot, Watch } from '../../domain/types';
+
+const person = (id: string, admin = false) => ({ id, name: id, admin }) as unknown as Person;
+const ADMIN = person('a', true), MAYA = person('m'), NIK = person('n');
+const goal = (id: string, ownerId: string, cycleId = 'c1', key = 'G-1') => ({ id, ownerId, cycleId, key, title: id }) as unknown as Goal;
+const nikWatch: Watch = { id: 'w1', personId: 'n', kind: 'goal', ref: 'g1' };
+const stored = { people: [ADMIN, MAYA, NIK], goals: [goal('g1', 'm')], cycles: [{ id: 'c1' }], watches: [nikWatch, { id: 'w2', personId: 'm', kind: 'level', ref: 'north-star', removedAt: '2026-11-01', removedBy: 'm' }] } as unknown as Snapshot;
+const ON = { name: 'Platform Engineering', on: true };
+const OFF = { name: 'Platform Engineering', on: false };
+const stop = (w: Watch, by: string): Commit => ({ watches: [{ ...w, removedAt: '2026-11-15', removedBy: by }], changes: [{ id: 'chg', at: '2026-11-15', actorId: by, goalId: null, entity: 'watch', entityId: w.id, action: 'removed', summary: 'Stopped watching g1', diffs: [] }] } as unknown as Commit);
+
+describe('the stand-in server on watches', () => {
+  it('lets anyone start and stop their own watch', () => {
+    expect(watchRefusal(stored, { watches: [{ id: 'w9', personId: 'm', kind: 'goal', ref: 'g1' }], changes: [] }, MAYA, ON)).toBeNull();
+    expect(watchRefusal(stored, stop(nikWatch, 'n'), NIK, ON)).toBeNull();
+  });
+  it('refuses a watch made, stopped or deleted for someone else, admins included', () => {
+    expect(watchRefusal(stored, { watches: [{ id: 'w9', personId: 'n', kind: 'goal', ref: 'g1' }], changes: [] }, MAYA, ON)).toBe(SOMEONE_ELSES);
+    expect(watchRefusal(stored, stop(nikWatch, 'm'), MAYA, ON)).toBe(SOMEONE_ELSES);
+    expect(watchRefusal(stored, stop(nikWatch, 'a'), ADMIN, ON)).toBe(SOMEONE_ELSES);
+    expect(watchRefusal(stored, { unwatch: ['w1'], changes: [] }, MAYA, ON)).toBe(SOMEONE_ELSES);
+  });
+  it('refuses moving a watch to another person or goal', () => {
+    expect(watchRefusal(stored, { watches: [{ ...nikWatch, personId: 'm' }], changes: [] }, MAYA, ON)).toBe(KEEPS_WHAT);
+    expect(watchRefusal(stored, { watches: [{ ...nikWatch, ref: 'g2' }], changes: [] }, NIK, ON)).toBe(KEEPS_WHAT);
+  });
+  it('lets whoever stopped a watch, or an admin, restore it', () => {
+    const back = { watches: [{ ...stored.watches[1]!, removedAt: null, removedBy: null }], changes: [] } as Commit;
+    expect(watchRefusal(stored, back, MAYA, ON)).toBeNull();
+    expect(watchRefusal(stored, back, ADMIN, ON)).toBeNull();
+    expect(watchRefusal(stored, back, NIK, ON)).toBe(SOMEONE_ELSES);
+  });
+  it('lets a save about goals carry their watchers’ watches along, and nothing more', () => {
+    const carry: Commit = { goals: [goal('g1b', 'm', 'c2')], watches: [{ id: 'w7', personId: 'n', kind: 'goal', ref: 'g1b' }], changes: [] };
+    expect(watchRefusal(stored, carry, ADMIN, ON)).toBeNull();
+    expect(watchRefusal(stored, { ...carry, watches: [{ id: 'w7', personId: 'n', kind: 'level', ref: 'north-star' }] }, ADMIN, ON)).toBe(SOMEONE_ELSES);
+    expect(watchRefusal(stored, { ...carry, watches: [{ id: 'w7', personId: 'a', kind: 'goal', ref: 'g1b' }] }, MAYA, ON)).toBe(SOMEONE_ELSES);
+    // A goal made new (not a copy: another key) can't bring someone else's watch with it.
+    expect(watchRefusal(stored, { ...carry, goals: [goal('g1b', 'm', 'c2', 'G-9')] }, MAYA, ON)).toBe(SOMEONE_ELSES);
+    // Undoing a cycle's start stops the watches on its goals.
+    expect(watchRefusal(stored, { cycles: [{ id: 'c1' } as never], watches: [{ ...nikWatch, removedAt: '2026-11-15', removedBy: 'a' }], changes: [] }, ADMIN, ON)).toBeNull();
+  });
+  it('refuses Watching’s own saves while it is off, but not what a goal carries', () => {
+    expect(watchRefusal(stored, { watches: [{ id: 'w9', personId: 'm', kind: 'goal', ref: 'g1' }], changes: [] }, MAYA, OFF)).toBe('Watching is off in Platform Engineering.');
+    expect(watchRefusal(stored, stop(nikWatch, 'n'), NIK, OFF)).toBe('Watching is off in Platform Engineering.');
+    expect(watchRefusal(stored, { goals: [goal('g1b', 'm', 'c2')], watches: [{ id: 'w7', personId: 'n', kind: 'goal', ref: 'g1b' }], changes: [] }, ADMIN, OFF)).toBeNull();
+  });
+});
diff --git a/src/adapters/standin/watchGuard.ts b/src/adapters/standin/watchGuard.ts
