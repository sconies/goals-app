+/* Watching through the app's screens on the stand-in server (stage 11, U164's steps on the live store). Signs in by
+   password and reads what each screen offers. Prints one JSON object of observations; the proof judges them.
+   Usage: node platform/ui-watching.mjs <base> <email> <password> <phase: on|switch-off|off|out> <goal id> [shots] */
+import { chromium } from 'playwright';
+const [B, EMAIL, PASSWORD, PHASE, GOAL, SHOTS] = process.argv.slice(2);
+const browser = await chromium.launch();
+const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });
+const errs = []; page.on('pageerror', (e) => errs.push(String(e)));
+const shot = (n) => SHOTS ? page.screenshot({ path: `${SHOTS}/${PHASE}-${n}.png` }) : null;
+const text = async () => (await page.locator('body').innerText()).replace(/\s+/g, ' ');
+const go = async (path, wait = 1500) => { await page.goto(B + path); await page.waitForTimeout(wait); };
+const out = { phase: PHASE };
+try {
+  await page.goto(B + '/');
+  await page.fill('input[name=email]', EMAIL);
+  await page.fill('input[name=password]', PASSWORD);
+  await page.click('button[type=submit]');
+  await page.waitForTimeout(2500);
+  if (PHASE === 'switch-off') {
+    await go('/workspace/features');
+    out.featuresSays = (await text()).match(/\d+ (people|person) watch(es)? goals here\./)?.[0] ?? null;
+    await page.getByRole('checkbox', { name: /Watching/ }).first().click();
+    const dialog = page.getByRole('dialog');
+    await dialog.waitFor({ timeout: 5000 });
+    out.readBack = (await dialog.innerText()).replace(/\s+/g, ' ');
+    await shot('read-back');
+    await dialog.getByRole('button', { name: /Switch off Watching/ }).click();
+    await page.waitForTimeout(1500);
+    out.after = (await text()).match(/Watching is off in [^.]+\./)?.[0] ?? null;
+  } else {
+    await go('/');
+    await page.getByText(/Goals you watch|goals? needs? attention/).first().waitFor({ timeout: 8000 }).catch(() => {});
+    await page.mouse.wheel(0, 3000); await page.waitForTimeout(500);
+    const home = await text();
+    out.homeWatch = /Goals you watch/.test(home);
+    out.homeLead = home.match(/\d+ goals? needs? attention (· )?See them/)?.[0] ?? null;
+    await shot('home');
+    await go('/goals');
+    out.goalTabs = await page.getByRole('tab').allInnerTexts().catch(() => []);
+    if (!out.goalTabs.length) out.goalTabs = await page.locator('.scope-tabs a, .tabs a, [role=tablist] *').allInnerTexts();
+    out.goalsWatchingTab = out.goalTabs.some((t) => /Watching/.test(t));
+    await go('/goals/' + GOAL);
+    const g = await text();
+    out.goalWatchButton = await page.getByRole('button', { name: /^(Watch|Watching)\b/ }).count();
+    out.goalWatchedBy = /Watched by/.test(g);
+    await shot('goal');
+    if (PHASE === 'on' && out.goalWatchButton) {
+      await page.getByRole('button', { name: /^Watch\b/ }).first().click();
+      await page.waitForTimeout(800);
+      const sheet = page.getByRole('dialog');
+      if (await sheet.count()) { out.watchSheet = (await sheet.innerText()).replace(/\s+/g, ' ').slice(0, 200); await sheet.getByRole('button', { name: /^Watch/ }).first().click(); }
+      await page.waitForTimeout(1500);
+      out.afterWatch = await page.getByRole('button', { name: /^Watching\b/ }).count();
+    }
+    await go('/watching');
+    const w = await text();
+    out.watchingPage = w.slice(0, 300);
+    out.notFound = /Page not found/.test(w);
+    out.offWords = w.match(/Watching is switched off in [^.]+\. An admin can switch it on in Workspace, Features\./)?.[0] ?? null;
+    await shot('watching');
+  }
+} catch (e) { out.error = String(e).slice(0, 300); await shot('error'); }
+out.pageErrors = errs;
+console.log(JSON.stringify(out));
+await browser.close();
diff --git a/src/adapters/standin/watchGuard.test.ts b/src/adapters/standin/watchGuard.test.ts
