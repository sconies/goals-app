+      const w = (await store.workspaces()).find((x) => x.id === ws);
+      // Watching's records (stage 11): only one's own watches, and none while Watching is off or left out of the build.
+      const why = refusal(stored, c, me) ?? watchRefusal(stored, c, me, { name: w?.name ?? 'Workspace', on: isModuleOn(w, 'watching') });
       if (why) throw new HttpError(403, why);
       // Revoking a token: the store checks that it's the token's person or an admin, as the actor the change names.
       try { await store.commit(ws, c); } catch (e) { refuse(e); }
