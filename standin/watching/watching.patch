index 0000000..60f5917
--- /dev/null
+++ b/src/adapters/standin/watchGuard.ts
@@ -0,0 +1,54 @@
+/* Who may write a watch, enforced by the stand-in platform's server on every save (stage 11, Watching; R1's "Views and
+   watching": anyone, for their own watches). The browser runs Faro's watch and unwatch and sends the Commit; the server
+   compares it with what it holds. What counts as Watching's own save is the domain's rule (writesWatches), so a save of
+   Watching's records while it is off or left out is refused here too, in the app's words, not only in the dispatcher.
+
+   Someone else's watch may be written only where Faro's own actions write one:
+   - restoring a stopped watch from Recently removed, by an admin or whoever stopped it (canRestore);
+   - a save that is about goals or a cycle and carries watches along (next year's copies, a goal leaving a later year,
+     undoing a cycle's start): the watch's goal is one the same save writes, or is in a cycle it writes, and a new copy
+     follows a live watch the same person already has. The goal or cycle itself is checked by the core guard. Pure. */
+import { writesWatches } from '../../domain/watchWrites';
+import { watchingOffWords } from '../../app/reads';
+import type { Commit } from '../../data/store';
+import type { Person, Snapshot, Watch } from '../../domain/types';
+
+export const SOMEONE_ELSES = 'That’s someone else’s watch.';
+export const KEEPS_WHAT = 'A watch keeps its person and what it watches.';
+
+const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
+
+/** Why the server refuses this save's watches, in the app's words; null when it may. `on`: Watching is in this build
+    and not switched off in the workspace. */
+export function watchRefusal(stored: Snapshot, c: Commit, actor: Person, ws: { name: string; on: boolean }): string | null {
+  const own = writesWatches(c);
+  if (own && !ws.on) return watchingOffWords(ws.name);
+  const watches = new Map((stored.watches ?? []).map((w) => [w.id, w]));
+  for (const id of c.unwatch ?? []) {
+    const w = watches.get(id);
+    if (w && w.personId !== actor.id) return SOMEONE_ELSES;
+  }
+  const goalsWritten = new Set((c.goals ?? []).map((g) => g.id));
+  const cyclesWritten = new Set((c.cycles ?? []).map((x) => x.id));
+  const goalCycle = new Map(stored.goals.map((g) => [g.id, g.cycleId]));
+  const storedKey = new Map(stored.goals.map((g) => [g.id, g.key]));
+  const writtenKey = new Map((c.goals ?? []).map((g) => [g.id, g.key]));
+  const carried = (w: Watch, was: Watch | undefined) => {
+    if (own || w.kind === 'level') return false;
+    if (!goalsWritten.has(w.ref) && !cyclesWritten.has(goalCycle.get(w.ref) ?? '')) return false;
+    if (was) return true;
+    // A new copy follows a live watch its person already has on the goal it was copied from: a carried goal keeps its key.
+    const key = writtenKey.get(w.ref);
+    return !!key && (stored.watches ?? []).some((x) => !x.removedAt && x.personId === w.personId && x.kind === w.kind && x.ref !== w.ref && storedKey.get(x.ref) === key);
+  };
+  for (const w of c.watches ?? []) {
+    const was = watches.get(w.id);
+    if (same(was, w)) continue;
+    if (was && (was.personId !== w.personId || was.kind !== w.kind || was.ref !== w.ref)) return KEEPS_WHAT;
+    if (w.personId === actor.id) continue;
+    const restoring = !!was?.removedAt && !w.removedAt && (!!actor.admin || was.removedBy === actor.id);
+    if (restoring || carried(w, was)) continue;
+    return SOMEONE_ELSES;
+  }
+  return null;
+}
