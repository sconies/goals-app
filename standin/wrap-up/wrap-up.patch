+// @vitest-environment node
+/* Stage 12 on the stand-in: who may write a wrap-up, as the server checks each save (guardWrapUp.ts), on its own clock. */
+import { describe, expect, it } from 'vitest';
+import { refusal } from './guard';
+import { cycleDates } from '../../domain/cycle';
+import type { Commit } from '../../data/store';
+import type { Cycle, Person, Retro, Snapshot } from '../../domain/types';
+
+const person = (id: string, admin = false) => ({ id, name: id[0]!.toUpperCase() + id.slice(1), role: '', initials: id[0]!.toUpperCase(), teamId: null, admin }) as Person;
+const cycle = { id: 'c1', name: '2026', startDate: '2025-12-29', weeks: 52 } as Cycle;
+const d = cycleDates(cycle);
+const open = new Date(d.wrapUpOpens + 'T12:00:00Z');
+const before = new Date(d.firstDay + 'T12:00:00Z');
+const after = new Date('2027-06-01T12:00:00Z');
+const goal = { id: 'g1', title: 'Ship it', ownerId: 'bob', level: 'team', parentId: null, cycleId: 'c1', key: 'G-1' };
+const kept: Retro = { id: 'r0', goalId: 'g9', cycleId: 'c1', result: 'hit', learned: 'Kept this one.', next: 'carry', byId: 'bob', at: '2026-12-22T00:00:00Z' };
+const stored = { people: [person('ann'), person('bob'), person('ada', true)], teams: [], cycles: [cycle], goals: [goal, { ...goal, id: 'g9', key: 'G-9' }], checkIns: [], decisions: [], changes: [], watches: [], reviews: [], retros: [kept], requests: [] } as unknown as Snapshot;
+const as = (id: string) => stored.people.find((p) => p.id === id)!;
+const save = (byId: string, extra: Partial<Retro> = {}): Commit => ({
+  retros: [{ id: 'r1', goalId: 'g1', cycleId: 'c1', result: 'hit', learned: 'Small steps worked well.', next: 'carry', byId, at: '2026-12-22T00:00:00Z', ...extra }],
+  changes: [{ id: 'chg', at: '2026-12-22T00:00:00Z', actorId: byId, goalId: 'g1', entity: 'retro', entityId: 'r1', action: 'posted', summary: 'Wrapped up Ship it: hit it', diffs: [] }],
+});
+const ws = { name: 'Acme' };
+
+describe('who may write a wrap-up on the stand-in server', () => {
+  it('the goal’s owner or an admin wraps it up; anyone else is refused in saveRetro’s words', () => {
+    expect(refusal(stored, save('bob'), as('bob'), ws, open)).toBeNull();
+    expect(refusal(stored, save('ada'), as('ada'), ws, open)).toBeNull();
+    expect(refusal(stored, save('ann'), as('ann'), ws, open)).toBe('Only the goal’s owner or an admin can wrap it up.');
+  });
+  it('only in the wrap-up’s weeks, on the server’s clock', () => {
+    expect(refusal(stored, save('bob'), as('bob'), ws, before)).toBe(`2026’s wrap-up opens on Mon 21 Dec 2026.`);
+    expect(refusal(stored, save('bob'), as('bob'), ws, after)).toBe(`2026’s wrap-up closed on Sun 31 Jan 2027.`);
+  });
+  it('says what was learned; as the person signed in; one per goal per year', () => {
+    expect(refusal(stored, save('bob', { learned: 'short' }), as('bob'), ws, open)).toBe('Say what was learned, in a sentence (10 characters or more).');
+    const forged = save('bob'); forged.retros![0]!.byId = 'ann';
+    expect(refusal(stored, forged, as('bob'), ws, open)).toBe('A save can only be made as the person signed in.');
+    expect(refusal(stored, save('bob', { id: 'r2', goalId: 'g9' }), as('bob'), ws, open)).toMatch(/once per goal/);
+    expect(refusal(stored, save('bob', { id: 'r0', goalId: 'g9', learned: 'Changed my mind on it.' }), as('bob'), ws, open)).toBeNull();
+  });
+  it('while the Wrap-up is off, a save that writes one is refused, admins included; other saves go through', () => {
+    const off = { name: 'Acme', modulesOff: ['wrap-up'] };
+    expect(refusal(stored, save('ada'), as('ada'), off, open)).toBe('Wrap-up is off in Acme.');
+    expect(refusal(stored, { retros: [kept], changes: [] }, as('bob'), off, open)).toBeNull();
+  });
+});
