@@ -0,0 +1,43 @@
+/* Who may write the Wrap-up's records, enforced by the stand-in platform's server on every save (stage 12, R1 rule 4).
+   The record: a wrap-up (okr_retros), one per goal per year, written only by saveRetro. The server doesn't restate its
+   rules: for each wrap-up a save writes, it runs saveRetro itself, as the person signed in, on what it holds and on the
+   platform's clock (not the browser's), and refuses with saveRetro's own words (owner or admin, the wrap-up's weeks,
+   what was learned, a stop on a copy already used). The row sent must then be the one saveRetro makes. While the
+   Wrap-up is off, a save that writes one refuses with the switched module's short sentence (SWITCHED_ACTIONS). Pure. */
+import { NotAllowed, saveRetro, type ActionContext } from '../../domain/actions';
+import { moduleOffWords } from '../../app/reads';
+import type { Commit } from '../../data/store';
+import type { Person, Retro, Snapshot } from '../../domain/types';
+
+const AS_SIGNED_IN = 'A save can only be made as the person signed in.';
+const RESULTS: readonly Retro['result'][] = ['hit', 'partly', 'missed'];
+const NEXTS: readonly Retro['next'][] = ['carry', 'stop'];
+
+/** Why the server refuses this save's wrap-ups by `actor`, in the app's words; null when it may. */
+export function wrapUpRefusal(stored: Snapshot, c: Commit, actor: Person, ws: { name: string; modulesOff?: readonly string[] }, now: Date): string | null {
+  const stored_ = new Map((stored.retros ?? []).map((r) => [r.id, r]));
+  const written = (c.retros ?? []).filter((r) => JSON.stringify(stored_.get(r.id)) !== JSON.stringify(r));
+  if (!written.length) return null;
+  if ((ws.modulesOff ?? []).includes('wrap-up')) return moduleOffWords('Wrap-up', ws.name);
+  for (const r of written) {
+    if (r.byId !== actor.id) return AS_SIGNED_IN;
+    const goal = stored.goals.find((g) => g.id === r.goalId && !g.removedAt);
+    if (!goal) return 'That wrap-up’s goal isn’t in this workspace.';
+    if (!RESULTS.includes(r.result) || !NEXTS.includes(r.next)) return 'A wrap-up says Hit it, Partly or Missed, and Carry on or Stop.';
+    const cycle = stored.cycles.find((x) => x.id === goal.cycleId);
+    if (!cycle) return 'That wrap-up’s goal isn’t in this workspace.';
+    const x: ActionContext = { snapshot: stored, cycle, week: 0, actor, now: now.toISOString(), newId: () => r.id, full: stored };
+    let made: Retro;
+    try {
+      made = saveRetro(x, goal, { result: r.result, learned: r.learned, next: r.next }).retros![0]!;
+    } catch (e) {
+      if (e instanceof NotAllowed) return e.message;
+      throw e;
+    }
+    // The row must be the one saveRetro makes: its goal's year, one per goal per year (the stored one's id), said as sent.
+    if (made.id !== r.id || made.cycleId !== r.cycleId || made.learned !== r.learned) return 'A wrap-up is saved for its goal’s year, once per goal: open it again to change it.';
+    const was = stored_.get(r.id);
+    if (was && (was.goalId !== r.goalId || was.cycleId !== r.cycleId)) return 'A wrap-up stays with its goal and year.';
+  }
+  return null;
+}
